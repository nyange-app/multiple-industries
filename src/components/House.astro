---
/**
 * The cut-away house: one illustration, drawn in an 800x960 coordinate space.
 * - interactive: zones are links with numbered hotspots (home / products index).
 * - view: a viewBox crop, used for the zoomed vignette on a category page.
 * - focus: a category slug to keep highlighted (vignette).
 */
import { categories } from '../data/categories';

interface Props {
  interactive?: boolean;
  view?: string;
  focus?: string;
  id?: string;
  class?: string;
  label?: string;
}

const {
  interactive = false,
  view = '0 0 800 960',
  focus,
  id = 'h',
  class: cls = '',
  label = 'Illustration of a house cut open to show where each Multiple Industries product range is used',
} = Astro.props;

const p = (s: string) => `${id}-${s}`;
const ink = '#14213D';
---

<svg
  class:list={['house', cls, { 'is-interactive': interactive }]}
  viewBox={view}
  xmlns="http://www.w3.org/2000/svg"
  role={label === '' ? undefined : interactive ? 'group' : 'img'}
  aria-label={label === '' ? undefined : label}
  aria-hidden={label === '' ? 'true' : undefined}
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <pattern id={p('blocks')} width="28" height="16" patternUnits="userSpaceOnUse">
      <rect width="28" height="16" fill="#D9D4CA"></rect>
      <path d="M0 .75h28M0 8.75h28M14 0v8M0 8v8M28 8v8" stroke="#B7B0A3" stroke-width="1.5"></path>
    </pattern>
    <pattern id={p('tiles')} width="20" height="20" patternUnits="userSpaceOnUse">
      <rect width="20" height="20" fill="#E3F1F7"></rect>
      <path d="M0 .5h20M.5 0v20" stroke="#C3DFEA" stroke-width="1"></path>
    </pattern>
    <pattern id={p('soil')} width="36" height="26" patternUnits="userSpaceOnUse">
      <rect width="36" height="26" fill="#ECE3CF"></rect>
      <circle cx="7" cy="7" r="2" fill="#D8CBAE"></circle>
      <circle cx="25" cy="17" r="2.6" fill="#D8CBAE"></circle>
      <circle cx="31" cy="5" r="1.4" fill="#D8CBAE"></circle>
    </pattern>
    <pattern id={p('roof')} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(0)">
      <rect width="14" height="14" fill="#3E5C76"></rect>
      <path d="M7 0v14" stroke="#4E6F8C" stroke-width="3"></path>
    </pattern>
  </defs>

  <!-- ===== Art layer ===== -->
  <g class="art" aria-hidden="true">
    <!-- sky, sun, clouds, hills -->
    <rect width="800" height="960" fill="#D7ECF4"></rect>
    <circle class="sun-glow" cx="690" cy="112" r="78" fill="#F2B705" opacity=".22"></circle>
    <circle cx="690" cy="112" r="52" fill="#F2B705"></circle>
    <g fill="#fff">
      <path d="M86 118a26 26 0 0 1 50-10 20 20 0 0 1 36 12 16 16 0 0 1-2 32H96a22 22 0 0 1-10-34z"></path>
      <path d="M430 70a20 20 0 0 1 38-8 16 16 0 0 1 28 10 13 13 0 0 1-2 26h-56a17 17 0 0 1-8-28z" opacity=".9"></path>
    </g>
    <path d="M0 640 C120 590 230 610 330 630 S560 580 800 620 V700 H0Z" fill="#C3E2D2"></path>
    <path d="M0 668 C150 640 260 660 400 662 S640 640 800 656 V700 H0Z" fill="#AFD7BE"></path>

    <!-- ground: grass line, soil cut-away, yard -->
    <rect y="700" width="800" height="16" fill="#86BF6B"></rect>
    <rect y="716" width="800" height="76" fill={`url(#${p('soil')})`}></rect>
    <path d="M0 716h800" stroke="#6E9F57" stroke-width="2"></path>
    <rect y="792" width="800" height="168" fill="#A7D38A"></rect>
    <path d="M0 792h800" stroke={ink} stroke-width="2" stroke-dasharray="2 8" opacity=".35"></path>

    <!-- underground pipes (plumbing) -->
    <g fill="none" stroke-linecap="round">
      <path d="M684 700V746H150V650" stroke="#2B7FB8" stroke-width="10"></path>
      <path d="M300 746V640" stroke="#2B7FB8" stroke-width="7"></path>
      <path d="M470 700V770H40" stroke="#8C96A3" stroke-width="12"></path>
      <path d="M350 700V770" stroke="#8C96A3" stroke-width="9"></path>
    </g>
    <g fill={ink}>
      <rect x="292" y="740" width="16" height="12" rx="2"></rect>
      <rect x="144" y="740" width="12" height="12" rx="2"></rect>
      <rect x="344" y="764" width="12" height="12" rx="2"></rect>
    </g>

    <!-- house slab + walls -->
    <rect x="64" y="700" width="482" height="16" fill="#BDB7AC"></rect>
    <rect x="70" y="380" width="470" height="320" fill={`url(#${p('blocks')})`}></rect>
    <!-- kitchen -->
    <rect x="84" y="396" width="141" height="304" fill="#FFF4D2"></rect>
    <!-- bathroom -->
    <rect x="235" y="396" width="150" height="304" fill={`url(#${p('tiles')})`}></rect>
    <!-- store room -->
    <rect x="395" y="396" width="131" height="304" fill="#F4EFE6"></rect>

    <!-- kitchen detail -->
    <rect x="104" y="424" width="96" height="62" rx="4" fill="#D7ECF4" stroke={ink} stroke-width="4"></rect>
    <path d="M152 424v62M104 455h96" stroke={ink} stroke-width="3"></path>
    <path d="M154 500v26" stroke={ink} stroke-width="2"></path>
    <path d="M140 540h28l-5-14h-18z" fill="#F2B705" stroke={ink} stroke-width="2.5"></path>
    <rect x="92" y="626" width="126" height="74" fill="#0F4C3A"></rect>
    <rect x="88" y="616" width="134" height="12" rx="2" fill="#E6E2D8" stroke={ink} stroke-width="2.5"></rect>
    <path d="M155 640v52" stroke="#2A6B57" stroke-width="3"></path>
    <circle cx="146" cy="664" r="3" fill="#F2B705"></circle><circle cx="164" cy="664" r="3" fill="#F2B705"></circle>
    <rect x="112" y="612" width="52" height="8" rx="2" fill="#9AA6B2"></rect>
    <path d="M140 612v-18h14v6" fill="none" stroke={ink} stroke-width="4" stroke-linecap="round"></path>
    <rect x="182" y="598" width="22" height="18" rx="3" fill="#2B7FB8"></rect>

    <!-- bathroom detail -->
    <path d="M262 696V440h22" fill="none" stroke="#2B7FB8" stroke-width="5"></path>
    <path d="M276 432h22l-4 12h-14z" fill="#9AA6B2" stroke={ink} stroke-width="2.5"></path>
    <g stroke="#2B7FB8" stroke-width="2.5" stroke-linecap="round" opacity=".75">
      <path d="M280 456l-4 26M288 456v30M296 456l4 26"></path>
    </g>
    <rect x="248" y="686" width="72" height="10" rx="2" fill="#fff" stroke={ink} stroke-width="2.5"></rect>
    <rect x="326" y="470" width="40" height="52" rx="18" fill="#fff" stroke={ink} stroke-width="3"></rect>
    <path d="M318 572h56l-6 22h-44z" fill="#fff" stroke={ink} stroke-width="3"></path>
    <path d="M346 594v22" stroke={ink} stroke-width="5"></path>
    <path d="M346 572v-10h8" fill="none" stroke={ink} stroke-width="3"></path>
    <rect x="334" y="630" width="20" height="30" rx="3" fill="#fff" stroke={ink} stroke-width="3"></rect>
    <path d="M326 660h40l-6 22c-2 8-26 8-28 0z" fill="#fff" stroke={ink} stroke-width="3"></path>
    <rect x="336" y="682" width="20" height="16" fill="#fff" stroke={ink} stroke-width="3"></rect>

    <!-- store room: shelves of plasticware -->
    <g stroke={ink} stroke-width="3">
      <path d="M404 520h114M404 606h114M404 692h114"></path>
    </g>
    <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
      <!-- buckets -->
      <path d="M412 474h30l-4 44h-22z" fill="#2B7FB8"></path>
      <path d="M414 476c4-14 22-14 26 0" fill="none"></path>
      <path d="M448 478h28l-4 40h-20z" fill="#E4573D"></path>
      <!-- jerry can -->
      <path d="M484 470h28v48h-28z" fill="#F2B705"></path>
      <path d="M490 470v-8h10v8M504 462h6v8" fill="none"></path>
      <!-- stacked basins -->
      <path d="M408 586h60l-8 18h-44z" fill="#0F4C3A"></path>
      <path d="M410 572h56l-8 14h-40z" fill="#2B7FB8"></path>
      <path d="M412 560h52l-8 12h-36z" fill="#F2B705"></path>
      <!-- cups -->
      <path d="M478 584h14l-2 20h-10z" fill="#E4573D"></path>
      <path d="M496 584h14l-2 20h-10z" fill="#fff"></path>
      <!-- plates -->
      <ellipse cx="438" cy="686" rx="26" ry="5" fill="#fff"></ellipse>
      <ellipse cx="438" cy="680" rx="26" ry="5" fill="#2B7FB8"></ellipse>
      <ellipse cx="438" cy="674" rx="26" ry="5" fill="#fff"></ellipse>
      <!-- tiffin box -->
      <rect x="476" y="652" width="34" height="38" rx="5" fill="#0F4C3A"></rect>
      <path d="M476 664h34M476 678h34" fill="none" stroke="#F2B705"></path>
      <!-- straws -->
      <rect x="476" y="634" width="12" height="18" fill="#fff"></rect>
      <path d="M480 634v-12M485 634v-16" stroke="#E4573D"></path>
    </g>

    <!-- walls between rooms -->
    <rect x="225" y="396" width="10" height="304" fill="#BDB7AC"></rect>
    <rect x="385" y="396" width="10" height="304" fill="#BDB7AC"></rect>
    <rect x="70" y="380" width="470" height="16" fill="#BDB7AC"></rect>
    <rect x="70" y="380" width="470" height="320" fill="none" stroke={ink} stroke-width="4"></rect>

    <!-- roof: cut open to show light gauge steel trusses -->
    <path d="M28 398L305 184L582 398Z" fill={`url(#${p('roof')})`} stroke={ink} stroke-width="4" stroke-linejoin="round"></path>
    <path d="M92 382L305 220L518 382Z" fill="#F3F8FA"></path>
    <g stroke="#7E8F9D" stroke-width="7" stroke-linecap="round" fill="none">
      <path d="M92 382L305 220L518 382H92"></path>
      <path d="M198 301L240 382L305 220L370 382L412 301M305 220V382"></path>
    </g>
    <g fill={ink}>
      <circle cx="305" cy="220" r="5"></circle><circle cx="240" cy="382" r="4"></circle>
      <circle cx="370" cy="382" r="4"></circle><circle cx="198" cy="301" r="4"></circle><circle cx="412" cy="301" r="4"></circle>
    </g>
    <!-- gutters & downpipe -->
    <rect x="12" y="398" width="48" height="12" rx="3" fill="#E8EEF2" stroke={ink} stroke-width="3"></rect>
    <rect x="550" y="398" width="56" height="12" rx="3" fill="#E8EEF2" stroke={ink} stroke-width="3"></rect>
    <path d="M596 410v14h46v12" fill="none" stroke="#14213D" stroke-width="11" stroke-linejoin="round"></path>
    <path d="M596 410v14h46v12" fill="none" stroke="#E8EEF2" stroke-width="6" stroke-linejoin="round"></path>

    <!-- water tank on stand -->
    <g stroke={ink} stroke-width="4" stroke-linejoin="round">
      <path d="M622 560l-10 140M746 560l10 140M622 560h124M616 630h136" fill="none"></path>
      <path d="M612 450c0-14 144-14 144 0v104c0 12-144 12-144 0z" fill="#0F4C3A"></path>
      <ellipse cx="684" cy="450" rx="72" ry="12" fill="#2A6B57"></ellipse>
      <rect x="668" y="432" width="32" height="10" rx="2" fill="#2A6B57"></rect>
    </g>
    <path d="M620 478h128M620 506h128M620 534h128" stroke="#2A6B57" stroke-width="3"></path>
    <path d="M684 562v138" stroke="#2B7FB8" stroke-width="10"></path>
    <path d="M748 540c34 0 34 20 34 40v270" fill="none" stroke="#2B7FB8" stroke-width="6"></path>
    <rect x="676" y="604" width="16" height="14" rx="2" fill="#E4573D" stroke={ink} stroke-width="2"></rect>

    <!-- garden beds with drip irrigation -->
    <g>
      <path d="M782 850H440M782 884H440M782 918H440" stroke="#2B7FB8" stroke-width="4"></path>
      <path d="M440 850v68" stroke="#2B7FB8" stroke-width="4"></path>
      <g fill="#2E6B3C">
        <circle cx="468" cy="840" r="11"></circle><circle cx="516" cy="838" r="13"></circle><circle cx="566" cy="840" r="11"></circle>
        <circle cx="616" cy="838" r="13"></circle><circle cx="666" cy="840" r="11"></circle><circle cx="716" cy="838" r="13"></circle>
        <circle cx="490" cy="874" r="12"></circle><circle cx="540" cy="872" r="10"></circle><circle cx="590" cy="874" r="12"></circle>
        <circle cx="640" cy="872" r="10"></circle><circle cx="690" cy="874" r="12"></circle><circle cx="740" cy="872" r="10"></circle>
        <circle cx="468" cy="908" r="10"></circle><circle cx="516" cy="906" r="12"></circle><circle cx="566" cy="908" r="10"></circle>
        <circle cx="616" cy="906" r="12"></circle><circle cx="666" cy="908" r="10"></circle><circle cx="716" cy="906" r="12"></circle>
      </g>
      <g fill="#2B7FB8" class="drips">
        <circle cx="492" cy="858" r="3"></circle><circle cx="592" cy="858" r="3"></circle><circle cx="692" cy="858" r="3"></circle>
        <circle cx="516" cy="892" r="3"></circle><circle cx="616" cy="892" r="3"></circle><circle cx="716" cy="892" r="3"></circle>
        <circle cx="542" cy="926" r="3"></circle><circle cx="642" cy="926" r="3"></circle><circle cx="742" cy="926" r="3"></circle>
      </g>
    </g>

    <!-- driveway + truck -->
    <path d="M24 944L56 816H372L404 944Z" fill="#DCD7CC"></path>
    <ellipse cx="200" cy="934" rx="160" ry="8" fill={ink} opacity=".15"></ellipse>
    <g stroke={ink} stroke-width="4" stroke-linejoin="round">
      <rect x="54" y="842" width="196" height="72" rx="4" fill="#fff"></rect>
      <path d="M54 890h196" stroke="#0F4C3A" stroke-width="10"></path>
      <path d="M250 914V860h52l30 28v26z" fill="#F2B705"></path>
      <path d="M262 870h34l18 18h-52z" fill="#D7ECF4" stroke-width="3"></path>
      <circle cx="102" cy="920" r="18" fill={ink}></circle>
      <circle cx="206" cy="920" r="18" fill={ink}></circle>
      <circle cx="298" cy="920" r="18" fill={ink}></circle>
    </g>
    <g fill="#D7DCE2">
      <circle cx="102" cy="920" r="7"></circle><circle cx="206" cy="920" r="7"></circle><circle cx="298" cy="920" r="7"></circle>
    </g>
    <rect x="326" y="896" width="10" height="8" fill="#fff" stroke={ink} stroke-width="2"></rect>
  </g>

  <!-- ===== Zone layer ===== -->
  {
    interactive ? (
      <g class="zones">
        {categories.map((c) => (
          <a
            href={`/products/${c.slug}/`}
            class={`zone zone-${c.n}`}
            aria-label={`${c.n}. ${c.name}: ${c.zone}`}
          >
            <path class="zone-hit" d={c.hit} />
            <g class="spot" transform={`translate(${c.spot[0]} ${c.spot[1]})`}>
              <circle class="spot-pulse" r="26" />
              <circle class="spot-dot" r="25" />
              <text class="spot-n" y="9" text-anchor="middle">
                {c.n}
              </text>
            </g>
          </a>
        ))}
      </g>
    ) : (
      focus &&
      categories
        .filter((c) => c.slug === focus)
        .map((c) => (
          <g class="zone is-focus" aria-hidden="true">
            <path class="zone-hit" d={c.hit} />
          </g>
        ))
    )
  }
</svg>
