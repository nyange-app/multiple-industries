---
/**
 * "Core sample": the company's history drawn as layers of earth.
 * Horizontal strip on phones, a vertical drilled core on desktop.
 */
const layers = [
  { year: '1991', text: 'Pipes, plastics & building materials', cls: 'l1' },
  { year: '2013', text: 'Automotive division', cls: 'l2' },
  { year: '2019', text: 'Inland Freight Services', cls: 'l3' },
  { year: 'Today', text: 'ISO 9001:2015 · UNBS', cls: 'l4' },
];
---

<figure class="core">
  <ol class="layers">
    {
      layers.map((l) => (
        <li class={l.cls}>
          <span class="yr">{l.year}</span>
          <span class="tx">{l.text}</span>
        </li>
      ))
    }
  </ol>
  <figcaption>Core sample: thirty-plus years, layer by layer.</figcaption>
</figure>

<style>
  .core {
    margin: 0;
  }
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 2px solid var(--color-ink);
  }
  .layers li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 7.5rem;
    padding: 0.65rem 0.55rem;
  }
  .yr {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-style: italic;
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1;
  }
  .tx {
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .l1 {
    background: var(--color-sand);
    color: var(--color-ink);
  }
  .l2 {
    background: var(--color-murram);
    color: #fff;
  }
  .l3 {
    background: var(--color-papyrus);
    color: var(--color-parchment);
  }
  .l4 {
    background: var(--color-ink);
    color: var(--color-parchment);
  }
  .l4 .yr {
    color: var(--color-ember);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (min-width: 64rem) {
    .layers {
      grid-template-columns: 1fr;
      width: 16.5rem;
      border-radius: 7.5rem 7.5rem 0 0;
      overflow: hidden;
      border-width: 2px;
    }
    .layers li {
      min-height: 0;
      padding: 1.1rem 1.4rem;
      flex-direction: row;
      align-items: baseline;
      gap: 0.9rem;
    }
    .l1 {
      padding-top: 4.5rem !important;
      height: 10rem;
    }
    .l2 {
      height: 6.5rem;
    }
    .l3 {
      height: 5.5rem;
    }
    .l4 {
      height: 7.5rem;
    }
    .yr {
      font-size: 1.7rem;
      flex: none;
      width: 5.4rem;
    }
    .tx {
      font-size: 0.85rem;
    }
    /* Wavy seams between layers */
    .l2,
    .l3,
    .l4 {
      position: relative;
    }
    .l2::before,
    .l3::before,
    .l4::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -7px;
      height: 14px;
      background: inherit;
      clip-path: path('M0 7 C 40 0 70 14 120 7 S 200 0 240 7 V14 H0Z');
    }
    figcaption {
      width: 16.5rem;
    }
  }
</style>
