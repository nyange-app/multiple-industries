---
/** Text wordmark (replaces the purple raster logo, which clashes with the earth palette). */
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['wm', { inverse }]}>
  <span class="mono" aria-hidden="true">M<i>i</i></span>
  <span class="words">
    <span class="name">Multiple Industries</span>
    <span class="sub">Limited · Est. 1991</span>
  </span>
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-ink);
  }
  .mono {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    background: var(--color-murram);
    color: var(--color-parchment);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 650;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: -0.04em;
    border-radius: 0 0 1.1rem 0;
  }
  .mono i {
    font-style: italic;
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .name {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .sub {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 0.2rem;
  }
  .inverse {
    color: var(--color-parchment);
  }
  .inverse .sub {
    color: var(--color-sand);
  }
</style>
