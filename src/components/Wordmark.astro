---
/* Text wordmark in Archivo. The supplied purple raster logo is not used in this
   single-accent system; TODO: client to supply an SVG logo for a mono version. */
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <span class="grid h-9 w-9 shrink-0 place-items-center bg-signal text-paper" aria-hidden="true">
    <span class="display text-[1.35rem] leading-none" style="font-stretch:70%">MI</span>
  </span>
  <span class="flex flex-col leading-none">
    <span class:list={['display text-[1.3rem] tracking-tight', inverse ? 'text-paper' : 'text-ink']} style="font-stretch:72%">Multiple Industries</span>
    <span class:list={['mt-1 text-[0.6875rem] font-semibold uppercase tracking-[0.14em]', inverse ? 'text-paper/80' : 'text-muted']}>Ltd &middot; Kampala &middot; 1991</span>
  </span>
</span>
