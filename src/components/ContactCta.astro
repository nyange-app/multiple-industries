---
import { CONTACT } from '../config';
interface Props { title?: string; lead?: string }
const {
  title = 'Building, fixing or restocking? Talk to us.',
  lead = 'Call the showroom, email the sales team, or come to 8th Street Industrial Area, Kampala.',
} = Astro.props;
---
<section class="wrap pt-4" aria-labelledby="cta-title">
  <div class="relative overflow-hidden rounded-[1.75rem] border-2 border-ink bg-sky p-6 shadow-[0_6px_0_var(--color-ink)] md:p-10">
    <div aria-hidden="true" class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sun md:h-56 md:w-56"></div>
    <div class="relative grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <h2 id="cta-title" class="max-w-[16ch] text-3xl font-bold md:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-muted">{lead}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={CONTACT.hotline.href} class="btn btn-sun">Call {CONTACT.hotline.label}</a>
          <a href="mailto:sales@multipleindustries.com" class="btn btn-ghost">Email sales</a>
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {[CONTACT.showroom, CONTACT.headOffice].map((o) => (
          <div class="card p-5">
            <h3 class="text-lg font-bold">{o.label}</h3>
            <address class="mt-1 not-italic text-muted">{o.street}, {o.city}</address>
            <a href={o.phones[o.phones.length > 2 ? 1 : 0].href} class="font-display mt-3 inline-flex min-h-11 items-center font-semibold underline decoration-sun decoration-[3px] underline-offset-4">
              {o.phones[o.phones.length > 2 ? 1 : 0].label}
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
