---
import Icon from './Icon.astro';
import { HEAD_OFFICE, SHOWROOM } from '../config';
interface Props {
  heading?: string;
  subject?: string;
}
const { heading = 'Pricing, stock and orders — talk to our sales desk.', subject = 'Quotation request' } = Astro.props;
const mail = `mailto:${HEAD_OFFICE.emails[1]}?subject=${encodeURIComponent(subject)}`;
---

<section class="border-y-2 border-ink bg-signal" aria-labelledby="cta-h">
  <div class="wrap grid gap-8 py-12 md:grid-cols-12 md:items-end md:py-16">
    <div class="md:col-span-7">
      <p class="label mb-3">Sales desk &middot; 8th Street Industrial Area</p>
      <h2 id="cta-h" class="display text-4xl sm:text-5xl lg:text-6xl">{heading}</h2>
    </div>
    <div class="flex flex-col gap-3 md:col-span-5">
      <a href={`tel:${SHOWROOM.phones[1].tel}`} class="btn btn-ghost justify-between bg-sheet text-lg">
        <span class="flex items-center gap-3"><Icon name="phone" class="size-6" /> {SHOWROOM.phones[1].display}</span>
        <span class="label">Call</span>
      </a>
      <a href={`tel:${SHOWROOM.phones[2].tel}`} class="btn btn-ghost justify-between bg-sheet text-lg">
        <span class="flex items-center gap-3"><Icon name="phone" class="size-6" /> {SHOWROOM.phones[2].display}</span>
        <span class="label">Call</span>
      </a>
      <a href={mail} class="btn btn-ghost justify-between bg-ink text-paper hover:!bg-plum-ink">
        <span class="flex min-w-0 items-center gap-3"><Icon name="mail" class="size-6 shrink-0" /> <span class="truncate">Email for a quotation</span></span>
        <Icon name="arrow" class="size-5 shrink-0" />
      </a>
    </div>
  </div>
</section>
