---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 text-muted">
    {
      items.map((it, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < items.length - 1 ? (
            <a href={it.href} class="inline-flex min-h-11 items-center underline hover:text-ink">
              {it.name}
            </a>
          ) : (
            <span aria-current="page" class="inline-flex min-h-11 items-center font-semibold text-ink">
              {it.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
