---
import type { Crumb } from '../layouts/Layout.astro';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const all = [{ name: 'Home', href: '/' }, ...crumbs];
---

<nav aria-label="Breadcrumb">
  <ol class="label flex flex-wrap items-center gap-x-2 text-ink-3">
    {
      all.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === all.length - 1 ? (
            <span aria-current="page" class="text-ink">
              {c.name}
            </span>
          ) : (
            <a href={c.href} class="inline-flex min-h-11 items-center underline-offset-4 hover:text-plum hover:underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
