---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {
      items.map((it, i) =>
        i < items.length - 1 ? (
          <li>
            <a href={it.path}>{it.name}</a>
            <span aria-hidden="true">/</span>
          </li>
        ) : (
          <li aria-current="page">{it.name}</li>
        ),
      )
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
    color: var(--color-muted);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-murram);
    font-weight: 600;
  }
  [aria-current='page'] {
    color: var(--color-ink);
  }
</style>
