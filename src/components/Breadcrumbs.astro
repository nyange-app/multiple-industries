---
import type { Crumb } from '../layouts/Layout.astro';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const trail = [{ name: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb">
  <ol class="label flex flex-wrap items-center gap-x-2 gap-y-1 text-fog">
    {
      trail.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-signal">/</span>}
          {i === trail.length - 1 ? (
            <span aria-current="page" class="text-paper">{c.name}</span>
          ) : (
            <a href={c.href} class="inline-flex min-h-8 items-center underline-offset-4 hover:text-paper hover:underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
