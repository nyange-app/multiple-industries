---
interface Crumb {
  name: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-steel">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-graphite-2">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-porcelain-dim">{c.name}</span>
          ) : (
            <a href={c.href} class="inline-block py-2 hover:text-brass-bright">{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
