---
import type { Category } from '../data/categories';
import Stage from './Stage.astro';

interface Props {
  category: Category;
  headingLevel?: 'h2' | 'h3';
}
const { category: c, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="is-lit group relative flex flex-col border border-graphite-2 bg-graphite transition-colors duration-500 hover:border-brass-deep focus-within:border-brass-deep">
  <Stage kind={c.object} class="aspect-[4/3.6]" />
  <div class="flex flex-1 flex-col gap-3 p-5 pt-6">
    <p class="eyebrow">Exhibit No. {c.no}</p>
    <H class="text-[1.9rem] text-porcelain">
      <a href={`/products/${c.slug}/`} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
        {c.name}
      </a>
    </H>
    <p class="text-[0.95rem] leading-relaxed text-steel">{c.short}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-bold tracking-wide text-brass group-hover:text-brass-bright">
      View the collection
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" /></svg>
    </span>
  </div>
  <span class="pointer-events-none absolute inset-0 hidden ring-2 ring-brass-bright group-has-[a:focus-visible]:block" aria-hidden="true"></span>
</article>
