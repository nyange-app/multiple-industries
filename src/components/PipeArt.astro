---
/** Hero illustration: drafted pipe cross-sections with material callouts. Decorative. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const pipes = [
  { cx: 200, cy: 232, r: 150, wall: 20, stroke: '#f2b705', label: 'UPVC', lx: 30, ly: 52, ex: 94, ey: 126 },
  { cx: 410, cy: 120, r: 84, wall: 13, stroke: '#c04fb0', label: 'HDPE', lx: 438, ly: 24, ex: 446, ey: 44 },
  { cx: 420, cy: 330, r: 58, wall: 10, stroke: '#f4f2ed', label: 'PP-R', lx: 444, ly: 424, ex: 446, ey: 382 },
];
---

<svg
  viewBox="0 0 520 440"
  class={cls}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  font-family="'JetBrains Mono Variable', monospace"
>
  {
    pipes.map((p) => (
      <g>
        <circle cx={p.cx} cy={p.cy} r={p.r} fill="#1c1d22" />
        <circle cx={p.cx} cy={p.cy} r={p.r - p.wall / 2} fill="none" stroke={p.stroke} stroke-width={p.wall} />
        <circle cx={p.cx} cy={p.cy} r={p.r - p.wall - 6} fill="none" stroke={p.stroke} stroke-opacity="0.25" stroke-width="1" />
        <circle cx={p.cx} cy={p.cy} r={p.r - p.wall - 22} fill="none" stroke={p.stroke} stroke-opacity="0.12" stroke-width="1" />
        <path
          d={`M${p.cx - p.r - 14} ${p.cy}H${p.cx + p.r + 14}M${p.cx} ${p.cy - p.r - 14}V${p.cy + p.r + 14}`}
          stroke="#f4f2ed"
          stroke-opacity="0.35"
          stroke-dasharray="10 4 2 4"
          stroke-width="1"
        />
        <circle cx={p.cx} cy={p.cy} r="3" fill={p.stroke} />
        <path d={`M${p.ex} ${p.ey}L${p.lx + 4} ${p.ly + (p.ly < p.cy ? 8 : -16)}`} stroke={p.stroke} stroke-width="1.25" />
        <text x={p.lx} y={p.ly} fill={p.stroke} font-size="15" font-weight="600" letter-spacing="2">
          {p.label}
        </text>
      </g>
    ))
  }
  <!-- dimension line across the large pipe -->
  <g stroke="#f4f2ed" stroke-opacity="0.6" stroke-width="1">
    <path d="M50 404H350" />
    <path d="M50 396v16M350 396v16" />
  </g>
  <text x="200" y="430" fill="#f4f2ed" fill-opacity="0.7" font-size="12" text-anchor="middle" letter-spacing="2">
    OD · ALL SIZES
  </text>
</svg>
