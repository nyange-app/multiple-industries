---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={`pipe-art ${cls}`} viewBox="0 0 400 400" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <circle cx="200" cy="200" r="190" stroke-width="1" />
  <circle cx="200" cy="200" r="160" stroke-width="1" />
  <circle cx="200" cy="200" r="130" stroke-width="1" />
  <circle cx="200" cy="200" r="70" stroke-width="1" />
  <circle cx="200" cy="200" r="40" stroke-width="1" />
  <path d="M200 0V400M0 200H400" stroke-width=".5" stroke-dasharray="3 5" />
  <path d="M200 70a130 130 0 0 1 130 130" stroke-width="10" stroke-linecap="butt" class="text-clay" style="color:var(--color-clay)" />
</svg>
