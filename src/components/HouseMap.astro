---
/** The interactive house plus its numbered legend. Hover/focus on either lights the other (CSS :has). */
import House from './House.astro';
import { categories } from '../data/categories';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<div class="house-map grid items-start gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-10">
  <div class="overflow-hidden rounded-[1.75rem] border-2 border-ink bg-sky shadow-[0_6px_0_var(--color-ink)]">
    <House interactive id="hm" />
  </div>
  <ol class="legend grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    {categories.map((c) => (
      <li>
        <a
          href={`/products/${c.slug}/`}
          data-zone={c.n}
          class="card group flex h-full items-start gap-4 p-4 transition-colors hover:border-ink"
        >
          <span class="badge-n" aria-hidden="true">{c.n}</span>
          <div class="min-w-0">
            <span class="font-display block text-xs font-semibold uppercase tracking-widest text-leaf">{c.zone}</span>
            <H class="mt-1 text-lg font-bold leading-snug">{c.name}</H>
            <span class="mt-1 block text-[0.95rem] leading-snug text-muted">{c.short}</span>
            <span class="font-display mt-2 inline-flex items-center gap-1 text-sm font-semibold text-ink">
              <span class="underline decoration-sun decoration-[3px] underline-offset-4 group-hover:decoration-ink">See the range</span><span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</div>
