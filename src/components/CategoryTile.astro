---
import Icon from './Icon.astro';
import type { Category } from '../data/categories';
interface Props {
  cat: Category;
  index: number;
  headingLevel?: 'h2' | 'h3';
}
const { cat, index, headingLevel: H = 'h3' } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---
<li class="panel ejector lift group relative grid grid-cols-[auto_1fr] gap-x-4 p-4 pt-6 sm:flex sm:flex-col sm:p-6 sm:pt-8">
  <div class="row-span-2 flex items-start justify-between gap-4">
    <span class="cavity grid h-14 w-14 shrink-0 place-items-center rounded-2xl text-ppr-deep sm:h-16 sm:w-16">
      <Icon name={cat.icon} class="h-7 w-7 sm:h-8 sm:w-8" />
    </span>
    <span class="deboss hidden font-display text-4xl font-extrabold leading-none tracking-tight sm:block" aria-hidden="true">{num}</span>
  </div>
  <H class="text-lg sm:mt-5 sm:text-[1.375rem]">
    <a href={`/products/${cat.slug}/`} class="no-underline after:absolute after:inset-0 after:rounded-[var(--radius-mould)] after:content-['']">
      {cat.name}
    </a>
  </H>
  <p class="mt-1 text-[0.95rem] text-muted sm:mt-2 sm:text-base">{cat.short}</p>
  <span class="col-start-2 mt-auto inline-flex items-center gap-1.5 pt-2 font-display font-bold text-ppr-deep sm:pt-5">
    View range <Icon name="arrow" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
  </span>
</li>
