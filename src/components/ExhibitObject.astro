---
/** Line-drawn "exhibit" objects (inline SVG, currentColor). Decorative: aria-hidden. */
import type { ObjectKind } from '../data/categories';

interface Props {
  kind: ObjectKind;
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;
---

<svg
  class:list={['object', cls]}
  viewBox="0 0 200 160"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === 'tap' && (
      <g>
        <path d="M18 52h58M18 70h58" />
        <path d="M18 52v18" />
        <rect x="76" y="40" width="22" height="42" rx="3" />
        <path d="M98 50h34a22 22 0 0 1 22 22v18M98 72h20a14 14 0 0 1 14 14v4" />
        <path d="M128 90h30" />
        <path d="M87 40V26M70 26h34" />
        <circle cx="87" cy="26" r="4" class="accent" />
        <path
          class="accent"
          d="M143 106c0 0-8 10-8 16a8 8 0 0 0 16 0c0-6-8-16-8-16Z"
        />
        <path d="M30 52v18M48 52v18" stroke-width="1.4" opacity="0.6" />
      </g>
    )
  }
  {
    kind === 'elbow' && (
      <g>
        <path d="M30 60h56a34 34 0 0 1 34 34v44M30 88h56a6 6 0 0 1 6 6v44" />
        <path d="M30 60v28" />
        <path d="M92 138h28" />
        <rect class="accent" x="52" y="54" width="10" height="40" rx="2" />
        <rect class="accent" x="86" y="108" width="40" height="10" rx="2" />
        <path d="M120 60h50M120 74h50" stroke-width="1.4" opacity="0.55" />
        <path d="M170 60v14" stroke-width="1.4" opacity="0.55" />
      </g>
    )
  }
  {
    kind === 'basin' && (
      <g>
        <path d="M28 92h144" />
        <path d="M38 92c4 28 28 42 62 42s58-14 62-42" />
        <path d="M70 134v8h60v-8" />
        <path d="M112 92V58a16 16 0 0 0-32 0v4" />
        <path d="M74 62h12" />
        <path d="M112 72h22" class="accent" />
        <circle cx="136" cy="72" r="3" class="accent" />
        <path d="M80 70v8" stroke-width="1.6" stroke-dasharray="2 5" opacity="0.7" />
      </g>
    )
  }
  {
    kind === 'truss' && (
      <g>
        <path d="M16 118L100 40l84 78Z" />
        <path d="M58 118l21-58M100 118V40M142 118l-21-58M58 118l42-40M142 118l-42-40" stroke-width="1.6" />
        <path d="M10 126h180" stroke-width="1.4" opacity="0.5" />
        <circle class="accent" cx="58" cy="118" r="3.4" />
        <circle class="accent" cx="100" cy="118" r="3.4" />
        <circle class="accent" cx="142" cy="118" r="3.4" />
        <circle class="accent" cx="100" cy="40" r="3.4" />
      </g>
    )
  }
  {
    kind === 'bucket' && (
      <g>
        <path d="M30 64h64l-8 72H38Z" />
        <path d="M30 64c0-34 64-34 64 0" stroke-width="1.8" />
        <path d="M34 84h56" class="accent" />
        <path d="M112 50h44a6 6 0 0 1 6 6v74a6 6 0 0 1-6 6h-44a6 6 0 0 1-6-6V56a6 6 0 0 1 6-6Z" />
        <path d="M120 50v-12h16v12" />
        <path d="M146 50l6-12h8" />
        <path d="M118 66h32M118 74h32" stroke-width="1.4" opacity="0.6" />
        <rect class="accent" x="124" y="34" width="8" height="4" />
      </g>
    )
  }
  {
    kind === 'tyre' && (
      <g>
        <circle cx="100" cy="82" r="58" />
        <circle cx="100" cy="82" r="44" />
        <circle cx="100" cy="82" r="22" class="accent" />
        <circle cx="100" cy="82" r="6" />
        <g stroke-width="1.6" opacity="0.7">
          <path d="M100 24v14M100 126v14M42 82h14M144 82h14M59 41l10 10M131 113l10 10M141 41l-10 10M69 113l-10 10" />
        </g>
        <g class="accent" stroke-width="1.6">
          <circle cx="100" cy="69" r="2" />
          <circle cx="113" cy="82" r="2" />
          <circle cx="100" cy="95" r="2" />
          <circle cx="87" cy="82" r="2" />
        </g>
      </g>
    )
  }
</svg>
