---
interface Props { slug: string; class?: string }
const { slug, class: cls = 'h-10 w-10' } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
  {slug === 'water-management' && (<>
    <path d="M24 5 C24 5 11 20 11 29 a13 13 0 0 0 26 0 C37 20 24 5 24 5Z" />
    <path d="M17 30 a7 7 0 0 0 7 7" />
  </>)}
  {slug === 'indoor-outdoor-plumbing' && (<>
    <path d="M4 14h26v10h14" />
    <path d="M44 24v14" />
    <rect x="28" y="10" width="6" height="18" />
    <rect x="40" y="34" width="8" height="8" transform="translate(-4 0)" />
  </>)}
  {slug === 'bathroom-kitchen' && (<>
    <path d="M6 24h36v6a10 10 0 0 1-10 10H16A10 10 0 0 1 6 30z" />
    <path d="M12 24V12a5 5 0 0 1 10 0" />
    <path d="M14 40l-2 4M34 40l2 4" />
  </>)}
  {slug === 'building-materials' && (<>
    <rect x="5" y="28" width="16" height="9" />
    <rect x="27" y="28" width="16" height="9" />
    <rect x="16" y="17" width="16" height="9" />
    <path d="M3 41h42" />
  </>)}
  {slug === 'domestic-plasticware' && (<>
    <path d="M10 14h28l-3 26H13z" />
    <path d="M8 14h32" />
    <path d="M17 24h14" />
  </>)}
  {slug === 'automotive' && (<>
    <circle cx="24" cy="24" r="18" />
    <circle cx="24" cy="24" r="6" />
    <path d="M24 6v12M24 30v12M6 24h12M30 24h12" />
  </>)}
</svg>
