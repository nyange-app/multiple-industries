---
/** A hanging aisle sign linking to a product category. */
import Icon from './Icon.astro';
import type { Aisle } from '../data/aisles';
interface Props {
  aisle: Aisle;
  headingLevel?: 'h2' | 'h3';
}
const { aisle, headingLevel: H = 'h3' } = Astro.props;
---

<div class="hang h-full">
  <div class="hang__swing">
    <a href={`/products/${aisle.slug}/`} class="sign group flex flex-col p-5 pb-4">
      <div class="flex items-start justify-between gap-4">
        <span class="aisle-no"><small>Aisle</small><b>{aisle.number}</b></span>
        <span class="pictogram text-white/90"><Icon name={aisle.icon} class="size-6" /></span>
      </div>
      <H class="mt-4 text-[1.375rem] font-extrabold">{aisle.name}</H>
      <p class="mt-2 flex-1 text-white/85">{aisle.short}</p>
      <span class="font-display mt-4 inline-flex min-h-11 items-center gap-2 border-t border-white/15 pt-3 font-bold text-signal">
        Go to aisle {aisle.number}
        <Icon name="arrowRight" class="size-5 transition-transform group-hover:translate-x-1" />
      </span>
    </a>
  </div>
</div>
