---
/**
 * The numbered type index: departments as large typographic rows, not cards.
 * Hover/focus slides the department glyph in and draws the rule in murram.
 */
import Glyph from './Glyph.astro';
import type { Category } from '../data/categories';
interface Props {
  items: Category[];
  headingLevel?: 'h2' | 'h3';
}
const { items, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ol class="tindex">
  {
    items.map((c) => (
      <li>
        <a href={`/products/${c.slug}/`} class="row">
          <span class="no" aria-hidden="true">
            {c.no}
          </span>
          <span class="body">
            <H class="name">
              <span class="glyph-wrap" aria-hidden="true">
                <Glyph name={c.glyph} class="glyph" />
              </span>
              <span class="sr-only">{c.no}. </span>
              {c.name}
            </H>
            <span class="short">{c.short}</span>
          </span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .tindex {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--color-ink);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr 1.5rem;
    align-items: start;
    gap: 0.75rem;
    padding: 1.15rem 0 1.25rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  /* Drawn murram rule */
  .row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--color-murram);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .no {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-style: italic;
    font-weight: 500;
    font-size: 1.9rem;
    line-height: 1;
    color: var(--color-murram);
    padding-top: 0.1rem;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: clamp(1.45rem, 5.4vw, 2.6rem);
    line-height: 1.05;
  }
  .glyph-wrap {
    display: inline-flex;
    flex: none;
    color: var(--color-papyrus);
  }
  .glyph-wrap :global(.glyph) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .short {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.98rem;
    max-width: 36rem;
  }
  .arrow {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.35rem;
    color: var(--color-murram);
    transition: transform 0.3s ease;
  }
  .row:hover::after,
  .row:focus-visible::after {
    transform: scaleX(1);
  }
  .row:hover .arrow,
  .row:focus-visible .arrow {
    transform: translateX(4px);
  }
  .row:hover .name {
    color: var(--color-murram-deep);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 6rem 1fr 2rem;
      gap: 1.25rem;
      padding: 1.6rem 0 1.7rem;
      align-items: center;
    }
    .no {
      font-size: 3.6rem;
    }
    .short {
      font-size: 1.05rem;
    }
    /* Glyph is hidden at rest and slides in on hover/focus */
    .glyph-wrap {
      width: 0;
      overflow: hidden;
      opacity: 0;
      transform: translateX(-0.75rem);
      transition:
        width 0.35s ease,
        opacity 0.35s ease,
        transform 0.35s ease;
    }
    .glyph-wrap :global(.glyph) {
      width: 2.6rem;
      height: 2.6rem;
    }
    .row:hover .glyph-wrap,
    .row:focus-visible .glyph-wrap {
      width: 2.8rem;
      opacity: 1;
      transform: none;
    }
    .arrow {
      width: 2rem;
      height: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .body {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
    }
    .short {
      margin-top: 0;
    }
  }
</style>
