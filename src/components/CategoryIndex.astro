---
import Icon from './Icon.astro';
import { categories } from '../data/categories';
interface Props {
  exclude?: string;
  headingLevel?: 'h2' | 'h3';
}
const { exclude, headingLevel = 'h3' } = Astro.props;
const list = categories.filter((c) => c.slug !== exclude);
const H = headingLevel;
---

<ul class="grid border-t-2 border-l-2 border-ink sm:grid-cols-2 lg:grid-cols-3">
  {
    list.map((c) => (
      <li class="border-r-2 border-b-2 border-ink">
        <a
          href={`/products/${c.slug}/`}
          class="group relative flex h-full flex-col gap-3 bg-sheet p-5 sm:gap-4 transition-colors hover:bg-signal sm:p-6"
        >
          <div class="flex items-start justify-between">
            <span class="display text-4xl text-plum transition-colors group-hover:text-ink sm:text-6xl">{c.no}</span>
            <Icon name={c.icon} class="size-11 text-ink sm:size-12" />
          </div>
          <H class="headline text-2xl">{c.name}</H>
          <p class="text-ink-2 group-hover:text-ink">{c.short}</p>
          <span class="label mt-auto flex items-center gap-2 pt-2 text-ink">
            View division
            <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      </li>
    ))
  }
  {
    exclude && (
      <li class="border-r-2 border-b-2 border-ink">
        <a
          href="/products/"
          class="on-dark group flex h-full min-h-40 flex-col justify-between gap-4 bg-ink p-5 text-paper transition-colors hover:bg-plum-ink sm:p-6"
        >
          <span class="label text-signal">Catalogue index</span>
          <span class="headline text-2xl">All six product divisions</span>
          <span class="label flex items-center gap-2">
            View all <Icon name="arrow" class="size-5 transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      </li>
    )
  }
</ul>
