---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="bg-gradient-to-b from-brand-50 to-white">
  <div class="container-x py-14 sm:py-20">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
