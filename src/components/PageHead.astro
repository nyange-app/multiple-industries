---
interface Props { eyebrow: string; title: string; lead?: string; crumbs?: { name: string; href?: string }[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="relative isolate overflow-hidden border-b border-line">
  <div class="bg-blueprint absolute inset-0 -z-10"></div>
  <div class="glow absolute inset-0 -z-10"></div>
  <div class="container-x py-14 lg:py-24">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="inline-flex min-h-11 items-center hover:text-cyan" href="/">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2"><span aria-hidden="true">/</span>
              {c.href ? <a class="inline-flex min-h-11 items-center hover:text-cyan" href={c.href}>{c.name}</a> : <span aria-current="page" class="text-ink">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-4xl text-[2.6rem] sm:text-6xl lg:text-7xl">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg text-muted">{lead}</p>}
    <slot />
  </div>
</section>
