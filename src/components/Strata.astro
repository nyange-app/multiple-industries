---
/**
 * Soil-strata divider: section edges are drawn as layered bands of earth,
 * like a road cutting through murram. Purely decorative SVG.
 * `from` = colour of the section above, `to` = colour of the section below.
 */
interface Props {
  from?: string;
  to?: string;
  variant?: 1 | 2 | 3;
  /** Middle bands. Defaults to sand + murram. */
  bands?: [string, string];
}
const {
  from = 'var(--color-parchment)',
  to = 'var(--color-clay)',
  variant = 1,
  bands = ['var(--color-sand)', 'var(--color-murram-bright)'],
} = Astro.props;

const waves: Record<number, [string, string, string]> = {
  1: [
    'M0 38 C 180 18 320 52 520 36 S 900 10 1080 30 S 1340 48 1440 26 V120 H0Z',
    'M0 62 C 220 44 380 74 600 58 S 980 36 1180 56 S 1380 66 1440 52 V120 H0Z',
    'M0 74 C 200 60 420 88 640 72 S 1000 54 1220 70 S 1400 80 1440 70 V120 H0Z',
  ],
  2: [
    'M0 22 C 240 46 420 14 660 30 S 1060 52 1260 28 S 1400 20 1440 30 V120 H0Z',
    'M0 50 C 260 70 460 40 700 56 S 1080 74 1300 52 S 1420 46 1440 54 V120 H0Z',
    'M0 66 C 260 82 480 54 720 70 S 1100 86 1320 66 S 1420 62 1440 68 V120 H0Z',
  ],
  3: [
    'M0 30 C 140 30 260 12 420 24 S 760 50 960 34 S 1260 8 1440 28 V120 H0Z',
    'M0 56 C 160 54 300 40 460 50 S 800 72 1000 58 S 1280 38 1440 54 V120 H0Z',
    'M0 70 C 180 70 320 58 480 66 S 820 86 1020 72 S 1300 56 1440 70 V120 H0Z',
  ],
};
const [a, b, c] = waves[variant];
---

<div class="strata" style={`background:${from}`} aria-hidden="true">
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false">
    <path d={a} fill={bands[0]}></path>
    <path d={b} fill={bands[1]}></path>
    <path d={c} fill={to}></path>
  </svg>
</div>

<style>
  .strata {
    display: block;
    line-height: 0;
    margin-bottom: -1px;
  }
  .strata svg {
    display: block;
    width: 100%;
    height: 3.5rem;
  }
  @media (min-width: 48rem) {
    .strata svg {
      height: 6rem;
    }
  }
</style>
