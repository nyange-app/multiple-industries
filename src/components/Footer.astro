---
import { HEAD_OFFICE, LEGAL_NAME, NAV, SHOWROOM, TAGLINE } from '../config';
import { categories } from '../data/categories';
const offices = [HEAD_OFFICE, SHOWROOM];
---

<footer class="on-dark bg-ink text-paper">
  <div class="tape" aria-hidden="true"></div>
  <div class="wrap grid gap-10 py-12 md:grid-cols-12 md:py-16">
    <div class="md:col-span-4">
      <p class="display text-4xl text-paper sm:text-5xl">
        Multiple<br /><span class="text-signal">Industries</span>
      </p>
      <p class="mt-4 max-w-xs text-paper/80">{TAGLINE}.</p>
      <p class="label mt-6 text-paper/70">ISO 9001:2015 &middot; UNBS certified products</p>
    </div>

    {
      offices.map((o) => (
        <div class="md:col-span-3">
          <h2 class="label mb-3 border-t border-paper/30 pt-3 text-signal">{o.label}</h2>
          <address class="not-italic text-paper/85">
            {o.lines.map((l) => (
              <span class="block">{l}</span>
            ))}
          </address>
          <ul class="mt-3 space-y-0.5">
            {o.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`} class="inline-flex min-h-11 items-center gap-2 hover:text-signal">
                  <span class="label text-paper/60">{p.label}</span>
                  {p.display}
                </a>
              </li>
            ))}
            {o.emails.map((e) => (
              <li>
                <a href={`mailto:${e}`} class="inline-flex min-h-11 items-center text-[0.95rem] [overflow-wrap:anywhere] hover:text-signal">
                  {e}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <nav aria-label="Footer" class="md:col-span-2">
      <h2 class="label mb-3 border-t border-paper/30 pt-3 text-signal">Index</h2>
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} class="inline-flex min-h-11 items-center hover:text-signal">
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-paper/20">
    <div class="wrap flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="label text-paper/70">&copy; 2026 {LEGAL_NAME}</p>
      <ul class="flex flex-wrap gap-x-4">
        {
          categories.map((c) => (
            <li>
              <a href={`/products/${c.slug}/`} class="label inline-flex min-h-11 items-center text-paper/70 hover:text-signal">
                {c.no} {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
