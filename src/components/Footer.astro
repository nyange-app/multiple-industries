---
import { CONTACT, NAV } from '../config';
import { categories } from '../data/categories';
---

<footer class="relative border-t border-line bg-surface">
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-1">
      <p class="font-display text-2xl font-semibold">Multiple <span class="text-gradient">Industries</span></p>
      <p class="mt-3 text-muted">Quality Building Materials You Can Trust Since 1991.</p>
      <p class="mt-3 text-sm text-muted">ISO 9001:2015 certified. Products certified by UNBS.</p>
    </div>
    <nav aria-label="Products">
      <p class="eyebrow mb-3">Products</p>
      <ul class="space-y-1">
        {categories.map((c) => (
          <li><a class="inline-flex min-h-11 items-center text-muted hover:text-cyan" href={`/products/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="eyebrow mb-3">Company</p>
      <ul class="space-y-1">
        {NAV.filter((n) => n.label !== 'Products').map((n) => (
          <li><a class="inline-flex min-h-11 items-center text-muted hover:text-cyan" href={n.href}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <address class="not-italic">
      <p class="eyebrow mb-3">Head office &amp; factory</p>
      <p class="text-muted">{CONTACT.head.address}</p>
      <p class="mt-3"><a class="inline-flex min-h-11 items-center text-ink hover:text-cyan" href="tel:+256414236021">+256 414 236021/2</a></p>
      <p><a class="inline-flex min-h-11 items-center break-all text-ink hover:text-cyan" href="mailto:response@multipleindustries.com">response@multipleindustries.com</a></p>
    </address>
  </div>
  <div class="border-t border-line py-5 text-center text-sm text-muted">&copy; 2026 Multiple Industries Limited</div>
</footer>
