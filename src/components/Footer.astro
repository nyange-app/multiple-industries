---
import { nav, offices } from '../data/site';
---
<footer class="bg-navy-950 text-white">
  <div class="hazard-bar" aria-hidden="true"></div>
  <div class="container-x grid gap-12 py-14 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="display text-4xl">Multiple<br />Industries<span class="text-signal">.</span></p>
      <p class="mt-4 max-w-xs text-white/80">Quality Building Materials You Can Trust Since 1991.</p>
      <p class="mt-4 inline-block border-2 border-hazard px-3 py-1 font-display text-lg font-bold uppercase tracking-wide text-hazard">ISO 9001:2015 certified</p>
    </div>
    <div class="grid gap-10 sm:grid-cols-2 md:col-span-8">
      {offices.map((o) => (
        <div>
          <h2 class="eyebrow text-signal">{o.name}</h2>
          <address class="mt-3 text-[15px] not-italic leading-relaxed text-white/85">
            {o.address.map((l) => <div>{l}</div>)}
            <ul class="mt-3 space-y-1">
              {o.phones.map((p) => (<li>{p.label}: <a class="inline-flex min-h-11 items-center underline decoration-white/40 underline-offset-4 hover:text-hazard sm:min-h-0" href={`tel:${p.href}`}>{p.display}</a></li>))}
              {o.emails.map((e) => (<li><a class="inline-flex min-h-11 items-center break-all underline decoration-white/40 underline-offset-4 hover:text-hazard sm:min-h-0" href={`mailto:${e}`}>{e}</a></li>))}
            </ul>
          </address>
        </div>
      ))}
    </div>
    <nav aria-label="Footer" class="md:col-span-12">
      <ul class="flex flex-wrap gap-x-6 gap-y-1 border-t border-white/15 pt-8">
        {nav.map((n) => <li><a href={n.href} class="inline-flex min-h-11 items-center font-display text-lg font-bold uppercase tracking-wide hover:text-hazard">{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-sm text-white/70">&copy; 2026 Multiple Industries Limited</div>
</footer>
