---
import Icon from './Icon.astro';
import { LEGAL_NAME, OFFICES, TAGLINE } from '../config';
import { categories } from '../data/categories';
const offices = [OFFICES.head, OFFICES.showroom];
---

<footer class="on-dark bg-ink text-paper">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-12 lg:py-16">
    <div class="lg:col-span-4">
      <p class="display text-4xl">Multiple<br />Industries <span class="text-signal">Ltd</span></p>
      <p class="mt-4 max-w-xs text-fog">{TAGLINE}.</p>
      <p class="label mt-6 inline-flex items-center gap-2 border border-ink-3 px-3 py-2 text-fog">
        <Icon name="shield" class="size-4 text-signal" /> ISO 9001:2015 · UNBS
      </p>
    </div>

    <nav aria-label="Product divisions" class="lg:col-span-3">
      <p class="label text-signal">Divisions</p>
      <ul class="mt-3">
        {
          categories.map((c) => (
            <li>
              <a href={`/products/${c.slug}/`} class="flex min-h-11 items-center gap-3 text-paper hover:text-signal">
                <span class="label text-fog">{c.code}</span>
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company" class="lg:col-span-2">
      <p class="label text-signal">Company</p>
      <ul class="mt-3">
        <li><a href="/about/" class="flex min-h-11 items-center hover:text-signal">About us</a></li>
        <li><a href="/products/" class="flex min-h-11 items-center hover:text-signal">All products</a></li>
        <li><a href="/contact/" class="flex min-h-11 items-center hover:text-signal">Contact</a></li>
      </ul>
    </nav>

    <div class="space-y-6 sm:col-span-2 lg:col-span-3 lg:col-start-10">
      {
        offices.map((o) => (
          <address class="not-italic">
            <p class="label text-signal">{o.label}</p>
            <p class="mt-2 text-fog">
              {o.street}
              <br />
              {o.pobox && <>{o.pobox}, </>}
              {o.city}, {o.country}
            </p>
            <p class="mt-1">
              <a href={`tel:${o.phones[0].tel}`} class="inline-flex min-h-11 items-center hover:text-signal">
                {o.phones[0].display}
              </a>
            </p>
          </address>
        ))
      }
    </div>
  </div>
  <div class="border-t border-ink-3">
    <div class="wrap flex flex-col gap-2 py-5 text-sm text-fog sm:flex-row sm:justify-between">
      <p>© 2026 {LEGAL_NAME}</p>
      <p class="label !text-[0.6875rem]">Kampala · Uganda · East Africa</p>
    </div>
  </div>
</footer>
