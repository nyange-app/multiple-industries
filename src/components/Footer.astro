---
import { HEAD_OFFICE, LEGAL_NAME, NAV, SHOWROOM } from '../config';
import { categories } from '../data/categories';
---

<footer class="on-ink border-t border-paper/25 bg-ink text-paper">
  <div class="wrap pt-14 pb-8 md:pt-20">
    <p class="display display-lg text-paper" aria-hidden="true">
      Multiple<br />Industries<span class="text-signal">.</span>
    </p>
    <div class="mt-12 grid gap-10 border-t border-paper/40 pt-8 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 class="label text-paper/75">Index</h2>
        <ul class="mt-3 space-y-0.5">
          {
            categories.map((c) => (
              <li>
                <a href={`/products/${c.slug}/`} class="inline-flex min-h-11 items-center gap-3 no-underline hover:underline">
                  <span class="font-display font-bold text-paper/70" style="font-stretch:70%">{c.num}</span>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        [HEAD_OFFICE, SHOWROOM].map((o) => (
          <div class="lg:col-span-3">
            <h2 class="label text-paper/75">{o.name}</h2>
            <address class="mt-3 not-italic leading-relaxed">
              {o.street}
              <br />
              {o.box && (
                <>
                  {o.box}
                  <br />
                </>
              )}
              {o.city}, {o.country}
            </address>
            <ul class="mt-3">
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="inline-flex min-h-11 items-center underline decoration-paper/50 hover:decoration-paper">
                    {p.label}: {p.display}
                  </a>
                </li>
              ))}
              {o.emails.map((e) => (
                <li>
                  <a href={`mailto:${e}`} class="inline-flex min-h-11 items-center text-[0.875rem] [overflow-wrap:anywhere] underline decoration-paper/50 hover:decoration-paper">
                    {e}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="lg:col-span-3">
        <h2 class="label text-paper/75">Company</h2>
        <ul class="mt-3">
          {
            [{ href: '/', label: 'Home' }, ...NAV].map((n) => (
              <li>
                <a href={n.href} class="inline-flex min-h-11 items-center no-underline hover:underline">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-paper/80">ISO 9001:2015 certified. Products certified by UNBS.</p>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-paper/40 pt-6 text-sm text-paper/75 sm:flex-row sm:justify-between">
      <p>&copy; 2026 {LEGAL_NAME}</p>
      <p>Quality Building Materials You Can Trust Since 1991</p>
    </div>
  </div>
</footer>
