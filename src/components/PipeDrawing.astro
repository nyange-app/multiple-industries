---
/** Engineering-drawing style cross-section of nested pipes — the hero motif. */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 520 460"
  role="img"
  aria-labelledby="pipe-title pipe-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="pipe-title">Technical drawing of UPVC, HDPE and PP-R pipe cross-sections</title>
  <desc id="pipe-desc">Three nested pipe sections drawn like a catalogue spec sheet, labelled UPVC, HDPE and PP-R.</desc>
  <defs>
    <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="8" height="8" fill="#fffdf8"></rect>
      <line x1="0" y1="0" x2="0" y2="8" stroke="#17151a" stroke-width="2"></line>
    </pattern>
    <marker id="arr" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10Z" fill="#17151a"></path>
    </marker>
  </defs>

  <!-- centre lines -->
  <g stroke="#17151a" stroke-width="1" stroke-dasharray="14 4 2 4" opacity="0.55">
    <line x1="210" y1="20" x2="210" y2="400"></line>
    <line x1="20" y1="210" x2="400" y2="210"></line>
  </g>

  <!-- outer pipe: UPVC (plum) -->
  <circle cx="210" cy="210" r="170" fill="#8f177d" stroke="#17151a" stroke-width="3"></circle>
  <circle cx="210" cy="210" r="146" fill="#f4f1ea" stroke="#17151a" stroke-width="3"></circle>

  <!-- middle pipe: HDPE (ink, hatched) -->
  <circle cx="210" cy="210" r="116" fill="url(#hatch)" stroke="#17151a" stroke-width="3"></circle>
  <circle cx="210" cy="210" r="94" fill="#f4f1ea" stroke="#17151a" stroke-width="3"></circle>

  <!-- inner pipe: PP-R (signal yellow) -->
  <circle cx="210" cy="210" r="64" fill="#ffc30e" stroke="#17151a" stroke-width="3"></circle>
  <circle cx="210" cy="210" r="46" fill="#0584bc" stroke="#17151a" stroke-width="3"></circle>
  <path d="M182 214c8-6 16 6 28 0s20 6 28 0" fill="none" stroke="#fffdf8" stroke-width="3"></path>
  <path d="M186 228c8-5 14 5 24 0s18 5 24 0" fill="none" stroke="#fffdf8" stroke-width="2.5" opacity="0.8"></path>

  <!-- leaders + labels -->
  <g fill="none" stroke="#17151a" stroke-width="1.5">
    <polyline points="330,90 390,50 500,50"></polyline>
    <polyline points="300,160 400,130 500,130"></polyline>
    <polyline points="262,190 410,210 500,210"></polyline>
  </g>
  <g fill="#17151a" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="500" letter-spacing="1">
    <circle cx="330" cy="90" r="4"></circle>
    <circle cx="300" cy="160" r="4"></circle>
    <circle cx="262" cy="190" r="4"></circle>
    <text x="500" y="42" text-anchor="end">A · UPVC</text>
    <text x="500" y="122" text-anchor="end">B · HDPE</text>
    <text x="500" y="202" text-anchor="end">C · PP-R</text>
  </g>

  <!-- dimension line -->
  <g stroke="#17151a" stroke-width="1.5">
    <line x1="40" y1="385" x2="40" y2="440"></line>
    <line x1="380" y1="385" x2="380" y2="440"></line>
    <line x1="44" y1="428" x2="376" y2="428" marker-start="url(#arr)" marker-end="url(#arr)"></line>
  </g>
  <rect x="150" y="416" width="120" height="24" fill="#f4f1ea"></rect>
  <text x="210" y="433" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="14" fill="#17151a" letter-spacing="1">ALL SIZES</text>

  <!-- title block -->
  <g font-family="IBM Plex Mono, monospace" font-size="12" fill="#17151a" letter-spacing="1">
    <rect x="410" y="372" width="108" height="68" fill="#fffdf8" stroke="#17151a" stroke-width="2"></rect>
    <line x1="410" y1="395" x2="518" y2="395" stroke="#17151a" stroke-width="1"></line>
    <line x1="410" y1="418" x2="518" y2="418" stroke="#17151a" stroke-width="1"></line>
    <text x="418" y="389">DWG MI-01</text>
    <text x="418" y="412">KLA · UG</text>
    <text x="418" y="435">EST. 1991</text>
  </g>
</svg>
