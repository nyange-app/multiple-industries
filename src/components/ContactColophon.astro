---
/** Contact "colophon": both offices, set like the back page of a magazine. */
import { OFFICES } from '../config';
interface Props {
  title?: string;
  lead?: string;
}
const {
  title = 'Come to the counter, or call ahead.',
  lead = 'Our sales team at 8th Street Industrial Area, Kampala will help you choose, quote and arrange collection.',
} = Astro.props;
---

<section class="colophon" aria-labelledby="colophon-title">
  <div class="wrap">
    <div class="box">
      <div class="lead">
        <p class="kicker">Colophon · Contact</p>
        <h2 id="colophon-title" class="display-md">{title}</h2>
        <p class="sub">{lead}</p>
        <a class="btn btn-primary" href="/contact/">All contact details</a>
      </div>
      {
        OFFICES.map((o) => (
          <div class="office">
            <h3>{o.name}</h3>
            <p class="addr">{[o.street, o.po, o.city].filter(Boolean).join(', ')}</p>
            <ul>
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`}>{p.label}</a>
                </li>
              ))}
              {o.emails.map((e) => (
                <li>
                  <a href={`mailto:${e}`}>{e.split('@')[0]}<wbr />@{e.split('@')[1]}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .colophon {
    padding-top: 1rem;
  }
  .box {
    display: grid;
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
  }
  .box > * {
    padding: 1.5rem 1.25rem;
  }
  .box > * + * {
    border-top: 1px solid var(--color-line);
  }
  .lead h2 {
    margin-top: 0.6rem;
  }
  .sub {
    color: var(--color-muted);
    margin: 0.75rem 0 1.25rem;
  }
  .office h3 {
    font-size: 1.35rem;
  }
  .addr {
    color: var(--color-muted);
    margin-top: 0.35rem;
  }
  .office ul {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  .office a {
    display: inline-block;
    padding-block: 0.6rem;
    line-height: 1.5;
    font-weight: 600;
    color: var(--color-murram);
    overflow-wrap: break-word;
  }
  @media (min-width: 64rem) {
    .box {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
    .box > * {
      padding: 2rem;
    }
    .box > * + * {
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }
</style>
