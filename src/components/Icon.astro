---
/** Inline line-icon set (24px grid, stroke = currentColor). Decorative unless `label` is set. */
const paths = {
  water: '<path d="M12 3.5c3.6 4.5 6 7.9 6 10.9a6 6 0 0 1-12 0c0-3 2.4-6.4 6-10.9Z"/><path d="M9.2 14.6a2.9 2.9 0 0 0 2.6 2.7"/>',
  plumbing: '<path d="M3 6.5h7.5a5.5 5.5 0 0 1 5.5 5.5v9"/><path d="M3 11h7a1.5 1.5 0 0 1 1.5 1.5V21"/><path d="M3 4.5v8.5M9.5 21h8.5"/>',
  bath: '<path d="M3 12h18v1.5a5.5 5.5 0 0 1-5.5 5.5h-7A5.5 5.5 0 0 1 3 13.5V12Z"/><path d="M6 12V6.5a2.5 2.5 0 0 1 5 0M7 19l-1 2M17 19l1 2"/>',
  building: '<path d="M2.5 11 12 4l9.5 7"/><path d="M5 9.5V20h14V9.5M5 20h14"/><path d="M9.5 20v-5.5h5V20M12 4v5.5"/>',
  plasticware: '<path d="M4.5 9h15l-1.6 11h-11.8L4.5 9Z"/><path d="M7 9a5 5 0 0 1 10 0M5.6 13h12.8"/>',
  automotive: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5V9M12 15v5.5M3.5 12H9M15 12h5.5"/>',
  arrowRight: '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  arrowLeft: '<path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>',
  arrowUp: '<path d="M12 19.5v-15M6 10.5l6-6 6 6"/>',
  arrowUpRight: '<path d="M6.5 17.5 17.5 6.5M8 6.5h9.5V16"/>',
  phone: '<path d="M5 3.5h3.5l1.8 4.6-2.3 1.4a11 11 0 0 0 6.5 6.5l1.4-2.3 4.6 1.8V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.8" r="2.4"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.2v.1"/>',
  truck: '<path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3.5v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8 7.5 9.5 4.3-1.5 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  store: '<path d="M3.5 9.5 5 4.5h14l1.5 5M3.5 9.5h17v1a2.8 2.8 0 0 1-5.6 0 2.8 2.8 0 0 1-5.8 0 2.8 2.8 0 0 1-5.6 0v-1Z"/><path d="M5 12.5V20h14v-7.5M10 20v-4.5h4V20"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
} as const;

export type IconKey = keyof typeof paths;

interface Props {
  name: IconKey;
  class?: string;
  label?: string;
  stroke?: number;
}
const { name, class: cls = 'size-6', label, stroke = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
