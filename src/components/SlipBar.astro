---
import { EMAIL_SALES, mailto, whatsapp } from '../config';
const intro = 'Hello Multiple Industries, I would like a quotation.';
---

<aside aria-label="Your enquiry slip" class="fixed inset-x-0 bottom-0 z-40 px-2 sm:px-4">
  <div class="drop mx-auto max-w-2xl">
    <div class="slip paper-canary tear-top flex items-center gap-2 rounded-b-none px-3 pb-3 sm:gap-3 sm:px-4">
      <p class="min-w-0 flex-1 leading-tight">
        <span class="form-label block">Your slip</span>
        <span class="no-js-only typed text-sm">Ask for a quote</span>
        <span class="needs-js typed text-sm" aria-live="polite"><b data-slip-count>0</b> <span data-slip-word>items</span> ticked</span>
      </p>
      <a data-slip-wa href={whatsapp(intro)} class="btn btn-primary !min-h-11 !px-3 text-sm" rel="noopener">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
        <span>WhatsApp<span class="sr-only"> your slip</span></span>
      </a>
      <a data-slip-mail href={mailto(EMAIL_SALES, 'Quotation request', intro)} class="btn btn-ghost !min-h-11 !px-3 text-sm">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <span>Email<span class="sr-only"> your slip</span></span>
      </a>
    </div>
  </div>
</aside>

<script>
  import '../scripts/slip';
</script>
