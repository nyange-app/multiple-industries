---
import Icon from './Icon.astro';
import { OFFICES, PRIMARY_TEL, PRIMARY_TEL_DISPLAY, SALES_EMAIL } from '../config';
interface Props {
  title?: string;
  subject?: string;
}
const { title = 'Get a quote from the sales desk', subject = 'Quotation request' } = Astro.props;
const mail = `mailto:${SALES_EMAIL}?subject=${encodeURIComponent(subject)}`;
---

<section aria-labelledby="cta-title" class="bg-signal text-ink">
  <div class="wrap grid gap-8 py-14 lg:grid-cols-12 lg:items-end lg:py-20">
    <div class="min-w-0 lg:col-span-7">
      <p class="label">Trade, contractor &amp; household orders</p>
      <h2 id="cta-title" class="display mt-3 text-5xl sm:text-6xl lg:text-7xl">{title}</h2>
      <p class="mt-4 max-w-xl text-lg">
        Call, email or visit the showroom on 8th Street, Industrial Area, Kampala — or send us your materials list for a
        quotation.
      </p>
    </div>
    <div class="flex min-w-0 flex-col gap-3 lg:col-span-5">
      <a href={`tel:${PRIMARY_TEL}`} class="btn btn-ink justify-between !min-h-14 text-lg">
        <span class="flex items-center gap-3"><Icon name="phone" class="size-5" /> {PRIMARY_TEL_DISPLAY}</span>
        <Icon name="arrow" class="size-5" />
      </a>
      <a href={`tel:${OFFICES.showroom.phones[1].tel}`} class="btn btn-line justify-between !min-h-14 text-lg">
        <span class="flex items-center gap-3"><Icon name="phone" class="size-5" /> Showroom {OFFICES.showroom.phones[1].display}</span>
        <Icon name="arrow" class="size-5" />
      </a>
      <a href={mail} class="btn btn-line justify-between !min-h-14 !normal-case">
        <span class="flex min-w-0 items-center gap-3"><Icon name="mail" class="size-5 shrink-0" /> <span class="truncate text-base sm:text-lg">{SALES_EMAIL}</span></span>
        <Icon name="arrow" class="size-5 shrink-0" />
      </a>
    </div>
  </div>
</section>
