---
import { NAV, PRIMARY_PHONE } from '../config';
import { categories } from '../data/categories';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper">
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <a href="/" class="-my-1 inline-flex min-h-11 items-center no-underline" aria-label="Multiple Industries, home">
      <Wordmark />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="inline-flex min-h-11 items-center px-3 font-semibold no-underline decoration-signal decoration-2 underline-offset-[0.4em] hover:underline aria-[current=page]:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-3">
          <a href={`tel:${PRIMARY_PHONE.tel}`} class="btn btn-ink min-h-11 py-2 text-[0.9375rem]">
            Call {PRIMARY_PHONE.display}
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a href={`tel:${PRIMARY_PHONE.tel}`} class="inline-flex h-11 items-center bg-signal px-3.5 font-semibold text-paper no-underline">
        Call
      </a>
      <details class="menu">
        <summary class="inline-flex h-11 items-center border-2 border-ink px-3.5 font-semibold" aria-label="Open menu">
          <span class="menu-open-label">Menu</span>
          <span class="menu-close-label">Close</span>
        </summary>
        <div class="fixed inset-x-0 top-16 bottom-0 overflow-y-auto border-t-2 border-ink bg-paper">
          <nav aria-label="Mobile" class="wrap py-6">
            <p class="label text-muted">Contents</p>
            <ul class="mt-3 border-b-2 border-ink">
              {
                categories.map((c) => (
                  <li class="border-t-2 border-ink">
                    <a href={`/products/${c.slug}/`} class="grid min-h-14 grid-cols-[3rem_1fr] items-center gap-2 py-2 no-underline">
                      <span class="display text-[1.9rem] text-signal" style="font-stretch:62%">{c.num}</span>
                      <span class="display text-[1.6rem]" style="font-stretch:72%">{c.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <ul class="mt-6 grid grid-cols-2 gap-2">
              {
                [{ href: '/', label: 'Home' }, ...NAV].map((n) => (
                  <li>
                    <a
                      href={n.href}
                      aria-current={path === n.href ? 'page' : undefined}
                      class="flex min-h-12 items-center justify-center border-2 border-ink font-semibold no-underline aria-[current=page]:bg-ink aria-[current=page]:text-paper"
                    >
                      {n.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
