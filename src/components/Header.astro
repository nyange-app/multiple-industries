---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import Extrusion from './Extrusion.astro';
import { NAV, PRIMARY_PHONE } from '../config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="sticky top-0 z-40 bg-mould/95 backdrop-blur-sm">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-3">
    <a href="/" class="logo-plate shrink-0 rounded-[0.7rem]" aria-label="Multiple Industries Ltd, home">
      <Image src={logo} alt="" width={180} height={44} densities={[1, 2]} class="block h-10 w-auto rounded-[0.6rem] sm:h-11" loading="eager" />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="cavity flex items-center gap-1 rounded-full p-1">
        {
          NAV.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={isCurrent(n.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-full px-5 font-display text-[0.95rem] font-semibold no-underline transition',
                  isCurrent(n.href)
                    ? 'bg-mould-hi text-ink shadow-[0_1px_0_#fff_inset,0_2px_6px_-2px_rgb(27_29_31/.35)]'
                    : 'text-muted hover:text-ink',
                ]}
              >
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:${PRIMARY_PHONE.tel}`} class="btn btn-cta hidden !px-4 sm:inline-flex">
        <Icon name="phone" />
        <span>{PRIMARY_PHONE.display}</span>
      </a>
      <details class="menu relative md:hidden">
        <summary class="btn !h-12 !w-12 !min-h-0 !p-0" aria-label="Menu">
          <span class="menu-icon-open"><Icon name="menu" /></span>
          <span class="menu-icon-close"><Icon name="close" /></span>
        </summary>
        <div class="panel absolute right-0 top-[calc(100%+0.75rem)] w-[min(20rem,calc(100vw-2rem))] p-3">
          <nav aria-label="Mobile">
            <ul class="grid gap-1">
              {
                [{ href: '/', label: 'Home' }, ...NAV].map((n) => (
                  <li>
                    <a
                      href={n.href}
                      aria-current={(n.href === '/' ? path === '/' : isCurrent(n.href)) ? 'page' : undefined}
                      class="flex min-h-12 items-center justify-between rounded-xl px-4 font-display text-lg font-semibold no-underline hover:bg-mould-lo aria-[current=page]:bg-ppr-tint aria-[current=page]:text-ppr-deep"
                    >
                      {n.label}
                      <Icon name="arrow" class="h-5 w-5 opacity-60" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <hr class="parting my-3" />
          <a href={`tel:${PRIMARY_PHONE.tel}`} class="btn btn-cta w-full">
            <Icon name="phone" />
            Call {PRIMARY_PHONE.display}
          </a>
        </div>
      </details>
    </div>
  </div>
  <Extrusion />
</header>

<style>
  .logo-plate {
    padding: 3px;
    background: linear-gradient(180deg, #ffffff, #dfe3dd);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.9) inset,
      0 3px 8px -3px rgb(27 29 31 / 0.4);
  }
</style>
