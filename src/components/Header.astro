---
import Wordmark from './Wordmark.astro';
import { NAV, HOTLINE } from '../config';
import { categories } from '../data/categories';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="masthead">
  <div class="dateline">
    <div class="wrap dateline-inner">
      <span>Kampala, Uganda</span>
      <span class="hide-sm">ISO 9001:2015 · UNBS certified products</span>
      <a href={`tel:${HOTLINE.tel}`}>Hotline {HOTLINE.label}</a>
    </div>
  </div>
  <div class="wrap bar">
    <a href="/" class="home-link" aria-label="Multiple Industries Limited, home">
      <Wordmark />
    </a>

    <nav class="desk-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary call" href={`tel:${HOTLINE.tel}`}>Call sales</a>
    </nav>

    <details class="mob-nav">
      <summary>
        <span class="lbl-open">Menu</span><span class="lbl-close">Close</span>
        <span class="burger" aria-hidden="true"><span></span></span>
      </summary>
      <nav class="panel" aria-label="Mobile">
        <p class="kicker">Sections</p>
        <ul class="primary">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="kicker">The index</p>
        <ul class="index">
          {
            categories.map((c) => (
              <li>
                <a href={`/products/${c.slug}/`}>
                  <span class="no">{c.no}</span>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-primary w-full" href={`tel:${HOTLINE.tel}`}>Call {HOTLINE.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 40;
    background: var(--color-parchment);
    border-bottom: 1px solid var(--color-line);
  }
  .dateline {
    background: var(--color-ink);
    color: var(--color-parchment);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .dateline-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.25rem;
    align-items: center;
  }
  .dateline a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-ember);
  }
  .dateline a:hover {
    text-decoration: underline;
  }
  .hide-sm {
    display: none;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 1rem;
  }
  .home-link {
    text-decoration: none;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }
  .desk-nav {
    display: none;
  }

  /* Mobile <details> menu: works with zero JS */
  .mob-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.4rem 0.2rem 0.4rem 0.8rem;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid var(--color-ink);
  }
  .mob-nav summary::-webkit-details-marker {
    display: none;
  }
  .lbl-close {
    display: none;
  }
  .mob-nav[open] .lbl-open {
    display: none;
  }
  .mob-nav[open] .lbl-close {
    display: inline;
  }
  .burger {
    position: relative;
    width: 2rem;
    height: 1.5rem;
  }
  .burger::before,
  .burger::after,
  .burger span {
    content: '';
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger::before {
    top: 0.3rem;
  }
  .burger span {
    top: 0.7rem;
    display: block;
  }
  .burger::after {
    top: 1.1rem;
  }
  .mob-nav[open] .burger::before {
    transform: translateY(0.4rem) rotate(45deg);
  }
  .mob-nav[open] .burger span {
    opacity: 0;
  }
  .mob-nav[open] .burger::after {
    transform: translateY(-0.4rem) rotate(-45deg);
  }
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-paper);
    border-bottom: 2px solid var(--color-ink);
    padding: 1.25rem 1.25rem 1.75rem;
    box-shadow: 0 24px 40px -24px rgb(27 26 23 / 0.35);
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
  }
  .panel ul {
    list-style: none;
    margin: 0.35rem 0 1.4rem;
    padding: 0;
  }
  .panel a {
    text-decoration: none;
  }
  .primary a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 560;
    border-bottom: 1px solid var(--color-line);
  }
  .primary a[aria-current='page'] {
    color: var(--color-murram);
  }
  .index a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.9rem;
    font-weight: 500;
    border-bottom: 1px dashed var(--color-line);
  }
  .index .no {
    font-family: var(--font-display);
    color: var(--color-murram);
    font-weight: 600;
    width: 1.6rem;
  }

  @media (min-width: 40rem) {
    .hide-sm {
      display: inline;
    }
  }
  @media (min-width: 56rem) {
    .mob-nav {
      display: none;
    }
    .desk-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .desk-nav ul {
      display: flex;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .desk-nav ul a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 0.8rem;
      text-decoration: none;
      font-weight: 500;
      background-image: linear-gradient(var(--color-murram), var(--color-murram));
      background-size: 0 2px;
      background-repeat: no-repeat;
      background-position: 0.8rem calc(100% - 0.6rem);
      transition: background-size 0.25s ease;
    }
    .desk-nav ul a:hover,
    .desk-nav ul a[aria-current='page'] {
      background-size: calc(100% - 1.6rem) 2px;
    }
    .desk-nav ul a[aria-current='page'] {
      color: var(--color-murram);
    }
    .call {
      min-height: 2.75rem;
      padding-block: 0.5rem;
    }
  }
</style>
