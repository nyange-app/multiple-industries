---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
import { NAV, PRIMARY_TEL, PRIMARY_TEL_DISPLAY } from '../config';
import { categories } from '../data/categories';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="on-dark sticky top-0 z-50 bg-ink text-paper">
  <!-- utility strip -->
  <div class="border-b border-ink-3">
    <div class="wrap flex h-8 items-center justify-between gap-4 text-fog">
      <p class="label truncate !text-[0.6875rem]">
        ISO 9001:2015 <span class="text-signal">/</span> UNBS certified
        <span class="hidden sm:inline"><span class="text-signal">/</span> Kampala since 1991</span>
      </p>
      <a href={`tel:${PRIMARY_TEL}`} class="label !text-[0.6875rem] hidden hover:text-paper sm:block">
        Hotline {PRIMARY_TEL_DISPLAY}
      </a>
    </div>
  </div>

  <div class="wrap relative flex h-16 items-center justify-between gap-3 lg:h-[4.5rem]">
    <a href="/" class="flex shrink-0 items-center" aria-label="Multiple Industries Ltd — home">
      <Image
        src={logo}
        alt="Multiple Industries Ltd."
        width={196}
        height={48}
        densities={[1, 2]}
        loading="eager"
        class="h-10 w-auto lg:h-12"
      />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class:list={[
              'flex h-11 items-center px-4 font-semibold uppercase tracking-wide [font-stretch:85%] hover:text-signal',
              isActive(n.href) && 'text-signal',
            ]}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
      <a href={`tel:${PRIMARY_TEL}`} class="btn btn-signal ml-3 !min-h-11">
        <Icon name="phone" class="size-5" /> Call sales
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a href={`tel:${PRIMARY_TEL}`} class="btn btn-signal !min-h-11 !px-3" aria-label={`Call ${PRIMARY_TEL_DISPLAY}`}>
        <Icon name="phone" class="size-5" /><span class="text-sm">Call</span>
      </a>
      <details class="menu">
        <summary class="flex size-11 items-center justify-center border-2 border-ink-3" aria-label="Menu">
          <Icon name="menu" class="menu-open-hide size-6" />
          <Icon name="close" class="menu-open-show size-6" />
        </summary>
        <div class="absolute inset-x-0 top-full border-t border-ink-3 bg-ink-2 pb-6 shadow-2xl">
          <nav aria-label="Mobile" class="wrap">
            <ul>
              {
                NAV.map((n) => (
                  <li class="border-b border-ink-3">
                    <a href={n.href} class="display-md flex min-h-14 items-center justify-between text-2xl">
                      {n.label} <Icon name="arrow" class="size-5 text-signal" />
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="label mt-5 text-fog">Divisions</p>
            <ul class="mt-2 grid grid-cols-2 gap-x-4">
              {
                categories.map((c) => (
                  <li>
                    <a href={`/products/${c.slug}/`} class="flex min-h-11 items-center gap-2 text-sm text-paper">
                      <span class="label text-signal">{c.code}</span> {c.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
