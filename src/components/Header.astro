---
import { Image } from 'astro:assets';
import logo from '../assets/logo-multiple-industries.png';
import { HEAD_OFFICE, NAV, SHOWROOM } from '../config';
import { categories } from '../data/categories';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.startsWith('/products') ? '/products/' : href);
const hotline = SHOWROOM.phones[1];
---

<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper">
  <!-- Utility strip -->
  <div class="on-dark bg-ink text-paper">
    <div class="wrap flex items-center justify-between gap-4">
      <p class="label hidden py-2 text-paper/80 sm:block">ISO 9001:2015 &middot; UNBS certified &middot; Kampala since 1991</p>
      <div class="flex w-full items-center justify-between gap-4 sm:w-auto sm:justify-end">
        <a href={`tel:${hotline.tel}`} class="label flex min-h-11 items-center gap-2 text-signal hover:underline">
          <span class="text-paper/80">Showroom</span>
          {hotline.display}
        </a>
        <a href={`mailto:${HEAD_OFFICE.emails[1]}`} class="label hidden min-h-11 items-center hover:underline md:flex">
          {HEAD_OFFICE.emails[1]}
        </a>
      </div>
    </div>
  </div>

  <div class="wrap relative flex items-center justify-between gap-4 py-2.5">
    <a href="/" class="block shrink-0" aria-label="Multiple Industries Ltd — home">
      <Image
        src={logo}
        alt="Multiple Industries Ltd."
        width={196}
        height={48}
        densities={[1, 2]}
        loading="eager"
        class="h-10 w-auto sm:h-12"
      />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-stretch gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="label flex min-h-11 items-center border-b-[3px] border-transparent px-3 text-[0.8rem] hover:border-ink aria-[current=page]:border-plum aria-[current=page]:text-plum"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/contact/" class="btn btn-primary hidden !min-h-11 !py-2 text-sm lg:inline-flex">Request a quote</a>

    <!-- Mobile nav: <details>, no JS -->
    <details class="menu lg:hidden">
      <summary
        class="label flex min-h-11 min-w-11 cursor-pointer items-center gap-2 border-2 border-ink px-3 text-[0.8rem] select-none"
      >
        <span class="menu-open-hide">Menu</span>
        <span class="menu-closed-hide">Close</span>
        <svg viewBox="0 0 20 20" class="size-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5">
          <path class="menu-open-hide" d="M2 5h16M2 10h16M2 15h16" />
          <path class="menu-closed-hide" d="m4 4 12 12M16 4 4 16" />
        </svg>
      </summary>
      <nav
        aria-label="Main mobile"
        class="absolute inset-x-0 top-full max-h-[calc(100dvh-7rem)] overflow-y-auto border-y-2 border-ink bg-paper shadow-[0_12px_0_rgb(23_21_26/0.12)]"
      >
        <ul class="wrap divide-y divide-line py-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="headline flex min-h-12 items-center justify-between py-3 text-2xl aria-[current=page]:text-plum"
                >
                  {item.label}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="wrap pb-5">
          <p class="label mb-2 text-ink-3">Product divisions</p>
          <ul class="grid grid-cols-2 gap-x-4">
            {
              categories.map((c) => (
                <li>
                  <a href={`/products/${c.slug}/`} class="flex min-h-11 items-center gap-2 text-sm font-semibold">
                    <span class="label text-plum">{c.no}</span>
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/contact/" class="btn btn-primary mt-4 w-full">Request a quote</a>
        </div>
      </nav>
    </details>
  </div>
</header>
