---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { NAV } from '../config';
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="flex items-center" aria-label="Multiple Industries, home">
      <Image src={logo} alt="Multiple Industries Ltd." width={140} height={34} class="h-9 w-auto rounded-md" loading="eager" />
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {NAV.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}
          class="inline-flex min-h-11 items-center rounded-full px-4 text-[0.95rem] font-medium text-muted transition hover:text-ink aria-[current=page]:text-cyan">{n.label}</a>
      ))}
      <a href="tel:+256414236021" class="btn btn-primary ml-3 !min-h-11">Call +256 414 236021</a>
    </nav>
    <details class="group relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-line [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg viewBox="0 0 24 24" class="h-6 w-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg viewBox="0 0 24 24" class="hidden h-6 w-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 top-16 border-b border-line bg-bg px-4 pb-6 pt-2">
        {NAV.map((n) => (
          <a href={n.href} class="flex min-h-12 items-center border-b border-line/60 font-display text-2xl">{n.label}</a>
        ))}
        <a href="tel:+256414236021" class="btn btn-primary mt-5 w-full">Call +256 414 236021</a>
      </nav>
    </details>
  </div>
</header>
