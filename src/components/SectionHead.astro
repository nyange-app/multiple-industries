---
interface Props { no: string; label: string; title: string; id?: string; note?: string }
const { no, label, title, id, note } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div>
    <p class="form-label flex items-center gap-2"><span class="serial text-sm">§{no}</span>{label}</p>
    <h2 id={id} class="mt-1 text-3xl sm:text-4xl">{title}</h2>
  </div>
  {note && <p class="hand -rotate-2 text-2xl text-stamp">{note}</p>}
</div>
