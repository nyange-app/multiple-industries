---
/** Numbered datasheet-style section heading. */
interface Props {
  code: string;
  label: string;
  title: string;
  id?: string;
  dark?: boolean;
  level?: 'h1' | 'h2';
}
const { code, label, title, id, dark = false, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class:list={['border-t-2 pt-3', dark ? 'border-paper' : 'border-ink']}>
  <p class:list={['label flex justify-between gap-4', dark ? 'text-fog' : 'text-steel']}>
    <span><span class={dark ? 'text-signal' : 'text-plate'}>§ {code}</span>&ensp;{label}</span>
    <span aria-hidden="true" class="hidden sm:inline">Multiple Industries Ltd.</span>
  </p>
  <Tag id={id} class="display mt-5 text-4xl text-balance sm:text-5xl lg:text-6xl">{title}</Tag>
  <slot />
</div>
