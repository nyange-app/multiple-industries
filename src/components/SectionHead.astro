---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  class?: string;
}
const { eyebrow, title, id, class: cls = '' } = Astro.props;
---

<header class:list={['max-w-2xl', cls]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-[2.6rem] md:text-6xl">{title}<slot /></h2>
  <span class="rule" aria-hidden="true"></span>
</header>
