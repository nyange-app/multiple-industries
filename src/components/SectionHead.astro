---
/** Numbered section heading: "§ 02 — Catalogue" label over a condensed h2. */
interface Props {
  no: string;
  label: string;
  title: string;
  id?: string;
  dark?: boolean;
  class?: string;
}
const { no, label, title, id, dark = false, class: cls = '' } = Astro.props;
---

<div class:list={['flex flex-col gap-3', cls]}>
  <p class:list={['label flex items-center gap-3', dark ? 'text-fog' : 'text-steel']}>
    <span class:list={['px-1.5 py-0.5', dark ? 'bg-signal text-ink' : 'bg-ink text-paper']}>§{no}</span>
    {label}
    <span class:list={['h-px flex-1', dark ? 'bg-ink-3' : 'bg-line']} aria-hidden="true"></span>
  </p>
  <h2 id={id} class="display text-4xl sm:text-5xl lg:text-6xl">
    <Fragment set:html={title} />
  </h2>
</div>
