---
import Icon from './Icon.astro';
---
<section class="section pt-0">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[2rem] bg-brand-600 px-6 py-12 text-white sm:px-14 sm:py-16">
      <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-white/10" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 right-24 h-56 w-56 rounded-full bg-teal-500/30" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Planning a build or a bulk order?</h2>
        <p class="mt-4 text-base leading-relaxed text-brand-100 sm:text-lg">Talk to our sales team or visit the showroom in Kampala's 8th Street Industrial Area.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="tel:+256752914900" class="btn bg-white text-brand-700 hover:bg-brand-50"><Icon name="phone" class="h-4 w-4" />Call 0752 914 900</a>
          <a href="mailto:sales@multipleindustries.com" class="btn border border-white/40 text-white hover:bg-white/10"><Icon name="mail" class="h-4 w-4" />Email sales</a>
        </div>
      </div>
    </div>
  </div>
</section>
