---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, LEGAL_NAME } from '../config';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail (excluding Home); emits BreadcrumbList JSON-LD. */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, jsonLd = [], breadcrumbs, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} | Quality Building Materials You Can Trust Since 1991`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;

const ld: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs && breadcrumbs.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, SITE_URL).href,
    })),
  });
}
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f3f5f2" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={LEGAL_NAME} />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Multiple Industries: quality building materials you can trust since 1991" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-dvh antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
