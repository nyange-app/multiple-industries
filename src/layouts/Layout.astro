---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import { CONTACT, NAV, SITE_LEGAL_NAME, SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config';
import { categories } from '../data/categories';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, crumbs, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const path = Astro.url.pathname;

const ld = [...jsonLd];
if (crumbs && crumbs.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, SITE_URL).href,
    })),
  });
}
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#d7ecf4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_LEGAL_NAME} />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Illustration of a house cut open to show Multiple Industries products from roof to tap" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-sun focus:px-5 focus:py-3 focus:font-semibold focus:text-ink"
      >Skip to content</a
    >

    <header class="sticky top-0 z-40 border-b-2 border-ink bg-sky/95 backdrop-blur">
      <div class="wrap flex h-16 items-center justify-between gap-3 md:h-20">
        <a href="/" class="flex min-h-11 items-center rounded-lg" aria-label={`${SITE_LEGAL_NAME}, home`}>
          <Image src={logo} alt="" class="h-9 w-auto rounded-md md:h-11" loading="eager" />
        </a>

        <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
          {
            NAV.map((n) => (
              <a
                href={n.href}
                aria-current={isCurrent(n.href) ? 'page' : undefined}
                class="font-display rounded-full px-4 py-2.5 font-semibold text-ink hover:bg-white aria-[current=page]:bg-white aria-[current=page]:shadow-[inset_0_0_0_2px_var(--color-ink)]"
              >
                {n.label}
              </a>
            ))
          }
          <a href={CONTACT.hotline.href} class="btn btn-sun ml-2">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2z"></path></svg>
            {CONTACT.hotline.label}
          </a>
        </nav>

        <div class="flex items-center gap-2 md:hidden">
          <a href={CONTACT.hotline.href} class="btn btn-sun !px-3.5" aria-label={`Call ${CONTACT.hotline.label}`}>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2z"></path></svg>
            <span class="text-sm">Call</span>
          </a>
          <details class="menu relative">
            <summary class="btn btn-ghost !px-3.5 cursor-pointer" aria-label="Menu">
              <svg class="icon-open" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
              <svg class="icon-close" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
              <span class="text-sm">Menu</span>
            </summary>
            <nav aria-label="Mobile" class="card absolute right-0 top-[calc(100%+.75rem)] w-[min(20rem,calc(100vw-2rem))] p-3">
              <ul class="grid gap-1">
                {
                  NAV.map((n) => (
                    <li>
                      <a href={n.href} class="font-display flex min-h-12 items-center rounded-xl px-3 text-lg font-semibold hover:bg-sky">
                        {n.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
              <p class="font-display mt-3 border-t border-line px-3 pt-3 text-xs font-semibold uppercase tracking-widest text-muted">Around the house</p>
              <ul class="mt-1 grid gap-0.5">
                {
                  categories.map((c) => (
                    <li>
                      <a href={`/products/${c.slug}/`} class="flex min-h-11 items-center gap-3 rounded-xl px-3 hover:bg-sky">
                        <span class="font-display grid h-7 w-7 place-items-center rounded-full border-2 border-ink bg-sun text-sm font-extrabold">{c.n}</span>
                        <span class="leading-tight">{c.name}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="mt-20 bg-leaf text-white">
      <div class="groundline" style="background-color: var(--color-day);" aria-hidden="true"></div>
      <div class="wrap grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1fr_1fr]">
        <div>
          <p class="font-display text-2xl font-bold">{SITE_LEGAL_NAME}</p>
          <p class="mt-2 text-white/85">{SITE_TAGLINE}.</p>
          <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-sm">ISO 9001:2015 certified · UNBS certified products</p>
        </div>
        <div>
          <h2 class="font-display text-sm font-semibold uppercase tracking-widest text-sun">Around the house</h2>
          <ul class="mt-3 grid gap-1">
            {categories.map((c) => (
              <li><a class="inline-flex min-h-10 items-center hover:text-sun hover:underline" href={`/products/${c.slug}/`}>{c.n}. {c.name}</a></li>
            ))}
          </ul>
        </div>
        {[CONTACT.headOffice, CONTACT.showroom].map((o) => (
          <div>
            <h2 class="font-display text-sm font-semibold uppercase tracking-widest text-sun">{o.label}</h2>
            <address class="mt-3 not-italic text-white/90">
              {o.street}<br />
              {'pobox' in o && o.pobox ? <>{o.pobox}<br /></> : null}
              {o.city}, {o.country}
            </address>
            <ul class="mt-2 grid">
              {o.phones.map((ph) => <li><a class="inline-flex min-h-10 items-center hover:text-sun hover:underline" href={ph.href}>{ph.label}</a></li>)}
              {o.emails.map((e) => <li><a class="inline-flex min-h-10 items-center break-all hover:text-sun hover:underline" href={`mailto:${e}`}>{e}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="border-t border-white/15">
        <div class="wrap flex flex-col gap-2 py-5 text-sm text-white/80 sm:flex-row sm:justify-between">
          <p>© 2026 {SITE_LEGAL_NAME}</p>
          <p><a href="/about/" class="hover:underline">About</a> · <a href="/contact/" class="hover:underline">Contact</a> · <a href="/sitemap-index.xml" class="hover:underline">Sitemap</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
