---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo-multiple-industries.png';
import { SITE_NAME, SITE_LEGAL_NAME, SITE_URL, SITE_DESCRIPTION, SITE_TAGLINE } from '../config';
import { nav, contact } from '../data/site';
import { categories } from '../data/categories';

interface Crumb { name: string; href: string }
interface Props {
  title?: string;
  description?: string;
  crumbs?: Crumb[];
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, crumbs = [], jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} | ${SITE_TAGLINE}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : path, SITE_URL).href;
const ogImage = new URL('/og.svg', SITE_URL).href;

const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, SITE_URL).href,
      })),
    }
  : null;
const graphs = [...jsonLd, ...(breadcrumb ? [breadcrumb] : [])];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_LEGAL_NAME} />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  </head>
  <body class="min-h-dvh antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-paper">Skip to content</a>

    <header class="relative z-20 border-b border-ink bg-paper">
      <div class="wrap flex items-center justify-between gap-4 py-3">
        <a href="/" class="flex items-center gap-3" aria-label="Multiple Industries, home">
          <Image src={logo} alt="Multiple Industries Ltd." width={160} height={39} class="h-9 w-auto md:h-10" loading="eager" />
        </a>
        <nav aria-label="Primary" class="hidden md:block">
          <ul class="flex items-center gap-8 text-sm font-medium">
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
                   class:list={['inline-flex min-h-11 items-center border-b-2 border-transparent hover:border-clay', isActive(n.href) && 'border-clay']}>{n.label}</a>
              </li>
            ))}
            <li><a href="/contact#enquire" class="btn btn-clay !min-h-11 !px-4">Enquire</a></li>
          </ul>
        </nav>
        <details class="group md:hidden">
          <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 border border-ink px-3 text-xs font-semibold uppercase tracking-widest [&::-webkit-details-marker]:hidden" aria-label="Menu">
            <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
          </summary>
          <nav aria-label="Mobile" class="absolute inset-x-0 top-full border-b border-ink bg-paper shadow-[0_20px_30px_-20px_rgba(27,24,20,.4)]">
            <ul class="wrap py-2">
              {nav.map((n, i) => (
                <li class="border-t border-rule first:border-t-0">
                  <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class="flex min-h-14 items-baseline gap-4 py-3 font-serif text-3xl">
                    <span class="numeral text-base">{String(i + 1).padStart(2, '0')}</span>{n.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="on-ink bg-ink text-paper">
      <div class="wrap grid gap-12 py-16 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="eyebrow">Since 1991</p>
          <p class="mt-3 font-serif text-3xl leading-tight md:text-4xl">{SITE_TAGLINE}.</p>
          <p class="mt-6 max-w-sm text-sm text-paper/70">Manufacturer and supplier of plastic pipes, household plastics, building materials, automotive parts and irrigation systems, Kampala, Uganda.</p>
        </div>
        <nav aria-label="Footer products" class="md:col-span-3">
          <p class="eyebrow">Index</p>
          <ul class="mt-4 text-sm">
            {categories.map((c) => (
              <li class="border-t border-ink-rule"><a href={`/products/${c.slug}`} class="flex min-h-11 items-center gap-3 hover:text-[#f0b9a2]"><span class="numeral text-[#f0b9a2]">{c.no}</span>{c.title}</a></li>
            ))}
          </ul>
        </nav>
        <div class="text-sm md:col-span-4">
          <p class="eyebrow">Head office & factory</p>
          <address class="mt-4 not-italic leading-relaxed text-paper/80">
            {contact.head.address.map((l) => <span class="block">{l}</span>)}
          </address>
          <p class="mt-4 space-y-1">
            <a class="link-u flex min-h-11 items-center" href={`tel:${contact.head.phones[0].href}`}>{contact.head.phones[0].display}</a>
            <a class="link-u flex min-h-11 items-center break-all" href="mailto:response@multipleindustries.com">response@multipleindustries.com</a>
          </p>
        </div>
      </div>
      <div class="border-t border-ink-rule">
        <div class="wrap flex flex-col gap-2 py-5 text-xs text-paper/70 sm:flex-row sm:justify-between">
          <p>&copy; 2026 Multiple Industries Limited</p>
          <p>ISO 9001:2015 certified &middot; Products certified by UNBS</p>
        </div>
      </div>
    </footer>
  </body>
</html>
