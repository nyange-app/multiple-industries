---
import Layout from '../layouts/Layout.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
---

<Layout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="grid-paper border-b-2 border-ink">
    <div class="wrap py-16 md:py-24">
      <p class="label mb-4 text-plum">Error 404 &middot; Sheet missing</p>
      <h1 class="display text-7xl sm:text-8xl">This sheet isn't in the catalogue</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-2">The page may have moved during our website update. Try a product division below or head home.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/contact/" class="btn btn-ghost bg-sheet">Contact us</a>
      </div>
    </div>
  </section>
  <section class="wrap py-12" aria-label="Product divisions">
    <CategoryIndex headingLevel="h2" />
  </section>
</Layout>
