---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Multiple Industries" description="This page could not be found." noindex>
  <section class="wrap grid items-center gap-10 pt-12 md:grid-cols-2 md:pt-20">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-4 text-6xl md:text-8xl">This plinth is <em class="text-brass">empty.</em></h1>
      <p class="mt-6 max-w-md text-lg text-porcelain-dim">The page you were looking for has moved or never existed. The rest of the showroom is still open.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-brass">Back to the home page</a>
        <a href="/#collection" class="btn btn-ghost">See the collection</a>
      </div>
    </div>
    <div class="stage on aspect-square flex flex-col justify-end" aria-hidden="true"><div class="plinth"></div></div>
  </section>
</Layout>
