---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="wrap py-24 md:py-36">
    <p class="numeral text-[8rem] leading-none md:text-[14rem]">404</p>
    <h1 class="mt-4 text-4xl md:text-6xl">This page is not in the catalogue.</h1>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-clay">Back home</a>
      <a href="/products" class="btn">Browse products</a>
    </div>
  </section>
</Layout>
