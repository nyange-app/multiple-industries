---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/categories';
---

<Layout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="on-dark grid-blueprint text-paper" aria-labelledby="page-title">
    <div class="wrap py-16 lg:py-24">
      <p class="label text-signal">Error 404 · Line not found</p>
      <h1 id="page-title" class="display mt-4 text-7xl sm:text-8xl lg:text-9xl">This pipe<br />leads nowhere</h1>
      <p class="mt-6 max-w-xl text-lg text-fog">The page may have moved during our website update. Try a division below or head home.</p>
      <a href="/" class="btn btn-signal mt-8">Back to home <Icon name="arrow" class="size-5" /></a>
    </div>
  </section>
  <div class="hazard" aria-hidden="true"></div>
  <nav class="wrap py-14" aria-label="Product divisions">
    <ul class="grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <li class="bg-paper">
            <a href={`/products/${c.slug}/`} class="flex min-h-16 items-center gap-4 p-5 hover:bg-signal">
              <span class="label text-steel">{c.code}</span>
              <span class="display-md flex-1 text-xl">{c.name}</span>
              <Icon name="arrow" class="size-5" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Layout>
