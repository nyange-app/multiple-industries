---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../data/categories';
---
<Layout title="Page not found" description="This page could not be found." noindex>
  <section class="wrap pt-10" aria-labelledby="nf-title">
    <div class="panel pellets ejector p-6 pt-10 text-center sm:p-14">
      <p class="deboss font-display text-[6rem] font-extrabold leading-none sm:text-[9rem]" aria-hidden="true">404</p>
      <h1 id="nf-title" class="mt-2 text-3xl sm:text-4xl">This part didn't come out of the mould</h1>
      <p class="mx-auto mt-3 max-w-lg text-muted">The page you were looking for has moved or never existed. Try one of our product lines instead.</p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-cta">Go to home <Icon name="arrow" /></a>
        <a href="/products/" class="btn">All products</a>
      </div>
      <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-2">
        {
          CATEGORIES.map((c) => (
            <li>
              <a href={`/products/${c.slug}/`} class="cavity inline-flex min-h-11 items-center rounded-full px-4 text-sm font-semibold no-underline hover:text-ppr-deep">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
