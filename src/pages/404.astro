---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Multiple Industries Ltd" description="The page you are looking for could not be found.">
  <section class="relative isolate overflow-hidden">
    <div class="bg-blueprint absolute inset-0 -z-10"></div>
    <div class="container-x py-28 text-center">
      <p class="font-display text-8xl font-semibold text-gradient sm:text-9xl">404</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-muted">The page you are looking for has moved or does not exist.</p>
      <a href="/" class="btn btn-primary mt-8">Back to home</a>
    </div>
  </section>
</Layout>
