---
import Layout from '../layouts/Layout.astro';
import PipeEnd from '../components/PipeEnd.astro';
---
<Layout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="relative isolate overflow-hidden bg-navy-950 text-white grid-lines">
    <PipeEnd class="absolute -right-20 top-1/2 -z-10 h-96 w-96 opacity-25 md:opacity-100 -translate-y-1/2 text-white/15" />
    <div class="container-x py-20 md:py-32">
      <p class="display text-[9rem] leading-none text-signal md:text-[16rem]" aria-hidden="true">404</p>
      <h1 class="display text-5xl md:text-7xl">Pipe ends here</h1>
      <p class="mt-4 max-w-xl text-lg text-white/85">That page does not exist or has moved.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-signal">Back home</a>
        <a href="/products" class="btn btn-outline">Browse products</a>
      </div>
    </div>
    <div class="hazard-bar" aria-hidden="true"></div>
  </section>
</Layout>
