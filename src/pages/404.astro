---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <section class="section"><div class="container-x text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="text-4xl font-extrabold sm:text-5xl">We could not find that page</h1>
    <p class="lead mx-auto">The page may have moved. Try the home page or browse our products.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn btn-primary">Home</a><a href="/products" class="btn btn-ghost">Products</a></div>
  </div></section>
</Layout>
