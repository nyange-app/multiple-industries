---
import Layout from '../layouts/Layout.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import { categories } from '../data/categories';
---

<Layout title="Page not found" description="This page could not be found." noindex>
  <section class="wrap nf">
    <p class="folio" aria-hidden="true">404</p>
    <p class="kicker">Page not found</p>
    <h1 class="display-lg">This road <em class="wonk">doesn't go through.</em></h1>
    <p class="lede">The page may have moved when we rebuilt the site. Try the index below, or head back home.</p>
    <p class="actions">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn btn-ghost" href="/contact/">Contact us</a>
    </p>
    <CategoryIndex items={categories} headingLevel="h2" />
  </section>
</Layout>

<style>
  .nf {
    padding-top: 2.5rem;
  }
  .folio {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: clamp(6rem, 30vw, 14rem);
    line-height: 0.8;
    color: var(--color-clay);
    -webkit-text-stroke: 2px var(--color-murram-bright);
  }
  .nf h1 {
    margin: 0.75rem 0 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 3rem;
  }
</style>
