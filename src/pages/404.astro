---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="grid-paper">
    <div class="wrap py-20 md:py-28">
      <p class="label text-plate">Error 404 · Part not in catalogue</p>
      <h1 class="display mt-5 text-6xl sm:text-8xl">Page not found</h1>
      <p class="mt-5 max-w-lg text-lg text-steel">This page may have moved when we rebuilt the site. Try the product catalogue or contact our sales desk.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/products/" class="btn btn-ink">Browse products <Icon name="arrow" class="size-5" /></a>
        <a href="/contact/" class="btn btn-line">Contact us</a>
      </div>
    </div>
  </section>
</Layout>
