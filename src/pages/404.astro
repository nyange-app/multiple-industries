---
import Layout from '../layouts/Layout.astro';
import Blob from '../components/Blob.astro';
import CatIcon from '../components/CatIcon.astro';
---
<Layout title="Page not found" description="This page could not be found." noindex>
  <section class="relative mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center overflow-hidden px-4 py-16 text-center">
    <Blob variant={3} class="pointer-events-none absolute -z-10 h-96 w-96 text-plastic-tint" />
    <p class="text-8xl font-black text-plastic">404</p>
    <h1 class="mt-2 text-3xl font-black sm:text-4xl">Oops, we can't find that page</h1>
    <p class="mt-3 text-lg text-ink-soft">It may have moved. Try our home page or product ranges.</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Back home <CatIcon name="arrow" class="h-5 w-5" /></a>
      <a href="/products/water-management" class="btn btn-light">Browse products</a>
    </div>
  </section>
</Layout>
