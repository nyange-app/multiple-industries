---
import Layout from '../layouts/Layout.astro';
import Crumbs from '../components/Crumbs.astro';
import { OFFICES, EMAIL_SALES, HOTLINES, mailto, whatsapp } from '../config';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const papers = ['paper-white', 'paper-canary'];
---

<Layout
  title="Contact & showroom"
  description="Contact Multiple Industries in Kampala: Head Office & Factory at Plot 714/715 and Sales Office & Showroom at Plot 13/23, 8th Street Industrial Area. Hotline +256 414 236021/2."
  crumbs={crumbs}
>
  <div class="wrap pt-4 sm:pt-6">
    <Crumbs items={crumbs} />
    <header class="mt-4 max-w-3xl">
      <p class="form-label"><span class="serial text-sm">§00</span> Contact</p>
      <h1 class="mt-1 text-4xl sm:text-5xl">Find the counter</h1>
      <p class="mt-4 text-lg">Two offices on 8th Street, Industrial Area, Kampala. Call, email or WhatsApp, or bring your list to the showroom.</p>
    </header>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {OFFICES.map((o, i) => (
        <section class="drop" aria-labelledby={`${o.id}-h`}>
          <div class={`slip ${papers[i]} tear perf smudge px-5 pt-6 sm:px-8`}>
            <div class="form-head">
              <p class="form-label">Copy {i + 1} of 2</p>
              <p class="serial text-sm">{i === 0 ? 'Plot 714/715' : 'Plot 13/23'}</p>
            </div>
            <h2 id={`${o.id}-h`} class="mt-4 text-2xl sm:text-3xl">{o.name}</h2>
            <address class="not-italic">
              <dl class="mt-2">
                <div class="field"><dt>Address</dt><dd>{o.street}, {o.box}, {o.city}, Uganda</dd></div>
                <div class="field"><dt>Phone</dt><dd>{o.phoneLabel}</dd></div>
                <div class="field"><dt>Email</dt><dd class="break-all">{o.emails.join(', ')}</dd></div>
              </dl>
            </address>
            <div class="mt-5 flex flex-wrap gap-2">
              {o.phones.slice(0, i === 0 ? 2 : 3).map((p) => <a class="btn btn-primary !min-h-11 text-sm" href={`tel:${p.tel}`}>Call {p.label}</a>)}
              {o.emails.map((e) => <a class="btn btn-ghost !min-h-11 text-sm break-all" href={`mailto:${e}`}>{e}</a>)}
              <a class="btn btn-ghost !min-h-11 text-sm" href={o.map} rel="noopener">Directions<span class="sr-only"> to the {o.name}</span></a>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Enquiry slip form: mailto, works without JS; JS prefills with ticked items -->
    <section class="mt-16 grid gap-8 lg:grid-cols-[1.3fr_1fr]" aria-labelledby="slip-title">
      <div class="relative">
        <div aria-hidden="true" class="slip paper-pink absolute inset-0 translate-x-2 translate-y-2.5 rotate-[0.9deg]"></div>
        <form class="slip perf smudge relative px-5 pb-7 pt-7 sm:px-8" action={`mailto:${EMAIL_SALES}`} method="get" enctype="text/plain">
          <div class="form-head">
            <h2 id="slip-title" class="form-label !text-carbon">Enquiry / quotation slip</h2>
            <p class="serial text-sm">To: Sales</p>
          </div>
          <input type="hidden" name="subject" value="Quotation request (website)" />
          <ul data-slip-list hidden class="typed mt-4 grid gap-1 border-l-4 border-canary-deep bg-canary/40 px-3 py-2 text-sm" aria-label="Items on your slip"></ul>
          <label for="slip-body" class="form-label mt-5 block">Items, quantities, your name and location</label>
          <textarea id="slip-body" name="body" data-slip-body rows="9" class="ruled typed mt-2 block w-full resize-y border-2 border-carbon/40 bg-transparent px-3 py-[0.45rem] text-base leading-8" placeholder={'e.g.\nUPVC pressure pipes x 20\nPP-R fittings x 50\n\nName:\nPhone:\nDelivery location:'}></textarea>
          <div class="mt-5 flex flex-wrap gap-3">
            <button type="submit" class="btn btn-stamp">Send by email</button>
            <a data-slip-wa href={whatsapp('Hello Multiple Industries, I would like a quotation.')} class="btn btn-primary" rel="noopener">Send by WhatsApp</a>
          </div>
          <p class="mt-4 text-sm text-muted">This opens your own email or WhatsApp app. Nothing is stored on this website.</p>
        </form>
      </div>
      <aside class="drop self-start" aria-label="Hotlines">
        <div class="slip paper-canary tear px-5 pt-6 sm:px-7">
          <h2 class="form-label">Quick lines</h2>
          <p class="hand mt-2 text-3xl leading-tight text-carbon">Fastest: call the showroom hotline.</p>
          <ul class="mt-3 grid gap-2">
            {HOTLINES.map((h) => <li><a class="btn btn-ghost w-full" href={`tel:${h.tel}`}>{h.label}</a></li>)}
            <li><a class="btn btn-ghost w-full break-all" href={mailto(EMAIL_SALES, 'Quotation request')}>{EMAIL_SALES}</a></li>
          </ul>
        </div>
      </aside>
    </section>
  </div>
</Layout>
