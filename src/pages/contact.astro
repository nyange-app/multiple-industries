---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/site';
const offices = [contact.head, contact.showroom];
---
<Layout title="Contact Us" description="Contact Multiple Industries Limited: head office and factory, and sales office and showroom, 8th Street Industrial Area, Kampala, Uganda." crumbs={[{ name: 'Contact', href: '/contact' }]}>
  <section class="border-b border-ink">
    <div class="wrap py-12 md:py-20">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-5xl md:text-8xl">Write, call or visit.</h1>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="wrap grid md:grid-cols-2">
      {offices.map((o, i) => (
        <article class:list={['py-12 md:py-16', i === 0 && 'border-b border-rule md:border-b-0 md:border-r md:pr-12', i === 1 && 'md:pl-12']}>
          <p class="numeral text-2xl">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="mt-2 text-3xl md:text-4xl">{o.label}</h2>
          <address class="mt-5 not-italic leading-relaxed text-ink-soft">
            {o.address.map((l) => <span class="block">{l}</span>)}
          </address>
          <ul class="mt-5">
            {o.phones.map((p) => (
              <li class="index-row"><a href={`tel:${p.href}`} class="flex min-h-12 items-center justify-between gap-4"><span class="text-xs uppercase tracking-widest text-ink-soft">{p.label}</span><span class="font-serif text-xl">{p.display}</span></a></li>
            ))}
            {o.emails.map((e) => (
              <li class="index-row"><a href={`mailto:${e}`} class="flex min-h-12 items-center justify-between gap-4"><span class="text-xs uppercase tracking-widest text-ink-soft">Email</span><span class="break-all text-right text-sm underline decoration-clay underline-offset-4 sm:text-base">{e}</span></a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="enquire" class="scroll-mt-4">
    <div class="wrap grid gap-8 py-14 md:grid-cols-12 md:py-20">
      <div class="md:col-span-4">
        <p class="eyebrow">Enquiry</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Send an enquiry</h2>
        <p class="mt-4 text-sm text-ink-soft">Opens your email app with the message addressed to sales. No data is stored on this site.</p>
      </div>
      <form action="mailto:sales@multipleindustries.com" method="post" enctype="text/plain" class="grid gap-5 md:col-span-7 md:col-start-6">
        {[['name', 'Your name', 'text'], ['email', 'Your email', 'email'], ['phone', 'Phone (optional)', 'tel']].map(([id, l, t]) => (
          <label class="block text-xs font-semibold uppercase tracking-widest text-ink-soft">{l}
            <input id={id} name={id} type={t as 'text'} required={id !== 'phone'} class="mt-2 block min-h-12 w-full border-0 border-b border-ink bg-transparent px-0 py-2 font-sans text-base normal-case tracking-normal text-ink focus:border-clay focus:outline-none focus-visible:ring-0 focus:border-b-2" />
          </label>
        ))}
        <label class="block text-xs font-semibold uppercase tracking-widest text-ink-soft">Message
          <textarea name="message" rows="5" required class="mt-2 block w-full border-0 border-b border-ink bg-transparent px-0 py-2 font-sans text-base normal-case tracking-normal text-ink focus:border-clay focus:outline-none focus:border-b-2"></textarea>
        </label>
        <div><button type="submit" class="btn btn-clay cursor-pointer">Compose email</button></div>
      </form>
    </div>
  </section>
</Layout>
