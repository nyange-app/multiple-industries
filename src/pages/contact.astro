---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Strata from '../components/Strata.astro';
import { OFFICES } from '../config';
import { categories } from '../data/categories';
import { breadcrumbLd, localBusinessLd } from '../lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---

<Layout
  title="Contact"
  description="Contact Multiple Industries: Head Office & Factory at Plot 714/715 and Sales Office & Showroom at Plot 13/23, 8th Street Industrial Area, Kampala. Hotline +256 414 236021/2."
  jsonLd={[breadcrumbLd(crumbs), ...localBusinessLd()]}
>
  <section class="wrap head">
    <Breadcrumbs items={crumbs} />
    <p class="kicker">Contact</p>
    <h1 class="display-xl">Two doors on <em class="wonk">8th Street.</em></h1>
    <p class="lede">
      Both our offices are in the Industrial Area, Kampala. Call ahead and we will have your quote ready.
    </p>
  </section>

  <Strata from="var(--color-parchment)" to="var(--color-paper)" variant={1} />

  <section class="paper" aria-label="Our offices">
    <div class="wrap offices">
      {
        OFFICES.map((o, i) => (
          <article class="office" aria-labelledby={`o-${o.id}`}>
            <p class="o-no" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h2 id={`o-${o.id}`} class="display-md">
              {o.name}
            </h2>
            <address>
              {o.street}
              <br />
              {o.po && (
                <>
                  {o.po}
                  <br />
                </>
              )}
              {o.city}, Uganda
            </address>
            <h3 class="kicker">Phone</h3>
            <ul>
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`}>{p.label}</a>
                </li>
              ))}
            </ul>
            <h3 class="kicker">Email</h3>
            <ul>
              {o.emails.map((e) => (
                <li>
                  <a href={`mailto:${e}`}>{e}</a>
                </li>
              ))}
            </ul>
            <a class="btn btn-ghost map" href={maps(`${o.street}, Kampala, Uganda`)} rel="noopener">
              Open in Maps
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="form-title">
    <div class="wrap form-wrap">
      <div>
        <p class="kicker">Write to us</p>
        <h2 id="form-title" class="display-md">Send an enquiry</h2>
        <p class="lede">
          This form opens your email app with the message ready to send to sales@multipleindustries.com.
        </p>
      </div>
      <form action="mailto:sales@multipleindustries.com" method="post" enctype="text/plain" class="form">
        <label>
          <span>Your name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Phone</span>
          <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </label>
        <label>
          <span>Department</span>
          <select name="department">
            {categories.map((c) => <option>{c.name}</option>)}
            <option>Other</option>
          </select>
        </label>
        <label class="full">
          <span>Message</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Open email to send</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .head {
    padding-top: 0.75rem;
    padding-bottom: 2rem;
  }
  .head h1 {
    margin: 0.75rem 0 1.25rem;
    max-width: 12ch;
  }
  .paper {
    background: var(--color-paper);
  }
  .offices {
    display: grid;
    gap: 2.5rem;
    padding-block: 2rem 3rem;
  }
  .office {
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
  }
  .o-no {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 3rem;
    line-height: 1;
    color: var(--color-murram);
  }
  .office h2 {
    margin-top: 0.5rem;
  }
  address {
    font-style: normal;
    font-size: 1.1rem;
    margin: 0.75rem 0 1.25rem;
  }
  .office ul {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 1rem;
  }
  .office li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-murram);
    overflow-wrap: anywhere;
  }
  .map {
    margin-top: 0.5rem;
  }
  .form-wrap {
    display: grid;
    gap: 1.5rem;
    padding-block: 3rem 1rem;
  }
  .form-wrap h2 {
    margin: 0.5rem 0 1rem;
  }
  .form {
    display: grid;
    gap: 1rem;
  }
  .form label {
    display: grid;
    gap: 0.35rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .form input,
  .form select,
  .form textarea {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    min-height: 3rem;
    padding: 0.6rem 0.75rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .form button {
    justify-self: start;
    cursor: pointer;
  }
  @media (min-width: 48rem) {
    .offices {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .form {
      grid-template-columns: 1fr 1fr;
    }
    .form .full {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .form-wrap {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
    }
  }
</style>
