---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { HEAD_OFFICE, SHOWROOM } from '../config';
import { categories } from '../data/categories';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Visit & Contact', href: '/contact/' },
];
const offices = [
  { ...SHOWROOM, po: undefined, lead: 'See kitchen, bathroom, plumbing and building ranges in person, and talk to the sales team.', maps: 'https://www.google.com/maps/search/?api=1&query=Plot+13%2F23+8th+Street+Industrial+Area+Kampala' },
  { ...HEAD_OFFICE, lead: 'Our factory and head office, for orders, trade accounts and general enquiries.', maps: 'https://www.google.com/maps/search/?api=1&query=Plot+714%2F715+8th+Street+Industrial+Area+Kampala' },
];
const field = 'mt-2 block w-full min-h-12 border border-graphite-2 bg-charcoal px-4 py-3 text-porcelain placeholder:text-steel/80 focus:border-brass focus:outline-none';
---

<Layout
  title="Visit & Contact | Multiple Industries, 8th Street Industrial Area, Kampala"
  description="Visit the Multiple Industries sales office and showroom at Plot 13/23, 8th Street Industrial Area, Kampala, or call +256 414 236021/2. Head office and factory at Plot 714/715."
  breadcrumbs={crumbs}
>
  <section class="wrap pt-4 md:pt-6" aria-labelledby="contact-h1">
    <Breadcrumbs items={crumbs} />
    <div class="max-w-3xl pt-6 md:pt-10">
      <p class="eyebrow">Visit & contact</p>
      <h1 id="contact-h1" class="mt-4 text-[3.2rem] leading-[0.98] sm:text-7xl lg:text-8xl">
        Two doors on <em class="text-brass">8th Street.</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-porcelain-dim">
        Call, email or walk in. Both offices are in Kampala's Industrial Area.
      </p>
    </div>
  </section>

  <section class="wrap mt-12 grid gap-5 md:grid-cols-2" aria-label="Our offices">
    {
      offices.map((o) => (
        <article class="is-lit flex flex-col border border-graphite-2 bg-graphite">
          <div class="stage on h-24" aria-hidden="true" />
          <div class="flex flex-1 flex-col p-6 md:p-8">
            <h2 class="text-4xl">{o.label}</h2>
            <p class="mt-3 text-steel">{o.lead}</p>
            <address class="mt-6 not-italic leading-relaxed text-porcelain-dim">
              {o.street}<br />
              {o.po && (<>{o.po}<br /></>)}
              {o.city}, {o.country}
            </address>
            <ul class="mt-6 divide-y divide-graphite-2 border-y border-graphite-2">
              {o.phones.map((p) => (
                <li class="flex min-h-12 items-center justify-between gap-4">
                  <span class="text-sm text-steel">{p.label}</span>
                  <a href={`tel:${p.tel}`} class="link-brass inline-flex min-h-11 items-center font-semibold">{p.display}</a>
                </li>
              ))}
              {o.emails.map((e) => (
                <li class="flex flex-col items-start pt-3">
                  <span class="text-sm text-steel">Email</span>
                  <a href={`mailto:${e}`} class="link-brass inline-flex min-h-11 items-center font-semibold break-all">{e}</a>
                </li>
              ))}
            </ul>
            <a href={o.maps} class="btn btn-ghost mt-6 self-start" rel="noopener" target="_blank">Get directions<span class="sr-only"> to the {o.label} (opens Google Maps)</span></a>
          </div>
        </article>
      ))
    }
  </section>

  <section class="wrap mt-20 grid gap-10 md:grid-cols-12" aria-labelledby="form-title">
    <div class="md:col-span-4">
      <p class="eyebrow">Send an enquiry</p>
      <h2 id="form-title" class="mt-3 text-4xl md:text-5xl">Ask for a quote</h2>
      <span class="rule" aria-hidden="true"></span>
      <p class="mt-5 text-steel">
        This form opens your email app with your message addressed to
        <a href={`mailto:${HEAD_OFFICE.emails[1]}`} class="link-brass">{HEAD_OFFICE.emails[1]}</a>. Nothing is sent from this site.
      </p>
    </div>
    <!-- TODO: connect a form service if a server-side form is wanted. -->
    <form class="grid gap-5 border border-graphite-2 bg-graphite p-6 md:col-span-8 md:grid-cols-2 md:p-8" action={`mailto:${HEAD_OFFICE.emails[1]}`} method="post" enctype="text/plain">
      <label class="text-sm font-semibold text-porcelain-dim">Your name
        <input name="name" autocomplete="name" required class={field} />
      </label>
      <label class="text-sm font-semibold text-porcelain-dim">Phone
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" class={field} />
      </label>
      <label class="text-sm font-semibold text-porcelain-dim md:col-span-2">I'm interested in
        <select name="interest" class={field}>
          {categories.map((c) => <option>{c.name}</option>)}
          <option>Transport & logistics</option>
          <option>Something else</option>
        </select>
      </label>
      <label class="text-sm font-semibold text-porcelain-dim md:col-span-2">Message
        <textarea name="message" rows="5" required class={field} placeholder="Products, sizes, quantities, delivery location"></textarea>
      </label>
      <div class="md:col-span-2">
        <button type="submit" class="btn btn-brass w-full sm:w-auto">Open in my email app</button>
      </div>
    </form>
  </section>
</Layout>
