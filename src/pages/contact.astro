---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { CONTACT } from '../config';
const offices = [CONTACT.head, CONTACT.showroom];
---

<Layout
  title="Contact Us | Multiple Industries Ltd"
  description="Contact Multiple Industries Limited in Kampala: head office and factory on Plot 714/715, sales office and showroom on Plot 13/23, 8th Street Industrial Area. Call +256 414 236021/2."
  crumbs={[{ name: 'Contact', href: '/contact' }]}
>
  <PageHead eyebrow="Contact" title="Talk to our team." crumbs={[{ name: 'Contact' }]}
    lead="Call, email or visit us on 8th Street Industrial Area, Kampala." />
  <section class="section">
    <div class="container-x grid gap-4 lg:grid-cols-2">
      {offices.map((o) => (
        <address class="card reveal p-7 not-italic sm:p-9">
          <h2 class="text-3xl">{o.name}</h2>
          <p class="mt-3 text-muted">{o.address}</p>
          <ul class="mt-5 space-y-1">
            {o.phones.map((p) => <li><a class="inline-flex min-h-11 items-center font-medium text-cyan hover:underline" href={p.href}>{p.label}</a></li>)}
            {o.emails.map((e) => <li><a class="inline-flex min-h-11 items-center break-all font-medium text-emerald hover:underline" href={`mailto:${e}`}>{e}</a></li>)}
          </ul>
        </address>
      ))}
    </div>
    <div class="container-x mt-4">
      <form class="card p-7 sm:p-9" action="mailto:sales@multipleindustries.com" method="post" enctype="text/plain">
        <h2 class="text-3xl">Send an enquiry</h2>
        <p class="mt-2 text-sm text-muted">Opens your email app, addressed to sales@multipleindustries.com.</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="mb-1 block text-sm text-muted">Your name</span><input name="name" required autocomplete="name" class="min-h-12 w-full rounded-xl border border-line bg-bg px-4 text-ink" /></label>
          <label class="block"><span class="mb-1 block text-sm text-muted">Phone or email</span><input name="contact" required autocomplete="email" class="min-h-12 w-full rounded-xl border border-line bg-bg px-4 text-ink" /></label>
          <label class="block sm:col-span-2"><span class="mb-1 block text-sm text-muted">How can we help?</span><textarea name="message" rows="4" required class="w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink"></textarea></label>
        </div>
        <button class="btn btn-primary mt-6 w-full sm:w-auto" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>
</Layout>
