---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { CONTACT } from '../config';
const offices = [CONTACT.head, CONTACT.showroom];
---
<Layout title="Contact Us" description="Contact Multiple Industries Limited: head office and factory, and sales office and showroom, 8th Street Industrial Area, Kampala, Uganda." breadcrumbs={[{ name: 'Contact', href: '/contact' }]}>
  <PageHero eyebrow="Contact" title="Talk to our team" lead="Call, email or visit us in the 8th Street Industrial Area, Kampala." />
  <section class="section pt-6">
    <div class="container-x grid gap-5 md:grid-cols-2">
      {offices.map((o) => (
        <article class="card">
          <h2 class="text-xl font-bold">{o.label}</h2>
          <p class="mt-4 flex gap-3 text-sm leading-relaxed text-muted"><Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" />{o.address}</p>
          <ul class="mt-4 grid gap-1">
            {o.phones.map((p) => <li><a href={p.href} class="inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-brand-700 hover:underline"><Icon name="phone" class="h-5 w-5" />{p.label}</a></li>)}
            {o.emails.map((e) => <li><a href={`mailto:${e}`} class="inline-flex min-h-11 items-center gap-3 break-all text-sm font-semibold text-brand-700 hover:underline"><Icon name="mail" class="h-5 w-5 shrink-0" />{e}</a></li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="container-x mt-10">
      <form action="mailto:sales@multipleindustries.com" method="post" enctype="text/plain" class="card grid gap-4 sm:grid-cols-2">
        <h2 class="text-xl font-bold sm:col-span-2">Send an enquiry</h2>
        <label class="grid gap-1 text-sm font-medium">Name<input name="name" required autocomplete="name" class="min-h-11 rounded-xl border border-line px-4 py-2" /></label>
        <label class="grid gap-1 text-sm font-medium">Phone or email<input name="contact" required class="min-h-11 rounded-xl border border-line px-4 py-2" /></label>
        <label class="grid gap-1 text-sm font-medium sm:col-span-2">Message<textarea name="message" rows="4" required class="rounded-xl border border-line px-4 py-2"></textarea></label>
        <div class="sm:col-span-2"><button class="btn btn-primary" type="submit">Send by email</button><p class="mt-3 text-xs text-muted">Opens your email app. TODO: connect a form service if desired.</p></div>
      </form>
    </div>
  </section>
</Layout>
