---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { HEAD_OFFICE, SHOWROOM, SALES_EMAIL } from '../config';
import { aisles } from '../data/aisles';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const offices = [
  { ...SHOWROOM, icon: 'store' as const, note: 'Browse the range and buy at the trade counter.', plot: 'Plot 13/23' },
  { ...HEAD_OFFICE, icon: 'building' as const, note: 'Head office and pipe factory.', plot: 'Plot 714/715' },
];
const maps = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---

<Layout
  title="Contact | Multiple Industries, 8th Street Industrial Area, Kampala"
  description="Call, email or visit Multiple Industries: sales office and showroom at Plot 13/23 and head office and factory at Plot 714/715, 8th Street Industrial Area, Kampala."
  breadcrumbs={crumbs}
>
  <section class="wrap pt-4 pb-10" aria-labelledby="contact-h1">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow mt-6">Way to the trade counter</p>
    <h1 id="contact-h1" class="mt-3 text-[2.5rem] leading-[1.03] font-black sm:text-6xl">Call, email or visit us</h1>
    <p class="lede mt-4">Both our sites are on 8th Street in Kampala's Industrial Area. Call ahead and we will have your order ready.</p>

    <!-- Street sign motif -->
    <div class="mt-10 flex justify-center" aria-hidden="true">
      <svg viewBox="0 0 520 150" class="w-full max-w-xl" role="presentation">
        <rect x="252" y="40" width="16" height="110" fill="#6f6879" />
        <g>
          <path d="M40 14h360l26 22-26 22H40z" fill="#0a7f4f" />
          <path d="M46 20h351l19 16-19 16H46z" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2" />
          <text x="62" y="44" fill="#fff" font-family="Overpass Variable, sans-serif" font-weight="800" font-size="22">Showroom · Plot 13/23</text>
        </g>
        <g>
          <path d="M480 72H120L94 94l26 22h360z" fill="#3b1f5c" />
          <path d="M474 78H123l-19 16 19 16h351z" fill="none" stroke="#fff" stroke-opacity=".4" stroke-width="2" />
          <text x="132" y="102" fill="#fff" font-family="Overpass Variable, sans-serif" font-weight="800" font-size="22">Factory · Plot 714/715</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="wrap pb-14" aria-label="Our offices">
    <ul class="grid gap-x-6 gap-y-4 md:grid-cols-2">
      {
        offices.map((o, i) => (
          <li class="hang" style="--drop: 2rem">
            <div class="hang__swing h-full">
              <article class={`sign h-full p-6 md:p-7 ${i === 0 ? 'sign--go' : ''}`}>
                <div class="flex items-center gap-4">
                  <span class="pictogram !size-12 bg-white/10"><Icon name={o.icon} class="size-6" /></span>
                  <div>
                    <h2 class="text-2xl font-extrabold">{o.label}</h2>
                    <p class="text-white/85">{o.note}</p>
                  </div>
                </div>
                <address class="mt-5 not-italic text-lg">
                  {o.street}
                  <br />
                  {'po' in o && o.po ? (<>{o.po}<br /></>) : null}
                  {o.city}, {o.country}
                </address>
                <ul class="mt-4 grid gap-2">
                  {o.phones.map((p) => (
                    <li>
                      <a href={`tel:${p.tel}`} class="btn btn-go w-full !justify-between sm:w-auto sm:min-w-72">
                        <span class="inline-flex items-center gap-2"><Icon name="phone" class="size-5" />{p.display}</span>
                        <span class="text-sm font-bold opacity-75">{p.label}</span>
                      </a>
                    </li>
                  ))}
                  {o.emails.map((e) => (
                    <li>
                      <a href={`mailto:${e}`} class="inline-flex min-h-11 items-center gap-2 font-bold text-white underline underline-offset-4">
                        <Icon name="mail" class="size-5 shrink-0" /><span set:html={e.replace('@', '<wbr>@')} />
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={maps(`Multiple Industries ${o.plot} 8th Street Industrial Area Kampala`)} rel="noopener" class={`font-display mt-4 inline-flex min-h-11 items-center gap-2 font-bold ${i === 0 ? 'text-white underline underline-offset-4' : 'text-signal'}`}>
                  Open in maps <Icon name="arrowUpRight" class="size-5" />
                </a>
              </article>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-line bg-white" aria-labelledby="form-heading">
    <div class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow">Enquiry slip</p>
        <h2 id="form-heading" class="h-section mt-3">Send us your list</h2>
        <p class="lede mt-4">
          Fill in the slip and it opens in your email app, addressed to our sales team. Prefer to talk? Call <a class="font-bold text-plum underline" href={`tel:${SHOWROOM.phones[0].tel}`}>{SHOWROOM.phones[0].display}</a>.
        </p>
      </div>
      <form action={`mailto:${SALES_EMAIL}`} method="post" enctype="text/plain" class="shelf">
        <div class="shelf-label !block !p-5 md:!p-7">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-1.5">
              <span class="font-display font-bold">Your name</span>
              <input name="name" autocomplete="name" required class="min-h-12 rounded border-2 border-line bg-paper px-3 focus:border-plum" />
            </label>
            <label class="grid gap-1.5">
              <span class="font-display font-bold">Phone</span>
              <input name="phone" type="tel" autocomplete="tel" class="min-h-12 rounded border-2 border-line bg-paper px-3 focus:border-plum" />
            </label>
            <label class="grid gap-1.5 sm:col-span-2">
              <span class="font-display font-bold">Aisle</span>
              <select name="aisle" class="min-h-12 rounded border-2 border-line bg-paper px-3 focus:border-plum">
                {aisles.map((a) => <option>{a.number} {a.name}</option>)}
                <option>Transport and logistics</option>
              </select>
            </label>
            <label class="grid gap-1.5 sm:col-span-2">
              <span class="font-display font-bold">What do you need?</span>
              <textarea name="message" rows="5" required class="rounded border-2 border-line bg-paper p-3 focus:border-plum"></textarea>
            </label>
          </div>
          <button type="submit" class="btn btn-plum mt-6 w-full sm:w-auto">Send enquiry <Icon name="arrowRight" class="go size-5" /></button>
        </div>
      </form>
    </div>
  </section>
</Layout>
