---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { LEGAL_NAME, OFFICES, SALES_EMAIL } from '../config';
import { categories } from '../data/categories';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const offices = [
  { ...OFFICES.head, tag: 'A', map: 'Plot 714 8th Street Industrial Area Kampala' },
  { ...OFFICES.showroom, tag: 'B', map: 'Plot 13 8th Street Industrial Area Kampala' },
];
const mapUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const field =
  'mt-2 block w-full min-h-12 font-sans font-normal normal-case tracking-normal border-2 border-ink bg-white px-3 py-2 text-base text-ink focus:border-plum focus:outline-none focus-visible:outline-3 focus-visible:outline-plum';
---

<Layout
  title="Contact — Head Office, Factory & Showroom, Kampala"
  description={`Contact ${LEGAL_NAME}: Head Office & Factory, Plot 714/715 and Sales Office & Showroom, Plot 13/23, 8th Street Industrial Area, Kampala. Hotline +256 414 236021/2.`}
  breadcrumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="8th Street · Industrial Area · Kampala"
    title="Contact & visit"
    lead="Two addresses on 8th Street, Industrial Area. Call the hotline, email the sales desk or walk into the showroom."
  />

  <section class="wrap py-14 lg:py-20" aria-labelledby="offices-title">
    <h2 id="offices-title" class="sr-only">Our offices</h2>
    <div class="grid gap-px border border-ink bg-ink lg:grid-cols-2">
      {
        offices.map((o) => (
          <article class="flex min-w-0 flex-col bg-paper p-6 sm:p-8">
            <div class="flex items-start justify-between gap-4">
              <h3 class="display-md text-3xl sm:text-4xl">{o.label}</h3>
              <span class="display flex size-12 shrink-0 items-center justify-center bg-ink text-2xl text-signal" aria-hidden="true">
                {o.tag}
              </span>
            </div>
            <address class="mt-5 flex items-start gap-3 text-lg not-italic">
              <Icon name="pin" class="mt-1 size-5 shrink-0 text-plum" />
              <span>
                {o.street}
                <br />
                {o.pobox && <>{o.pobox}, </>}
                {o.city}, {o.country}
              </span>
            </address>
            <ul class="mt-6 border-t border-line">
              {o.phones.map((p) => (
                <li class="border-b border-line">
                  <a href={`tel:${p.tel}`} class="flex min-h-12 items-center justify-between gap-3 py-2 hover:text-plum">
                    <span class="label text-steel">{p.label}</span>
                    <span class="text-lg font-bold">{p.display}</span>
                  </a>
                </li>
              ))}
              {o.emails.map((e) => (
                <li class="border-b border-line">
                  <a href={`mailto:${e}`} class="flex min-h-12 flex-col justify-center gap-1 py-2 hover:text-plum sm:flex-row sm:items-center sm:justify-between sm:gap-3">
                    <span class="label text-steel">Email</span>
                    <span class="font-semibold break-all">{e}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={mapUrl(o.map)} class="btn btn-line mt-6 self-start" rel="noopener" target="_blank">
              <Icon name="pin" class="size-5" /> Open in Maps<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-paper-2 grid-paper" aria-labelledby="form-title">
    <div class="wrap grid gap-10 py-14 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <SectionHead no="01" label="Enquiry" title="Send an enquiry" id="form-title" />
        <p class="mt-6 text-lg leading-relaxed">
          This form opens your email app with the details filled in, addressed to {SALES_EMAIL}. Prefer to talk? Call
          the hotline on <a class="font-bold text-plum underline" href="tel:+256414236021">+256 414 236021</a>.
        </p>
      </div>
      <!-- Static site: mailto form. TODO: swap for a form service if the client wants submissions stored. -->
      <form
        class="ticks border border-ink bg-paper p-6 sm:p-8 lg:col-span-7"
        action={`mailto:${SALES_EMAIL}?subject=Website%20enquiry`}
        method="post"
        enctype="text/plain"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="label block text-ink">
            Name
            <input class={field} type="text" name="name" autocomplete="name" required />
          </label>
          <label class="label block text-ink">
            Phone
            <input class={field} type="tel" name="phone" autocomplete="tel" inputmode="tel" />
          </label>
          <label class="label block text-ink sm:col-span-2">
            Division
            <select class={field} name="division">
              <option value="">General enquiry</option>
              {categories.map((c) => <option>{c.name}</option>)}
            </select>
          </label>
          <label class="label block text-ink sm:col-span-2">
            Message / materials list
            <textarea class={`${field} min-h-36 normal-case tracking-normal`} name="message" rows="5" required></textarea>
          </label>
        </div>
        <button type="submit" class="btn btn-ink mt-6 w-full sm:w-auto">
          Compose email <Icon name="arrow" class="size-5" />
        </button>
      </form>
    </div>
  </section>
</Layout>
