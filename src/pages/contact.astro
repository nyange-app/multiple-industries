---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { HEAD_OFFICE, SHOWROOM } from '../config';
import { categories } from '../data/categories';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const offices = [
  { ...HEAD_OFFICE, code: 'A', note: 'Head office, factory and general enquiries.' },
  { ...SHOWROOM, code: 'B', note: 'Showroom visits and sales enquiries.' },
];
const mapUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
---

<Layout
  title="Contact"
  description="Contact Multiple Industries Limited in Kampala: head office & factory at Plot 714/715 and sales showroom at Plot 13/23, 8th Street Industrial Area. Call +256 414 236021/2."
  crumbs={crumbs}
>
  <section class="grid-paper border-b-2 border-ink">
    <div class="wrap pt-4 pb-12">
      <Breadcrumbs crumbs={crumbs} />
      <p class="label mt-6 mb-4 text-plum">8th Street Industrial Area &middot; Kampala</p>
      <h1 class="display text-6xl sm:text-7xl lg:text-8xl">Contact us</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-2">Two addresses on 8th Street. Tap a number to call, or an address to open directions.</p>
    </div>
  </section>

  <section class="wrap grid gap-6 py-12 md:grid-cols-2 md:py-16" aria-label="Offices">
    {
      offices.map((o) => (
        <article class="flex flex-col border-2 border-ink bg-sheet shadow-[6px_6px_0_var(--color-ink)]">
          <header class="flex items-center gap-4 border-b-2 border-ink p-5">
            <span class="display flex size-14 shrink-0 items-center justify-center bg-plum text-4xl text-white">{o.code}</span>
            <div>
              <h2 class="headline text-2xl">{o.label}</h2>
              <p class="text-sm text-ink-2">{o.note}</p>
            </div>
          </header>
          <div class="flex flex-1 flex-col gap-1 p-5">
            <a href={mapUrl(`${o.street}, Kampala, Uganda`)} class="flex min-h-11 items-start gap-3 py-1 hover:text-plum" rel="noopener">
              <Icon name="pin" class="mt-0.5 size-6 shrink-0 text-plum" />
              <address class="not-italic">
                {o.lines.map((l) => <span class="block">{l}</span>)}
                <span class="label mt-1 block text-plum underline underline-offset-4">Directions</span>
              </address>
            </a>
            <ul class="mt-2 divide-y divide-line border-y border-line">
              {o.phones.map((p) => (
                <li>
                  <a href={`tel:${p.tel}`} class="flex min-h-12 items-center justify-between gap-3 py-2 hover:text-plum">
                    <span class="flex items-center gap-3"><Icon name="phone" class="size-5 text-plum" /> <span class="headline text-xl">{p.display}</span></span>
                    <span class="label text-ink-3">{p.label}</span>
                  </a>
                </li>
              ))}
              {o.emails.map((e) => (
                <li>
                  <a href={`mailto:${e}`} class="flex min-h-12 items-center gap-3 py-2 break-all hover:text-plum">
                    <Icon name="mail" class="size-5 shrink-0 text-plum" /> {e}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <section class="border-t-2 border-ink bg-paper-2" aria-labelledby="form-h">
    <div class="wrap grid gap-10 py-12 md:py-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label text-plum">Enquiry form</p>
        <h2 id="form-h" class="display mt-3 text-5xl">Send an enquiry</h2>
        <p class="mt-4 text-ink-2">
          This form opens your email app with the message ready to send to {HEAD_OFFICE.emails[1]}. Nothing is stored on this
          website.
        </p>
      </div>
      <!-- Static mailto form: no backend. TODO: swap for a form service if required. -->
      <form
        action={`mailto:${HEAD_OFFICE.emails[1]}?subject=${encodeURIComponent('Website enquiry')}`}
        method="post"
        enctype="text/plain"
        class="grid gap-5 border-2 border-ink bg-sheet p-5 sm:grid-cols-2 sm:p-8 lg:col-span-8"
      >
        <label class="grid gap-1.5">
          <span class="label">Name</span>
          <input name="name" required autocomplete="name" class="min-h-12 border-2 border-ink bg-white px-3" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Phone</span>
          <input name="phone" type="tel" autocomplete="tel" class="min-h-12 border-2 border-ink bg-white px-3" />
        </label>
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">Division</span>
          <select name="division" class="min-h-12 border-2 border-ink bg-white px-3">
            {categories.map((c) => <option>{c.name}</option>)}
            <option>Transport &amp; logistics</option>
            <option>Other</option>
          </select>
        </label>
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">Message</span>
          <textarea name="message" rows="5" required class="border-2 border-ink bg-white p-3"></textarea>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full sm:w-auto">Open email to send <Icon name="arrow" class="size-5" /></button>
        </div>
      </form>
    </div>
  </section>
</Layout>
