---
import Layout from '../../layouts/Layout.astro';
import House from '../../components/House.astro';
import MiniMap from '../../components/MiniMap.astro';
import ContactCta from '../../components/ContactCta.astro';
import { categories, bySlug, type Category } from '../../data/categories';
import { CONTACT, SITE_URL } from '../../config';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}

interface Props { cat: Category }
const { cat } = Astro.props;
const i = categories.findIndex((c) => c.slug === cat.slug);
const prev = categories[(i + categories.length - 1) % categories.length];
const next = categories[(i + 1) % categories.length];
const pairs = cat.pairs.map(bySlug).filter((c): c is Category => Boolean(c));
const ask = (what: string) =>
  `mailto:sales@multipleindustries.com?subject=${encodeURIComponent(`Enquiry: ${what}`)}&body=${encodeURIComponent(
    `Hello Multiple Industries,\n\nI would like a price and availability for: ${what}.\nQuantity / size:\nDelivery location:\n\nThank you.`
  )}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: cat.name,
    description: cat.short,
    url: new URL(`/products/${cat.slug}/`, SITE_URL).href,
    isPartOf: { '@id': `${SITE_URL}/#org` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: cat.products.map((p, idx) => ({ '@type': 'ListItem', position: idx + 1, name: p.name })),
    },
  },
];
---

<Layout
  title={`${cat.name}: ${cat.short.replace(/\.$/, '')}`}
  description={`${cat.name} from Multiple Industries, Kampala. ${cat.short}`}
  crumbs={[{ name: 'Products', path: '/products/' }, { name: cat.name, path: `/products/${cat.slug}/` }]}
  jsonLd={jsonLd}
>
  <section class="bg-sky" aria-labelledby="cat-title">
    <div class="wrap pb-12 pt-5 md:pb-16 md:pt-8">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-1 text-muted">
          <li><a href="/" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/products/" class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">Products</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-ink">{cat.name}</li>
        </ol>
      </nav>

      <div class="mt-3 grid gap-8 lg:grid-cols-[1fr_minmax(0,30rem)] lg:items-center lg:gap-12">
        <div>
          <div class="flex items-center gap-3">
            <span class="badge-n" aria-hidden="true">{cat.n}</span>
            <p class="eyebrow">Zone {cat.n} · {cat.zone}</p>
          </div>
          <h1 id="cat-title" class="mt-4 text-[2.4rem] font-extrabold sm:text-5xl lg:text-6xl">{cat.name}</h1>
          <p class="mt-4 max-w-2xl text-lg text-muted md:text-xl">{cat.intro}</p>
          <ul class="mt-5 flex flex-wrap gap-2 text-sm font-semibold" aria-label="Who buys this range">
            {cat.buyers.map((b) => <li class="rounded-full border-2 border-ink bg-white px-3 py-1">{b}</li>)}
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={CONTACT.hotline.href} class="btn btn-sun">Call {CONTACT.hotline.label}</a>
            <a href={ask(cat.name)} class="btn btn-ghost">Email about this range</a>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-square overflow-hidden rounded-[1.75rem] border-2 border-ink bg-sky shadow-[0_6px_0_var(--color-ink)]">
            <House view={cat.crop} focus={cat.slug} id={`v${cat.n}`} class="h-full" label={`Close-up of the ${cat.zone.toLowerCase()} in the illustrated house`} />
          </div>
          <MiniMap active={cat.slug} class="absolute -bottom-6 right-3 w-28 rounded-xl bg-white p-2 shadow-[0_4px_0_var(--color-ink)] ring-2 ring-ink sm:w-36 md:-right-4" />
        </div>
      </div>
    </div>
    <div class="groundline bg-day" aria-hidden="true"></div>
  </section>

  <section class="wrap py-14 md:py-20" aria-labelledby="range-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">In this zone</p>
        <h2 id="range-title" class="mt-2 text-3xl font-bold md:text-4xl">The {cat.name.toLowerCase()} range</h2>
      </div>
      <p class="max-w-sm text-sm text-muted">Indicative list. Ask the showroom for current sizes, stock and prices.</p>
    </div>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cat.products.map((p, idx) => (
        <li class="card flex flex-col p-4 sm:p-5">
          <div class="flex items-start justify-between gap-3">
            <span class="font-display text-sm font-bold text-leaf">{cat.n}.{idx + 1}</span>
            {p.made && <span class="rounded-full bg-leaf-soft px-2.5 py-0.5 text-xs font-semibold text-leaf">Made by us</span>}
          </div>
          <h3 class="mt-2 text-xl font-bold">{p.name}</h3>
          <p class="mt-1 flex-1 text-muted">{p.note}</p>
          <a href={ask(p.name)} class="group font-display mt-3 inline-flex min-h-11 items-center gap-1 self-start font-semibold">
            <span class="underline decoration-sun decoration-[3px] underline-offset-4 group-hover:decoration-ink">Ask about this<span class="sr-only">: {p.name}</span></span><span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    {cat.brands && (
      <div class="mt-10 rounded-2xl border-2 border-dashed border-line bg-white p-5">
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-muted">Brands in this range (to confirm)</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {cat.brands.map((b) => <li class="font-display rounded-lg border-2 border-ink bg-day px-3 py-1.5 font-bold">{b}</li>)}
        </ul>
      </div>
    )}
  </section>

  <section class="border-y-2 border-ink bg-white py-14" aria-labelledby="pairs-title">
    <div class="wrap">
      <h2 id="pairs-title" class="text-2xl font-bold md:text-3xl">Works with the rest of the house</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {pairs.map((c) => (
          <li>
            <a href={`/products/${c.slug}/`} class="card group flex items-center gap-4 p-4 hover:border-ink">
              <div class="aspect-square w-24 flex-none overflow-hidden rounded-xl border-2 border-ink sm:w-28">
                <House view={c.crop} focus={c.slug} id={`p${c.n}`} class="h-full" label="" />
              </div>
              <div>
                <p class="font-display text-xs font-semibold uppercase tracking-widest text-leaf">Zone {c.n} · {c.zone}</p>
                <h3 class="mt-1 text-xl font-bold">{c.name}</h3>
                <p class="mt-1 text-sm text-muted">{c.short}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <nav aria-label="Other zones" class="mt-10 flex flex-col gap-3 sm:flex-row sm:justify-between">
        <a href={`/products/${prev.slug}/`} class="btn btn-ghost justify-start"><span aria-hidden="true">←</span> {prev.n}. {prev.name}</a>
        <a href={`/products/${next.slug}/`} class="btn btn-ghost justify-start sm:justify-end">{next.n}. {next.name} <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>

  <div class="pt-14">
    <ContactCta title={`Need ${cat.name.toLowerCase()} for your project?`} />
  </div>
</Layout>
