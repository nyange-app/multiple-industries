---
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';

export function getStaticPaths() {
  return categories.map((category, i) => ({
    params: { slug: category.slug },
    props: { category, prev: categories[i - 1], next: categories[i + 1] },
  }));
}
const { category, prev, next } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: category.title,
  itemListElement: category.products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name })),
};
---

<Layout
  title={`${category.title} products`}
  description={`${category.title} from Multiple Industries Limited, Kampala. ${category.lede}`}
  crumbs={[{ name: 'Products', href: '/products' }, { name: category.title, href: `/products/${category.slug}` }]}
  jsonLd={[ld]}
>
  <section class="border-b border-ink">
    <div class="wrap py-12 md:py-20">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-widest text-ink-soft">
        <ol class="flex flex-wrap gap-x-2">
          <li><a href="/" class="link-u">Home</a></li><li aria-hidden="true">/</li>
          <li><a href="/products" class="link-u">Products</a></li><li aria-hidden="true">/</li>
          <li aria-current="page">{category.no}</li>
        </ol>
      </nav>
      <div class="mt-8 grid gap-6 md:grid-cols-12 md:items-end">
        <p class="numeral text-[7rem] leading-[0.8] md:col-span-3 md:text-[11rem]">{category.no}</p>
        <div class="md:col-span-9">
          <p class="eyebrow">Category {category.no} of 06</p>
          <h1 class="mt-3 text-5xl md:text-7xl">{category.title}</h1>
          <p class="mt-6 max-w-2xl font-serif text-xl leading-snug text-ink-soft md:text-2xl">{category.lede}</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap py-14 md:py-20">
      <div class="flex items-baseline justify-between">
        <h2 class="text-3xl md:text-4xl">Product index</h2>
        <p class="text-xs uppercase tracking-widest text-ink-soft">{category.products.length} lines</p>
      </div>

      <div class="mt-8 hidden grid-cols-[4rem_1.4fr_1.2fr_1fr] gap-4 border-b border-ink pb-3 text-xs font-semibold uppercase tracking-widest text-ink-soft md:grid" aria-hidden="true">
        <span>No.</span><span>Product</span><span>Material / brand</span><span>Range</span>
      </div>
      <ol class="md:mt-0 mt-6">
        {category.products.map((p, i) => (
          <li class="index-row grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 py-5 md:grid-cols-[4rem_1.4fr_1.2fr_1fr]">
            <span class="numeral text-lg md:text-xl">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-serif text-2xl leading-tight">{p.name}</span>
            <span class="col-start-2 text-sm text-ink-soft md:col-start-3 md:text-base"><span class="sr-only">Material: </span>{p.material}</span>
            <span class="col-start-2 text-sm md:col-start-4 md:text-base"><span class="sr-only">Range: </span>{p.note}</span>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-ink-soft">TODO: placeholder product lines. Replace with the confirmed catalogue, sizes and datasheets.</p>

      <div class="mt-12 flex flex-col gap-3 sm:flex-row">
        <a href="/contact#enquire" class="btn btn-clay">Request a quotation</a>
        <a href="tel:+256414236021" class="btn">Call +256 414 236021/2</a>
      </div>
    </div>
  </section>

  <nav aria-label="More categories" class="border-t border-ink">
    <div class="wrap grid md:grid-cols-2">
      {prev ? (
        <a href={`/products/${prev.slug}`} class="group flex min-h-24 flex-col justify-center border-b border-rule py-5 md:border-b-0 md:border-r md:pr-8">
          <span class="text-xs uppercase tracking-widest text-ink-soft">&larr; Previous</span>
          <span class="font-serif text-2xl group-hover:text-clay"><span class="numeral">{prev.no}</span> {prev.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a href={`/products/${next.slug}`} class="group flex min-h-24 flex-col justify-center py-5 md:items-end md:pl-8 md:text-right">
          <span class="text-xs uppercase tracking-widest text-ink-soft">Next &rarr;</span>
          <span class="font-serif text-2xl group-hover:text-clay"><span class="numeral">{next.no}</span> {next.title}</span>
        </a>
      )}
    </div>
  </nav>
</Layout>
