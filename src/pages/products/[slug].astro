---
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/Crumbs.astro';
import { categories, type Category } from '../../data/categories';
import { EMAIL_SALES, HOTLINES, PHONE_MAIN, SITE_URL, mailto, whatsapp } from '../../config';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}

interface Props { cat: Category }
const { cat } = Astro.props;
const index = categories.findIndex((c) => c.slug === cat.slug);
const others = categories.filter((c) => c.slug !== cat.slug);
const prev = categories[(index + categories.length - 1) % categories.length];
const next = categories[(index + 1) % categories.length];

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
  { name: cat.name, href: `/products/${cat.slug}/` },
];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${cat.name} from Multiple Industries`,
  itemListElement: cat.items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Product', name: it.name, description: it.spec, sku: it.ref, brand: { '@type': 'Organization', name: 'Multiple Industries', url: SITE_URL } },
  })),
};
const ask = (name: string, ref: string) =>
  mailto(EMAIL_SALES, `Enquiry: ${name} (${ref})`, `Hello Multiple Industries, please quote for ${name} (${ref}).\nQuantity:\n\nName:\nDelivery location:`);
const backing = cat.paper === 'pink' ? 'paper-canary' : 'paper-pink';
---

<Layout
  title={`${cat.name}: enquiry form`}
  description={`${cat.name} from Multiple Industries, Kampala: ${cat.short} Tick the items you need and send an enquiry by WhatsApp or email.`}
  crumbs={crumbs}
  jsonLd={[itemList]}
>
  <div class="wrap pt-4 sm:pt-6">
    <Crumbs items={crumbs} />

    <div class="mt-4 grid items-start gap-10 lg:grid-cols-[1fr_19rem]">
      <!-- ============ THE FORM ============ -->
      <section aria-labelledby="form-title">
        <div class="relative">
        <div aria-hidden="true" class={`slip ${backing} absolute inset-0 translate-x-2 translate-y-2.5 rotate-[0.9deg]`}></div>
        <div class="slip perf smudge relative px-4 pb-6 pt-7 sm:px-8 sm:pb-8">
          <div class="form-head">
            <p class="form-label">Enquiry form · {cat.code}</p>
            <p class="serial">No. {cat.code}-{String(index + 1).padStart(2, '0')}</p>
          </div>

          <div class={`relative -mx-4 mt-0 px-4 pb-5 pt-5 sm:-mx-8 sm:px-8 paper-${cat.paper === 'white' ? 'canary' : cat.paper}`}>
            <h1 id="form-title" class="max-w-[18ch] text-[2.2rem] sm:pr-36 sm:text-5xl">{cat.name}</h1>
            <p class="mt-3 max-w-[60ch] text-lg">{cat.intro}</p>
            <p class="typed mt-3 pr-28 text-sm sm:pr-0"><b>Note:</b> {cat.note}.</p>
            <div class="stamp stamp-anim absolute -bottom-6 right-3 text-[0.6rem] sm:bottom-auto sm:right-8 sm:top-3 sm:text-xs" style="--rot:9deg">
              <span>Quality</span><span class="text-lg sm:text-xl">ISO 9001</span><span>:2015</span>
            </div>
          </div>

          <p class="needs-js hand mt-9 -rotate-1 pr-24 text-2xl text-stamp sm:mt-6 sm:pr-0">Tick the boxes, add quantities, then send ↓</p>
          <p class="no-js-only mt-9 pr-24 text-[0.95rem] text-muted sm:mt-6 sm:pr-0">Tap <b class="text-carbon">Ask</b> on any line to email our sales team about that item.</p>

          <div class="rowhead mt-4 hidden border-b-2 border-carbon pb-1.5 sm:grid" aria-hidden="true">
            <span class="form-label needs-js">✓</span>
            <span class="form-label">Ref</span>
            <span class="form-label">Description</span>
            <span class="form-label needs-js">Qty</span>
            <span class="form-label needs-js">Unit</span>
            <span></span>
          </div>

          <ul class="rows" aria-label={`${cat.name} items`}>
            {cat.items.map((it) => (
              <li class="row" data-item={it.ref} data-name={it.name}>
                <input type="checkbox" id={`cb-${it.ref}`} class="tick needs-js [grid-area:tick]" />
                <span class="serial self-center text-sm [grid-area:ref] max-sm:hidden">{it.ref}</span>
                <label for={`cb-${it.ref}`} class="[grid-area:desc] cursor-pointer">
                  <span class="typed block text-[1.05rem] font-bold leading-snug">{it.name}</span>
                  <span class="block text-sm text-muted"><span class="serial sm:hidden">{it.ref} · </span>{it.spec}</span>
                </label>
                <label class="needs-js [grid-area:qty]">
                  <span class="sr-only">Quantity of {it.name} in {it.unit}</span>
                  <input type="number" min="0" inputmode="numeric" placeholder="qty" class="qty" />
                </label>
                <span class="needs-js typed self-center text-sm text-muted [grid-area:unit]">{it.unit}</span>
                <a href={ask(it.name, it.ref)} class="ask [grid-area:ask]">Ask<span class="sr-only"> about {it.name} by email</span></a>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-3 border-t-2 border-dashed border-carbon/30 pt-5">
            <a data-slip-wa href={whatsapp(`Hello Multiple Industries, I have an enquiry about ${cat.name}.`)} class="needs-js btn btn-primary" rel="noopener">Send slip by WhatsApp</a>
            <a data-slip-mail href={mailto(EMAIL_SALES, `Enquiry: ${cat.name}`)} class="btn btn-ghost"><span class="needs-js">Send slip by email</span><span class="no-js-only">Email sales about {cat.name}</span></a>
            <button type="button" data-slip-clear class="needs-js btn !border-transparent !px-2 text-sm text-stamp underline underline-offset-4 hover:!text-stamp-deep">Clear slip</button>
          </div>
        </div>
        </div>

        <nav aria-label="Previous and next forms" class="relative mt-6 flex justify-between gap-3">
          <a href={`/products/${prev.slug}/`} class="btn btn-ghost text-sm"><span aria-hidden="true">←</span> {prev.code} · {prev.name}</a>
          <a href={`/products/${next.slug}/`} class="btn btn-ghost text-right text-sm">{next.code} · {next.name} <span aria-hidden="true">→</span></a>
        </nav>
      </section>

      <!-- ============ SIDE: other forms + counter help ============ -->
      <aside class="grid gap-8 lg:sticky lg:top-6" aria-label="More forms and help">
        <nav aria-labelledby="other-title">
          <h2 id="other-title" class="form-label mb-3">Other forms on the pad</h2>
          <ul class="grid gap-2">
            {others.map((o, i) => (
              <li>
                <a href={`/products/${o.slug}/`} class={`slip paper-${o.paper} lift flex min-h-14 items-center gap-3 px-4 py-2.5 font-bold text-carbon hover:text-stamp`} style={`--lift-rot:${i % 2 ? '0.6deg' : '-0.6deg'}`}>
                  <span class="serial w-8 text-sm">{o.code}</span>{o.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="drop">
          <div class="slip paper-canary tear px-5 pt-5">
            <h2 class="form-label">Rather talk it through?</h2>
            <p class="hand mt-2 text-2xl leading-tight text-carbon">Not sure of sizes? Tick it anyway and ask.</p>
            <ul class="mt-3 grid gap-1 text-sm">
              <li><a class="link inline-flex min-h-11 items-center" href={`tel:${PHONE_MAIN.tel}`}>{PHONE_MAIN.label}</a></li>
              {HOTLINES.map((h) => <li><a class="link inline-flex min-h-11 items-center" href={`tel:${h.tel}`}>{h.label}</a></li>)}
            </ul>
            <p class="mt-2 text-sm text-muted">Showroom: Plot 13/23, 8th Street Industrial Area, Kampala.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .rowhead,
  .row {
    grid-template-columns: 2.25rem 4.25rem 1fr 5.5rem 4rem 4.5rem;
    grid-template-areas: 'tick ref desc qty unit ask';
    column-gap: 0.75rem;
  }
  .row {
    display: grid;
    align-items: center;
    row-gap: 0.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px dotted rgb(34 50 138 / 0.45);
  }
  @media (max-width: 639.98px) {
    .row {
      grid-template-columns: 2.25rem minmax(0, 6.5rem) 1fr auto;
      grid-template-areas: 'tick desc desc desc' '. qty unit ask';
    }
  }
  /* without JS there is no tick or qty column */
  :global(html:not(.js)) .row,
  :global(html:not(.js)) .rowhead {
    grid-template-columns: 4.25rem 1fr auto;
    grid-template-areas: 'ref desc ask';
  }
  @media (max-width: 639.98px) {
    :global(html:not(.js)) .row { grid-template-columns: 1fr auto; grid-template-areas: 'desc ask'; }
  }
  .qty {
    width: 100%;
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-bottom: 2px solid var(--color-carbon);
    background: rgb(250 236 156 / 0.45);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-stamp);
  }
  .qty::-webkit-inner-spin-button, .qty::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .qty { -moz-appearance: textfield; appearance: textfield; }
  .qty::placeholder { color: rgb(75 81 112 / 0.75); font-size: 1.15rem; }
  .ask {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 4.25rem;
    padding-inline: 0.75rem;
    border: 2px solid var(--color-carbon);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-carbon);
    text-decoration: none;
  }
  .ask:hover { background: var(--color-carbon); color: #fff; }
  .row:has(.tick:checked) { background: linear-gradient(90deg, rgb(250 236 156 / 0.55), transparent 85%); }
</style>
