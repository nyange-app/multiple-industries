---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import ResinCode from '../../components/ResinCode.astro';
import ContactCta from '../../components/ContactCta.astro';
import { CATEGORIES, MATERIALS, type Category } from '../../data/categories';
import { PRIMARY_PHONE, SALES_EMAIL } from '../../config';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}
interface Props {
  cat: Category;
}
const { cat } = Astro.props;
const index = CATEGORIES.findIndex((c) => c.slug === cat.slug);
const num = String(index + 1).padStart(2, '0');
const prev = CATEGORIES[(index + CATEGORIES.length - 1) % CATEGORIES.length];
const next = CATEGORIES[(index + 1) % CATEGORIES.length];
const crumbs = [
  { name: 'Products', href: '/products/' },
  { name: cat.name, href: `/products/${cat.slug}/` },
];
const resins = [...new Set(cat.products.map((p) => p.material).filter((m) => m && MATERIALS[m].resin))] as (keyof typeof MATERIALS)[];
const mailto = (product?: string) =>
  `mailto:${SALES_EMAIL}?subject=${encodeURIComponent(`Enquiry: ${product ?? cat.name}`)}`;

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${cat.name} products`,
  itemListElement: cat.products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name })),
};
---

<Layout
  title={`${cat.name}: ${cat.short.replace(/\.$/, '')}`}
  description={`${cat.name} from Multiple Industries, Kampala. ${cat.short} ISO 9001:2015 certified supplier since 1991.`}
  breadcrumbs={crumbs}
  jsonLd={[itemList]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap mt-2" aria-labelledby="cat-title">
    <div class="panel pellets ejector overflow-hidden p-6 pt-9 sm:p-10 lg:p-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="eyebrow">Product line {num} of 06</p>
          <h1 id="cat-title" class="deboss mt-3 text-[2.4rem] leading-[1.02] sm:text-6xl">{cat.name}</h1>
          <p class="mt-4 max-w-2xl text-lg text-muted">{cat.lead}</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href={mailto()} class="btn btn-cta"><Icon name="mail" /> Request a quote</a>
            <a href={`tel:${PRIMARY_PHONE.tel}`} class="btn"><Icon name="phone" /> {PRIMARY_PHONE.display}</a>
          </div>
        </div>
        <div class="cavity hidden h-40 w-40 place-items-center rounded-[2rem] text-ppr-deep lg:grid">
          <Icon name={cat.icon} class="h-20 w-20" />
        </div>
      </div>
      {
        resins.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-3" aria-label="Pipe materials in this range">
            {resins.map((m) => (
              <li class="cavity flex items-center gap-3 rounded-full py-1.5 pl-2 pr-4">
                <ResinCode code={MATERIALS[m].resin!.code} abbr={MATERIALS[m].resin!.abbr} class="h-9 w-9 text-ink/80" />
                <span class="font-display text-sm font-bold">{MATERIALS[m].label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div class="wrap mt-12 grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-12">
    <section aria-labelledby="range-title">
      <h2 id="range-title" class="text-3xl sm:text-4xl">The range</h2>
      <p class="mt-2 text-muted">Sizes, pressure classes and stock change often. Ask our sales team for current availability and prices.</p>
      <!-- TODO: replace indicative product list with confirmed products, sizes and photos. -->
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          cat.products.map((p) => {
            const mat = MATERIALS[p.material ?? 'mixed'];
            return (
              <li class="panel lift flex flex-col overflow-hidden">
                <span class={`pipe pipe-${p.material ?? 'mixed'} mx-5 mt-5 h-6`} aria-hidden="true" />
                <div class="flex flex-1 flex-col p-5 pt-4">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-xl">{p.name}</h3>
                    {mat.resin && <ResinCode code={mat.resin.code} abbr={mat.resin.abbr} class="h-10 w-10 shrink-0 text-ink/75" />}
                  </div>
                  <p class="mt-1 text-muted">{p.note}</p>
                  <p class="mt-3 text-sm font-semibold text-ink">Material: {mat.label}</p>
                  <a
                    href={mailto(p.name)}
                    class="mt-auto inline-flex min-h-11 items-center gap-1.5 pt-3 font-display font-bold text-cta-deep underline-offset-4 hover:underline"
                  >
                    Ask about sizes and prices <Icon name="arrow" class="h-5 w-5" />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <aside class="grid content-start gap-4" aria-label="About this range">
      <div class="panel p-6">
        <h2 class="text-xl">About this range</h2>
        <p class="mt-2 text-muted">{cat.body}</p>
      </div>
      <div class="panel p-6">
        <h2 class="text-xl">Who buys it</h2>
        <ul class="mt-3 grid gap-2">
          {
            cat.forWho.map((w) => (
              <li class="flex items-center gap-2.5">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-ppr-tint text-ppr-deep">
                  <Icon name="check" class="h-4 w-4" />
                </span>
                {w}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="cavity flex items-center gap-3 p-4">
        <Icon name="shield" class="h-8 w-8 shrink-0 text-ppr-deep" />
        <p class="text-sm"><strong>ISO 9001:2015</strong> quality management. Products certified by <strong>UNBS</strong>.</p>
      </div>
    </aside>
  </div>

  <nav class="wrap mt-14" aria-label="Other product lines">
    <h2 class="text-2xl">Other product lines</h2>
    <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        CATEGORIES.filter((c) => c.slug !== cat.slug).map((c) => (
          <li>
            <a href={`/products/${c.slug}/`} class="panel lift flex min-h-[4.5rem] items-center gap-3 p-3 pr-4 font-display text-[0.95rem] font-semibold leading-tight no-underline">
              <span class="cavity grid h-11 w-11 shrink-0 place-items-center rounded-xl text-ppr-deep">
                <Icon name={c.icon} class="h-6 w-6" />
              </span>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-5 flex justify-between gap-3">
      <a href={`/products/${prev.slug}/`} class="btn !px-4 text-sm" aria-label={`Previous: ${prev.name}`}>
        <Icon name="arrow" class="rotate-180" /> <span class="hidden sm:inline">{prev.name}</span><span class="sm:hidden">Previous</span>
      </a>
      <a href={`/products/${next.slug}/`} class="btn !px-4 text-sm" aria-label={`Next: ${next.name}`}>
        <span class="hidden sm:inline">{next.name}</span><span class="sm:hidden">Next</span> <Icon name="arrow" />
      </a>
    </div>
  </nav>

  <ContactCta title={`Pricing ${cat.name.toLowerCase()} for a project?`} subject={`Enquiry: ${cat.name}`} />
</Layout>
