---
import Layout from '../../layouts/Layout.astro';
import Strata from '../../components/Strata.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import Glyph from '../../components/Glyph.astro';
import { categories, type Category } from '../../data/categories';
import { breadcrumbLd, abs } from '../../lib/seo';
import { HOTLINE, OFFICES } from '../../config';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}

interface Props {
  cat: Category;
}
const { cat } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
  { name: cat.name, path: `/products/${cat.slug}/` },
];
const chapters = [
  { id: 'overview', title: 'Overview' },
  ...cat.groups.map((g) => ({ id: g.id, title: g.title })),
  { id: 'enquire', title: 'Enquire' },
];
const others = categories.filter((c) => c.slug !== cat.slug);
const showroom = OFFICES[1];
const mailSubject = encodeURIComponent(`Enquiry: ${cat.name}`);

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${cat.name} | Multiple Industries`,
  url: abs(`/products/${cat.slug}/`),
  itemListElement: cat.groups
    .flatMap((g) => g.rows)
    .map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.name })),
};
---

<Layout
  title={`${cat.name}`}
  description={`${cat.name} from Multiple Industries, Kampala. ${cat.short} ISO 9001:2015, UNBS-certified products.`}
  jsonLd={[breadcrumbLd(crumbs), itemListLd]}
>
  <section class="p-head" aria-labelledby="cat-title">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="head-grid">
        <div class="folio" aria-hidden="true">
          <span>{cat.no}</span>
          <Glyph name={cat.glyph} class="folio-glyph" />
        </div>
        <div>
          <p class="kicker">Department {cat.no} of 06</p>
          <h1 id="cat-title" class="display-lg title">{cat.name}</h1>
          <p class="lede standfirst">{cat.standfirst}</p>
          <p class="for"><span>For</span> {cat.audiences.join(' · ')}</p>
        </div>
      </div>
    </div>
  </section>

  <Strata from="var(--color-parchment)" to="var(--color-paper)" variant={2} />

  <div class="article-wrap">
    <nav class="chips" aria-label="On this page">
      <ul class="wrap">
        {chapters.map((c) => <li><a href={`#${c.id}`}>{c.title}</a></li>)}
      </ul>
    </nav>

    <div class="wrap article">
      <aside class="toc" aria-label="Chapters">
        <p class="kicker">In this department</p>
        <ol>
          {
            chapters.map((c, i) => (
              <li>
                <a href={`#${c.id}`}>
                  <span class="toc-no">{String(i + 1).padStart(2, '0')}</span>
                  {c.title}
                </a>
              </li>
            ))
          }
        </ol>
        <div class="toc-card">
          <p class="toc-card-h">Ask the showroom</p>
          <a href={`tel:${showroom.phones[1].tel}`}>{showroom.phones[1].label}</a>
          <a href={`mailto:sales@multipleindustries.com?subject=${mailSubject}`}>sales@multipleindustries.com</a>
        </div>
      </aside>

      <article class="content">
        <section id="overview" aria-labelledby="h-overview">
          <h2 id="h-overview" class="ch-title"><span class="sect">§</span> Overview</h2>
          <div class="prose-ed">
            {cat.overview.map((p, i) => <p class={i === 0 ? 'dropcap' : ''}>{p}</p>)}
          </div>
        </section>

        {
          cat.groups.map((g) => (
            <section id={g.id} aria-labelledby={`h-${g.id}`}>
              <h2 id={`h-${g.id}`} class="ch-title">
                <span class="sect">§</span> {g.title}
              </h2>
              <table class="range">
                <caption class="sr-only">{g.title}: products in the range</caption>
                <thead>
                  <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Use &amp; notes</th>
                  </tr>
                </thead>
                <tbody>
                  {g.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.name}</th>
                      <td>{r.detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))
        }
        <p class="placeholder-note">Product list is a placeholder. Full range, sizes and pressure classes to be confirmed.</p>

        <section id="enquire" class="enquire" aria-labelledby="h-enquire">
          <p class="kicker">Enquire</p>
          <h2 id="h-enquire" class="display-md">Need a quote for {cat.name.toLowerCase()}?</h2>
          <p>
            Call or visit the Sales Office &amp; Showroom at {showroom.street}, Kampala. Tell us the job, the quantities and
            where it is going.
          </p>
          <div class="enq-actions">
            <a class="btn btn-primary" href={`tel:${HOTLINE.tel}`}>Call {HOTLINE.label}</a>
            <a class="btn btn-ghost" href={`mailto:sales@multipleindustries.com?subject=${mailSubject}`}>Email sales</a>
          </div>
        </section>
      </article>
    </div>
  </div>

  <section class="elsewhere" aria-labelledby="else-title">
    <div class="wrap">
      <p class="kicker">Elsewhere in the index</p>
      <h2 id="else-title" class="display-md else-title">Other departments</h2>
      <CategoryIndex items={others} />
    </div>
  </section>
</Layout>

<style>
  .p-head {
    padding: 0.75rem 0 1.5rem;
  }
  .head-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .folio {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    color: var(--color-murram);
  }
  .folio span {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 400;
    font-size: clamp(5rem, 24vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
  }
  :global(.folio-glyph) {
    width: 3rem;
    height: 3rem;
    color: var(--color-papyrus);
    margin-bottom: 0.4rem;
  }
  .title {
    margin-top: 0.6rem;
  }
  .standfirst {
    margin-top: 1.1rem;
    color: var(--color-ink-soft);
  }
  .for {
    margin-top: 1.25rem;
    font-size: 0.92rem;
    color: var(--color-muted);
  }
  .for span {
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-papyrus);
    margin-right: 0.5rem;
  }

  .article-wrap {
    background: var(--color-paper);
    padding-bottom: 3rem;
  }
  /* Mobile chapter chips: sticky, horizontally scrollable */
  .chips {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(251 247 240 / 0.96);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(6px);
  }
  .chips ul {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0 auto;
    padding-block: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    border: 1.5px solid var(--color-ink);
    background: var(--color-paper);
  }
  .chips a:hover {
    background: var(--color-ink);
    color: var(--color-parchment);
  }
  .article {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
  }
  .toc {
    display: none;
  }
  .content > section {
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .ch-title {
    font-size: clamp(1.6rem, 5vw, 2.3rem);
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--color-ink);
  }
  .sect {
    color: var(--color-murram);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    margin-right: 0.15em;
  }
  .range {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
  }
  .range thead th {
    text-align: left;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0 0.5rem 0.5rem 0;
  }
  .range tbody th,
  .range td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 0.75rem 0.85rem 0;
    border-top: 1px dashed var(--color-line);
  }
  .range tbody th {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: 1.12rem;
    line-height: 1.25;
    width: 48%;
  }
  .range td {
    color: var(--color-muted);
  }
  .placeholder-note {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-muted);
  }
  .enquire {
    margin-top: 2.5rem;
    padding: 1.75rem 1.25rem !important;
    background: var(--color-clay);
    border-top: 4px solid var(--color-murram);
  }
  .enquire .kicker {
    color: var(--color-murram-deep);
  }
  .enquire h2 {
    margin: 0.5rem 0 0.75rem;
  }
  .enq-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .elsewhere {
    padding-top: 3.5rem;
  }
  .else-title {
    margin: 0.5rem 0 1.5rem;
  }

  @media (min-width: 48rem) {
    .head-grid {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
      align-items: end;
      margin-top: 2rem;
    }
    .p-head {
      padding-bottom: 2.5rem;
    }
    .enquire {
      padding: 2.25rem 2.25rem !important;
    }
  }
  @media (min-width: 64rem) {
    .chips {
      display: none;
    }
    .article {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 4rem;
      padding-top: 3rem;
    }
    .toc {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
    .toc ol {
      list-style: none;
      padding: 0;
      margin: 0.75rem 0 0;
      border-top: 2px solid var(--color-ink);
    }
    .toc a {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      min-height: 2.75rem;
      text-decoration: none;
      border-bottom: 1px solid var(--color-line);
      font-weight: 500;
    }
    .toc a:hover {
      color: var(--color-murram);
    }
    .toc-no {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--color-murram);
      width: 1.6rem;
    }
    .toc-card {
      margin-top: 1.5rem;
      padding: 1rem;
      border: 2px solid var(--color-ink);
      display: grid;
      gap: 0.1rem;
    }
    .toc-card-h {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 560;
    }
    .toc-card a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      color: var(--color-murram);
      font-weight: 600;
      font-size: 0.9rem;
      overflow-wrap: anywhere;
    }
    .content {
      max-width: 48rem;
    }
  }
</style>
