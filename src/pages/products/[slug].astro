---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Stage from '../../components/Stage.astro';
import PlinthCard from '../../components/PlinthCard.astro';
import { HEAD_OFFICE, SHOWROOM } from '../../config';
import { categories, type Category } from '../../data/categories';

export const getStaticPaths = (() =>
  categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}
const { category: c } = Astro.props;
const others = categories.filter((o) => o.slug !== c.slug);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Collection', href: '/#collection' },
  { name: c.name, href: `/products/${c.slug}/` },
];
const mailSubject = encodeURIComponent(`Enquiry: ${c.name}`);
---

<Layout
  title={`${c.name} | Multiple Industries, Kampala`}
  description={`${c.short} Multiple Industries Ltd, Kampala. ISO 9001:2015 certified; products certified by UNBS.`}
  breadcrumbs={crumbs}
>
  <section class="border-b border-graphite-2" aria-labelledby="exhibit-title">
    <div class="wrap pt-4 md:pt-6">
      <Breadcrumbs items={crumbs} />
    </div>
    <div class="wrap grid items-end gap-8 pt-6 md:grid-cols-12 md:gap-12 md:pt-10">
      <div class="md:col-span-7 md:pb-16">
        <p class="eyebrow">Exhibit No. {c.no} of 06</p>
        <h1 id="exhibit-title" class="mt-4 text-[3.2rem] leading-[0.98] sm:text-7xl lg:text-8xl">{c.name}</h1>
        <span class="rule" aria-hidden="true"></span>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porcelain-dim">{c.intro}</p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Typical uses">
          {c.uses.map((u) => <li class="border border-graphite-2 px-3 py-1.5 text-xs font-semibold tracking-wide text-porcelain-dim">{u}</li>)}
        </ul>
      </div>
      <div class="md:col-span-5">
        <Stage kind={c.object} on class="aspect-[4/3] md:aspect-[4/4.6]" />
      </div>
    </div>
  </section>

  <section class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-24" aria-labelledby="list-title">
    <div class="md:col-span-7">
      <p class="eyebrow">In this collection</p>
      <h2 id="list-title" class="mt-3 text-4xl md:text-5xl">What’s on the floor</h2>
      <!-- TODO: replace placeholder product list with the confirmed range, sizes and specs. -->
      <ol class="mt-8 border-t border-graphite-2">
        {
          c.products.map((p, i) => (
            <li class="group grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-graphite-2 py-5 sm:grid-cols-[3rem_1fr_auto] sm:items-baseline">
              <span class="font-serif text-xl text-brass">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-sans text-lg font-semibold tracking-normal text-porcelain">{p.name}</h3>
                <p class="mt-1 text-sm text-steel">{p.note}</p>
              </div>
              <a
                href={`mailto:${HEAD_OFFICE.emails[1]}?subject=${encodeURIComponent(`Enquiry: ${p.name}`)}`}
                class="link-brass col-start-2 mt-2 inline-flex min-h-11 items-center text-sm font-semibold sm:col-start-3 sm:mt-0"
                aria-label={`Ask about ${p.name}`}
              >
                Ask about this
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-xs text-steel">Placeholder list for layout; full range, sizes and specifications to be confirmed.</p>
    </div>

    <aside class="md:col-span-4 md:col-start-9" aria-labelledby="enquire-title">
      <div class="sticky top-24 border border-graphite-2 bg-graphite p-6">
        <p class="eyebrow">Trade & household enquiries</p>
        <h2 id="enquire-title" class="mt-3 text-3xl">See it at the showroom</h2>
        <p class="mt-3 text-sm leading-relaxed text-steel">
          {SHOWROOM.label}<br />{SHOWROOM.street}, Kampala
        </p>
        <div class="mt-6 flex flex-col gap-3">
          <a href={`tel:${SHOWROOM.phones[1].tel}`} class="btn btn-brass">Call {SHOWROOM.phones[1].display}</a>
          <a href={`mailto:${HEAD_OFFICE.emails[1]}?subject=${mailSubject}`} class="btn btn-ghost">Email for a quote</a>
        </div>
        <p class="mt-5 border-t border-graphite-2 pt-4 text-xs leading-relaxed text-steel">
          ISO 9001:2015 certified quality management. Products certified by UNBS.
        </p>
      </div>
    </aside>
  </section>

  <section class="border-t border-graphite-2 bg-night py-16 md:py-24" aria-labelledby="more-title">
    <div class="wrap">
      <p class="eyebrow">Continue the tour</p>
      <h2 id="more-title" class="mt-3 mb-10 text-4xl md:text-5xl">Other exhibits</h2>
      <ul class="rail" role="list">
        {others.map((o) => <li class="flex"><PlinthCard category={o} /></li>)}
      </ul>
    </div>
  </section>
</Layout>
