---
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import SectionHead from '../../components/SectionHead.astro';
import Layout from '../../layouts/Layout.astro';
import { SALES_EMAIL, SALES_HOTLINE, SHOWROOM, SITE_URL } from '../../config';
import { categories, type Category } from '../../data/categories';

export const getStaticPaths = (() =>
  categories.map((c, i) => ({
    params: { slug: c.slug },
    props: {
      category: c,
      prev: categories[(i + categories.length - 1) % categories.length],
      next: categories[(i + 1) % categories.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
  prev: Category;
  next: Category;
}

const { category: c, prev, next } = Astro.props;
const path = `/products/${c.slug}/`;
const crumbs = [
  { name: 'Products', href: '/products/' },
  { name: c.name, href: path },
];
const lineCount = c.groups.reduce((n, g) => n + g.lines.length, 0);
const mailto = (subject: string) =>
  `mailto:${SALES_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
    'Hello Multiple Industries,\n\nPlease send a quote for:\n- Item:\n- Size / quantity:\n- Delivery location:\n\nName:\nPhone:\n',
  )}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${c.name} | Multiple Industries`,
    url: new URL(path, SITE_URL).href,
    description: c.intro,
    isPartOf: { '@id': `${SITE_URL}/#org` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: c.groups
        .flatMap((g) => g.lines)
        .map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name })),
    },
  },
];
---

<Layout
  title={`${c.name}: ${c.summary.replace(/\.$/, '')}`}
  description={`${c.intro} Multiple Industries, Kampala, Uganda.`}
  breadcrumbs={crumbs}
  jsonLd={jsonLd}
>
  <div class="wrap pt-2">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, ...crumbs]} />
  </div>

  <!-- Category masthead: the number is the poster. -->
  <header class="border-b-2 border-ink">
    <div class="wrap grid gap-6 pt-2 pb-10 md:pb-14 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-4">
        <p class="label text-muted">Category {c.num} of 06</p>
        <p class="display mt-2 text-signal" style="font-size:clamp(9rem,46vw,22rem);font-stretch:62%;line-height:0.78" aria-hidden="true">
          {c.num}
        </p>
      </div>
      <div class="flex flex-col justify-end lg:col-span-8">
        <h1 class="display display-lg">{c.name}</h1>
        <p class="mt-5 max-w-[40rem] text-lg leading-relaxed">{c.intro}</p>
        <dl class="mt-8 grid grid-cols-2 border-t-2 border-ink text-sm sm:grid-cols-3">
          <div class="py-3 pr-3">
            <dt class="label text-muted">Product lines</dt>
            <dd class="display mt-1 text-[2rem]" style="font-stretch:66%">{String(lineCount).padStart(2, '0')}</dd>
          </div>
          <div class="border-l border-ink py-3 pl-3">
            <dt class="label text-muted">Groups</dt>
            <dd class="display mt-1 text-[2rem]" style="font-stretch:66%">{String(c.groups.length).padStart(2, '0')}</dd>
          </div>
          <div class="col-span-2 border-t border-ink py-3 sm:col-span-1 sm:border-t-0 sm:border-l sm:pl-3">
            <dt class="label text-muted">Bought by</dt>
            <dd class="mt-1 font-semibold">{c.buyers.join(' · ')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </header>

  <!-- Product index -->
  <section class="wrap grid gap-8 py-12 md:py-16 lg:grid-cols-12 lg:gap-6" aria-labelledby="lines-title">
    <div class="lg:col-span-3">
      <SectionHead letter="A" label="Product lines" />
      <h2 id="lines-title" class="sr-only">Product lines in {c.name}</h2>
      <p class="mt-4 max-w-[22rem] text-sm text-muted">
        Indicative list. Sizes, stock and prices from the sales team. <!-- TODO: confirm lines with the client. -->
      </p>
    </div>
    <div class="grid gap-x-6 gap-y-12 md:grid-cols-2 lg:col-span-9">
      {
        c.groups.map((g, gi) => (
          <section aria-labelledby={`g-${gi}`}>
            <div class="flex items-baseline justify-between gap-3 border-b-2 border-ink pb-2">
              <h3 id={`g-${gi}`} class="display text-[1.85rem] md:text-[2.25rem]" style="font-stretch:72%">
                {g.title}
              </h3>
              <span class="font-display text-lg font-bold text-signal" style="font-stretch:70%">
                {c.num}.{gi + 1}
              </span>
            </div>
            <ul class="ruled">
              {g.lines.map((l, li) => (
                <li class="grid grid-cols-[3rem_1fr] gap-2 py-3.5">
                  <span class="pt-0.5 text-sm font-semibold text-muted tabular-nums">
                    {c.num}.{gi + 1}.{li + 1}
                  </span>
                  <span>
                    <span class="block text-[1.0625rem] font-semibold leading-snug">{l.name}</span>
                    {l.note && <span class="mt-0.5 block text-sm text-muted">{l.note}</span>}
                  </span>
                </li>
              ))}
            </ul>
            <a href={mailto(`Quote request: ${g.title} (${c.name})`)} class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold underline decoration-signal decoration-2 hover:text-signal">
              Ask for a quote on {g.title.toLowerCase()} <Arrow class="h-4 w-4" />
            </a>
          </section>
        ))
      }
    </div>
  </section>

  <!-- Quote band -->
  <section class="on-signal bg-signal text-paper" aria-labelledby="quote-title">
    <div class="wrap grid gap-8 py-12 md:py-16 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <SectionHead letter="B" label="Quotes" inverse />
      </div>
      <div class="lg:col-span-9">
        <h2 id="quote-title" class="display display-lg">Need sizes or a price?</h2>
        <p class="mt-5 max-w-[38rem] text-lg leading-relaxed">
          Call the showroom or send your list. Visit us at {SHOWROOM.street}, Kampala.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${SALES_HOTLINE.tel}`} class="btn border-ink bg-ink text-paper hover:bg-paper hover:text-ink sm:min-w-72">
            Call {SALES_HOTLINE.display} <Arrow />
          </a>
          <a href={mailto(`Quote request: ${c.name}`)} class="btn border-paper text-paper hover:bg-paper hover:text-ink sm:min-w-72">
            Email a quote request <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Continue through the index -->
  <nav class="wrap py-12 pb-28 md:py-16" aria-labelledby="more-title">
    <SectionHead letter="C" label="Continue" />
    <h2 id="more-title" class="display display-sm mt-4 mb-6">More from the index</h2>
    <CategoryIndex items={categories} compact headingLevel="h3" current={c.slug} />
    <div class="mt-6 grid grid-cols-2 gap-3">
      <a href={`/products/${prev.slug}/`} class="btn btn-line" rel="prev">
        <span class="flex flex-col text-left"><span class="text-xs uppercase tracking-wider opacity-75">Previous</span>{prev.short}</span>
      </a>
      <a href={`/products/${next.slug}/`} class="btn btn-line" rel="next">
        <span class="flex flex-col text-left"><span class="text-xs uppercase tracking-wider opacity-75">Next</span>{next.short}</span>
        <Arrow />
      </a>
    </div>
  </nav>

  <!-- Sticky mobile call bar -->
  <div data-callbar class="on-signal fixed inset-x-0 bottom-0 z-30 border-t-2 border-ink bg-signal text-paper md:hidden">
    <div class="wrap grid grid-cols-[1fr_auto] items-center gap-3 py-2">
      <a href={`tel:${SALES_HOTLINE.tel}`} class="flex min-h-12 flex-col justify-center no-underline">
        <span class="text-xs font-semibold uppercase tracking-wider">Sales hotline</span>
        <span class="display text-[1.6rem]" style="font-stretch:70%">{SALES_HOTLINE.display}</span>
      </a>
      <a href={mailto(`Quote request: ${c.name}`)} class="inline-flex min-h-12 items-center bg-ink px-4 font-semibold text-paper no-underline">
        Email
      </a>
    </div>
  </div>
</Layout>
