---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { HEAD_OFFICE, SHOWROOM } from '../../config';
import { categories, type Category } from '../../data/categories';

export const getStaticPaths = (() =>
  categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }))) satisfies GetStaticPaths;

interface Props {
  category: Category;
}
const { category: c } = Astro.props;
const crumbs = [
  { name: 'Products', href: '/products/' },
  { name: c.name, href: `/products/${c.slug}/` },
];
const quoteHref = (item?: string) =>
  `mailto:${HEAD_OFFICE.emails[1]}?subject=${encodeURIComponent(`Quotation: ${item ?? c.name}`)}`;
const description = `${c.name} from Multiple Industries Limited, Kampala: ${c.short} Quality products, ISO 9001:2015 certified, supplied across Uganda and East Africa.`;
---

<Layout title={`${c.name} — Products`} description={description} crumbs={crumbs}>
  <section class="grid-paper border-b-2 border-ink" aria-labelledby="cat-h">
    <div class="wrap pt-4 pb-10 md:pb-14">
      <Breadcrumbs crumbs={crumbs} />
      <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="label mb-4 flex items-center gap-3">
            <span class="bg-ink px-2 py-1 text-paper">Division {c.no} / 06</span>
            <span class="text-ink-3">Product sheet</span>
          </p>
          <h1 id="cat-h" class="display text-6xl sm:text-7xl lg:text-8xl">{c.name}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">{c.intro}</p>
        </div>
        <div class="flex items-end justify-between gap-4 lg:col-span-4 lg:flex-col lg:items-end">
          <span class="display text-[7rem] leading-none text-plum sm:text-[9rem]" aria-hidden="true">{c.no}</span>
          <Icon name={c.icon} class="size-20 text-ink sm:size-24" />
        </div>
      </div>
    </div>
  </section>

  <div class="wrap grid gap-12 py-12 md:py-16 lg:grid-cols-12">
    <!-- Product schedule -->
    <section class="lg:col-span-8" aria-labelledby="sched-h">
      <div class="sec-head mb-6">
        <span class="label text-plum">Schedule {c.no}.A</span>
        <h2 id="sched-h" class="label text-ink-3">Product schedule</h2>
      </div>
      <p class="mb-6 border-l-4 border-signal bg-signal-soft px-4 py-3 text-sm text-ink">
        <strong>Placeholder list.</strong> Sizes, pressure classes and full catalogue to be confirmed — ask the sales desk
        for current stock.
      </p>

      <!-- Mobile: stacked spec cards; desktop: table rows -->
      <ol class="border-t-2 border-ink">
        <li class="label hidden grid-cols-[3rem_1.4fr_1fr_1.2fr_auto] gap-4 border-b-2 border-ink py-3 text-ink-3 md:grid" aria-hidden="true">
          <span>Ref</span><span>Product</span><span>Material / brand</span><span>Typical use</span><span class="w-28"></span>
        </li>
        {
          c.products.map((p, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 gap-y-1 border-b border-ink/30 py-4 md:grid-cols-[3rem_1.4fr_1fr_1.2fr_auto] md:items-center md:gap-4">
              <span class="label pt-1 text-plum md:pt-0">
                {c.no}.{String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="headline text-xl md:text-lg">{p.name}</h3>
              <p class="col-start-2 text-sm text-ink-2 md:col-start-auto">
                <span class="label mr-2 text-ink-3 md:hidden">Material</span>
                {p.material}
              </p>
              <p class="col-start-2 text-sm text-ink-2 md:col-start-auto">
                <span class="label mr-2 text-ink-3 md:hidden">Use</span>
                {p.use}
              </p>
              <a
                href={quoteHref(p.name)}
                class="label col-start-2 mt-2 inline-flex min-h-11 w-fit items-center gap-2 border-2 border-ink px-3 hover:bg-ink hover:text-paper md:col-start-auto md:mt-0 md:w-28 md:justify-center"
              >
                Quote <Icon name="arrow" class="size-4" />
              </a>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        <section aria-labelledby="app-h" class="border-2 border-ink bg-sheet p-6">
          <h2 id="app-h" class="label mb-4 text-plum">Applications</h2>
          <ul class="space-y-2">
            {
              c.applications.map((a) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" class="mt-0.5 size-5 shrink-0 text-plum" />
                  {a}
                </li>
              ))
            }
          </ul>
        </section>
        <section aria-labelledby="qa-h" class="border-2 border-ink bg-sheet p-6">
          <h2 id="qa-h" class="label mb-4 text-plum">Quality</h2>
          <p class="text-ink-2">
            Produced and supplied under our ISO 9001:2015 Quality Management System, with products certified by the
            Uganda National Bureau of Standards (UNBS).
          </p>
        </section>
      </div>

      {
        c.brands.length > 0 && (
          <section class="mt-12" aria-labelledby="cb-h">
            <h2 id="cb-h" class="label mb-4 text-ink-3">
              Related brands <span class="text-ink-3">(TODO: confirm)</span>
            </h2>
            <ul class="flex flex-wrap gap-2">
              {c.brands.map((b) => (
                <li class="headline border-2 border-ink bg-sheet px-3 py-2 uppercase">{b}</li>
              ))}
            </ul>
          </section>
        )
      }
    </section>

    <!-- Sidebar: enquiry -->
    <aside class="lg:col-span-4" aria-labelledby="enq-h">
      <div class="border-2 border-ink bg-sheet shadow-[6px_6px_0_var(--color-ink)] lg:sticky lg:top-32">
        <div class="on-dark bg-plum px-5 py-4 text-white">
          <p class="label text-signal">Enquiry</p>
          <h2 id="enq-h" class="headline mt-1 text-2xl">Need {c.name.toLowerCase()} for a project?</h2>
        </div>
        <div class="space-y-3 p-5">
          <p class="text-ink-2">Visit the showroom or call the sales desk for pricing and stock.</p>
          <a href={quoteHref()} class="btn btn-primary w-full">Email for a quote</a>
          {
            SHOWROOM.phones.slice(1).map((p) => (
              <a href={`tel:${p.tel}`} class="btn btn-ghost w-full justify-start">
                <Icon name="phone" class="size-5" /> {p.display}
              </a>
            ))
          }
          <p class="label pt-2 text-ink-3">Showroom: {SHOWROOM.street}</p>
        </div>
      </div>
    </aside>
  </div>

  <section class="wrap pb-14 md:pb-20" aria-labelledby="other-h">
    <div class="sec-head mb-8">
      <span class="label text-plum">Index</span>
      <h2 id="other-h" class="label text-ink-3">Other divisions</h2>
    </div>
    <CategoryIndex exclude={c.slug} />
  </section>

  <ContactCta subject={`Quotation: ${c.name}`} />
</Layout>
