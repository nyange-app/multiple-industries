---
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../../components/SectionHead.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
---

<Layout
  title="Products — Pipes, Plumbing, Building Materials & Plasticware"
  description="Browse Multiple Industries' six product divisions: water management, plumbing, bathroom & kitchen, building materials, domestic plasticware and automotive."
  breadcrumbs={[{ name: 'Products', href: '/products/' }]}
>
  <section class="grid-paper py-12 md:py-20">
    <div class="wrap">
      <SectionHead code="02" label="Catalogue index" title="Products" level="h1">
        <p class="mt-4 max-w-2xl text-lg text-steel">
          Six divisions covering the entire range of building materials, household products and automotive spare parts.
        </p>
      </SectionHead>
      <div class="mt-10"><CategoryGrid headingLevel="h2" /></div>
    </div>
  </section>
</Layout>
