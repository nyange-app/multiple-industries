---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AisleSign from '../../components/AisleSign.astro';
import ContactSign from '../../components/ContactSign.astro';
import { aisles } from '../../data/aisles';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
];
---

<Layout
  title="Products | Showroom Directory | Multiple Industries Kampala"
  description="Browse all six aisles: water management, plumbing, bathroom and kitchen, building materials, domestic plasticware and automotive. Multiple Industries, Kampala."
  breadcrumbs={crumbs}
>
  <section class="wrap pt-4 pb-16 md:pb-20" aria-labelledby="dir-heading">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow mt-6">Showroom directory</p>
    <h1 id="dir-heading" class="mt-3 text-4xl font-black sm:text-5xl">Products, aisle by aisle</h1>
    <p class="lede mt-4">Six product categories under one roof. Choose an aisle to see what is on the shelves.</p>
    <ul class="mt-6 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {aisles.map((a) => <li><AisleSign aisle={a} headingLevel="h2" /></li>)}
    </ul>
  </section>
  <ContactSign />
</Layout>
