---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryIndex from '../../components/CategoryIndex.astro';
import ContactCta from '../../components/ContactCta.astro';
const crumbs = [{ name: 'Products', href: '/products/' }];
---

<Layout
  title="Products"
  description="Six product divisions from Multiple Industries Limited: water management, plumbing, bathroom & kitchen, building materials, domestic plasticware and automotive."
  crumbs={crumbs}
>
  <section class="grid-paper border-b-2 border-ink">
    <div class="wrap pt-4 pb-10">
      <Breadcrumbs crumbs={crumbs} />
      <p class="label mt-6 mb-4 text-plum">Catalogue index &middot; 06 divisions</p>
      <h1 class="display text-6xl sm:text-7xl lg:text-8xl">Products</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-2">
        Diversified products covering the entire range of building materials, domestic household products and selected
        automotive lines — manufactured and supplied from Kampala.
      </p>
    </div>
  </section>
  <section class="wrap py-12 md:py-16" aria-label="Product divisions">
    <CategoryIndex headingLevel="h2" />
  </section>
  <ContactCta />
</Layout>
