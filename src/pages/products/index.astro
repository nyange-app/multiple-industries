---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { categories } from '../../data/categories';
const crumbs = [{ name: 'Products', href: '/products/' }];
---

<Layout
  title="Products — Pipes, Building Materials, Plasticware & Automotive"
  description="Browse the six product divisions of Multiple Industries Limited, Kampala: water management, plumbing, bathroom & kitchen, building materials, domestic plasticware and automotive."
  breadcrumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Catalogue · 6 divisions"
    title="Products"
    lead="Building materials, household plastics and automotive parts — manufactured and supplied from Kampala for the East African region."
  />
  <section class="wrap py-14 lg:py-20" aria-label="Product divisions">
    <ul class="grid gap-px border border-ink bg-ink sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <li class="bg-paper">
            <a href={`/products/${c.slug}/`} class="group flex h-full flex-col p-6 hover:bg-signal">
              <span class="flex items-center justify-between">
                <span class="flex size-12 items-center justify-center bg-ink text-signal">
                  <Icon name={c.icon} class="size-7" />
                </span>
                <span class="label text-steel group-hover:text-ink">Div. {c.code}</span>
              </span>
              <span class="display-md mt-8 text-3xl">{c.name}</span>
              <span class="mt-2 flex-1 text-steel group-hover:text-ink">{c.short}</span>
              <span class="label mt-6 inline-flex items-center gap-2">
                {c.products.length} lines <Icon name="arrow" class="size-4" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <ContactCTA />
</Layout>
