---
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
---
<Layout title="Products" description="Water management, plumbing, bathroom and kitchen, building materials, domestic plasticware and automotive products from Multiple Industries Limited." breadcrumbs={[{ name: 'Products', href: '/products' }]}>
  <PageHero eyebrow="Products" title="Everything for building, living and moving" lead="Six categories under one roof in Kampala." />
  <section class="section pt-6">
    <ul class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li><a href={`/products/${c.slug}`} class="card group flex h-full flex-col"><span class="icon-chip"><Icon name={c.icon} /></span><h2 class="mt-5 text-lg font-bold">{c.name}</h2><p class="mt-2 flex-1 text-sm text-muted">{c.short}</p><span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">View range<Icon name="arrow" class="h-4 w-4" /></span></a></li>
      ))}
    </ul>
  </section>
  <CtaBand />
</Layout>
