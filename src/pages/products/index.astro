---
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
---
<Layout title="Products" description="The Multiple Industries product index: water management, plumbing, bathroom and kitchen, building materials, domestic plasticware and automotive." crumbs={[{ name: 'Products', href: '/products' }]}>
  <section class="border-b border-ink">
    <div class="wrap py-12 md:py-20">
      <p class="eyebrow">The index</p>
      <h1 class="mt-3 text-5xl md:text-7xl">Products</h1>
      <p class="mt-6 max-w-2xl font-serif text-xl text-ink-soft md:text-2xl">Six categories covering the entire range of building materials, household products, automotive parts and irrigation.</p>
    </div>
  </section>
  <section class="wrap py-12 md:py-16">
    <ul>
      {categories.map((c) => (
        <li class="index-row">
          <a href={`/products/${c.slug}`} class="index-link group">
            <span class="numeral text-xl md:text-3xl">{c.no}</span>
            <span class="t font-serif text-2xl leading-tight md:text-4xl">{c.title}</span>
            <span class="col-start-2 text-sm text-ink-soft md:col-start-3 md:text-base">{c.short}</span>
            <span class="hidden text-xl text-clay md:block" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
