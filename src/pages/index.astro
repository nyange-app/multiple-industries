---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PipeDrawing from '../components/PipeDrawing.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import ContactCta from '../components/ContactCta.astro';
import Icon from '../components/Icon.astro';
import certs from '../assets/certifications.png';
import { HEAD_OFFICE, LEGAL_NAME, SHOWROOM, SITE_DESCRIPTION, SITE_URL } from '../config';
import { brands } from '../data/categories';

const orgId = `${SITE_URL}/#organization`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: LEGAL_NAME,
    alternateName: 'Multiple Industries',
    url: SITE_URL,
    logo: `${SITE_URL}/logo.png`,
    foundingDate: '1991',
    description: SITE_DESCRIPTION,
    email: HEAD_OFFICE.emails[0],
    telephone: '+256 414 236021',
    address: {
      '@type': 'PostalAddress',
      streetAddress: HEAD_OFFICE.street,
      postOfficeBoxNumber: '20166',
      addressLocality: 'Kampala',
      addressCountry: 'UG',
    },
    areaServed: 'East Africa',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE_URL}/#showroom`,
    name: `${LEGAL_NAME} — Sales Office & Showroom`,
    parentOrganization: { '@id': orgId },
    url: `${SITE_URL}/contact/`,
    image: `${SITE_URL}/og.png`,
    telephone: ['+256 414 236021', '+256 752 914 900', '+256 752 914 046'],
    email: SHOWROOM.emails[0],
    address: {
      '@type': 'PostalAddress',
      streetAddress: SHOWROOM.street,
      addressLocality: 'Kampala',
      addressCountry: 'UG',
    },
  },
];

const facts = [
  { k: '1991', v: 'Manufacturing & trading in Uganda' },
  { k: '06', v: 'Product divisions, one supplier' },
  { k: 'ISO', v: '9001:2015 quality management' },
  { k: 'UNBS', v: 'Products certified by the national bureau' },
];

const timeline = [
  { y: '1991', t: 'Founded in Kampala', d: 'Manufacturing and trading of building materials and domestic plasticware.' },
  { y: '2013', t: 'Automotive division', d: 'Fras-le brake lining & pads, Hanksugi truck tyres, Hengst fuel and air filters.' },
  { y: '2019', t: 'Inland Freight Services', d: 'Transport and logistics across the East African region.' },
  { y: 'Today', t: 'ISO 9001:2015', d: 'Certified quality management; products certified by UNBS.' },
];
---

<Layout description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="grid-paper relative overflow-hidden border-b-2 border-ink" aria-labelledby="hero-h">
    <div class="wrap grid gap-8 pt-8 pb-10 md:pt-12 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-16 lg:pb-16">
      <div class="lg:col-span-7">
        <p class="label mb-5 inline-flex items-center gap-2 border-2 border-ink bg-sheet px-2.5 py-1.5">
          <span class="size-2 bg-plum" aria-hidden="true"></span>
          Kampala, Uganda &middot; Est. 1991
        </p>
        <h1 id="hero-h" class="display text-[3.4rem] sm:text-7xl xl:text-[6.5rem]">
          Quality building materials <span class="bg-signal px-1 box-decoration-clone">you can trust</span> since 1991
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2">
          Manufacturers of UPVC, HDPE and PP-R water pipes, drinking straws and household plastics — and a one-stop
          supplier of building materials, automotive spare parts and irrigation systems for East Africa.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/products/" class="btn btn-primary">
            Browse the six divisions <Icon name="arrow" class="size-5" />
          </a>
          <a href={`tel:${SHOWROOM.phones[1].tel}`} class="btn btn-ghost bg-sheet">
            <Icon name="phone" class="size-5" /> Call {SHOWROOM.phones[1].display}
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <PipeDrawing class="mx-auto h-auto w-full max-w-[30rem]" />
      </div>
    </div>

    <!-- facts strip -->
    <dl class="wrap grid grid-cols-2 border-t-2 border-ink lg:grid-cols-4">
      {
        facts.map((f, i) => (
          <div
            class:list={[
              'border-ink py-4 pr-3',
              i % 2 === 1 && 'border-l-2 pl-4',
              i >= 2 && 'border-t-2 lg:border-t-0',
              i === 2 && 'lg:border-l-2 lg:pl-4',
            ]}
          >
            <dt class="display text-4xl text-plum sm:text-5xl">{f.k}</dt>
            <dd class="mt-1 text-sm leading-snug text-ink-2">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- PRODUCT DIVISIONS -->
  <section class="wrap py-14 md:py-20" aria-labelledby="div-h">
    <div class="sec-head mb-8">
      <span class="label text-plum">Sheet 01</span>
      <span class="label text-ink-3">Product divisions</span>
    </div>
    <div class="mb-10 grid gap-4 md:grid-cols-12 md:items-end">
      <h2 id="div-h" class="display text-5xl sm:text-6xl md:col-span-7">One stop for the whole building</h2>
      <p class="text-lg text-ink-2 md:col-span-5">
        Multiple Industries has always tried to offer a one stop service with diversified products covering the entire
        range of building materials, full range of domestic household products, automotive spare parts and transport
        services in the East African Region.
      </p>
    </div>
    <CategoryIndex />
  </section>

  <!-- ABOUT / TIMELINE -->
  <section class="border-y-2 border-ink bg-sheet" aria-labelledby="about-h">
    <div class="wrap py-14 md:py-20">
      <div class="sec-head mb-8">
        <span class="label text-plum">Sheet 02</span>
        <span class="label text-ink-3">About the company</span>
      </div>
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="about-h" class="display text-5xl sm:text-6xl">Made in Kampala. Supplied across East Africa.</h2>
          <p class="mt-6 text-lg leading-relaxed text-ink-2">
            Since 1991 we have led the manufacturing and trading of domestic and industrial building materials, domestic
            plasticware, automotive spare parts and transport services in Uganda — from plastic pipes to concrete
            products, plumbing, gutters, steel roof trusses, kitchens, bathrooms and roofing.
          </p>
          <a href="/about/" class="btn btn-ghost mt-8">Read our story <Icon name="arrow" class="size-5" /></a>
        </div>
        <ol class="lg:col-span-7">
          {
            timeline.map((e) => (
              <li class="ticks grid grid-cols-[5.5rem_1fr] gap-4 border-t-2 border-ink py-5 sm:grid-cols-[8rem_1fr]">
                <span class="display text-4xl text-plum sm:text-5xl">{e.y}</span>
                <div>
                  <h3 class="headline text-xl">{e.t}</h3>
                  <p class="mt-1 text-ink-2">{e.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- QUALITY / ISO -->
  <section class="on-dark grid-dark bg-plum-ink text-paper" aria-labelledby="q-h">
    <div class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <div class="mb-8 flex items-baseline gap-3 border-t-2 border-paper pt-3">
          <span class="label text-signal">Sheet 03</span>
          <span class="label text-paper/75">Quality policy</span>
        </div>
        <h2 id="q-h" class="display text-5xl sm:text-6xl">
          Certified to <span class="text-signal">ISO 9001:2015</span>
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-paper/85">
          We manufacture and supply quality UPVC, HDPE and PP-R pipes in all sizes, drinking straws, domestic plastics,
          irrigation systems and building materials as a single stop for building and construction — working to a
          Quality Management System in accordance with ISO 9001:2015, with products certified by the Uganda National
          Bureau of Standards.
        </p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            ['Food-grade raw materials for plasticware', 'UNBS certified products', 'Pipes manufactured in all sizes', 'Aiming to lead in Uganda & the EAC'].map((t) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-0.5 size-6 shrink-0 text-signal" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="lg:col-span-5">
        <div class="border-2 border-paper bg-white p-5 shadow-[8px_8px_0_var(--color-signal)]">
          <Image
            src={certs}
            alt="UNBS Q-mark and ISO 9001:2015 Certified Company badge"
            width={440}
            densities={[1, 2]}
            class="mx-auto h-auto w-full max-w-sm"
          />
        </div>
        <figcaption class="label mt-4 text-paper/75">Fig. 3 — Certification marks</figcaption>
      </figure>
    </div>
  </section>

  <!-- MISSION / VISION -->
  <section class="wrap py-14 md:py-20" aria-labelledby="mv-h">
    <div class="sec-head mb-8">
      <span class="label text-plum">Sheet 04</span>
      <h2 id="mv-h" class="label text-ink-3">Mission &amp; vision</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      <article class="border-2 border-ink bg-sheet p-6 sm:p-8">
        <h3 class="label mb-4 inline-block bg-ink px-2 py-1 text-paper">Vision</h3>
        <p class="headline text-3xl sm:text-4xl">
          To be the most preferred one stop source for quality building materials, general household items, selected
          automotive, irrigation and water management systems.
        </p>
      </article>
      <article class="border-2 border-ink bg-paper-2 p-6 sm:p-8">
        <h3 class="label mb-4 inline-block bg-plum px-2 py-1 text-white">Mission</h3>
        <p class="text-lg leading-relaxed text-ink-2">
          Having a competent, experienced and motivated team, and continual interactions with our customers and other
          interested parties, we will manufacture and sell top quality plastic products, and supply reliable building
          materials, selected automotive products, irrigation systems to satisfy and exceed customer requirements and
          increase shareholder value while maintaining a sustainable environment.
        </p>
      </article>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="border-t-2 border-ink bg-paper-2" aria-labelledby="br-h">
    <div class="wrap py-14 md:py-16">
      <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="label mb-2 text-plum">Sheet 05</p>
          <h2 id="br-h" class="display text-4xl sm:text-5xl">Brands &amp; partners</h2>
        </div>
        <p class="label text-ink-3">Logo tiles are placeholders</p>
      </div>
      <!-- TODO: confirm brand/partner list with Multiple Industries and replace text tiles with supplied logos -->
      <ul class="grid grid-cols-2 border-t-2 border-l-2 border-ink sm:grid-cols-3 lg:grid-cols-6">
        {
          brands.map((b) => (
            <li class="flex min-h-24 items-center justify-center border-r-2 border-b-2 border-ink bg-sheet px-3 text-center">
              <span class="headline text-xl tracking-wide uppercase">{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCta />
</Layout>
