---
import Layout from '../layouts/Layout.astro';
import PipeArt from '../components/PipeArt.astro';
import { Image } from 'astro:assets';
import iso from '../assets/iso.png';
import { SITE_URL, SITE_LEGAL_NAME, SITE_DESCRIPTION } from '../config';
import { categories } from '../data/categories';
import { contact, intro, mission, vision, timeline, brands } from '../data/site';

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${SITE_URL}/#organization`,
  name: SITE_LEGAL_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/favicon.svg`,
  description: SITE_DESCRIPTION,
  foundingDate: '1991',
  email: 'sales@multipleindustries.com',
  telephone: '+256414236021',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot 714/715, 8th Street, Industrial Area, P.O. Box 20166',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
  areaServed: 'East Africa',
  location: [
    { '@type': 'Place', name: 'Head office & factory', address: 'Plot 714/715, 8th Street, Industrial Area, Kampala, Uganda' },
    { '@type': 'Place', name: 'Sales office & showroom', address: 'Plot 13/23, 8th Street, Industrial Area, Kampala, Uganda' },
  ],
};
---

<Layout description={SITE_DESCRIPTION} jsonLd={[org]}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-ink">
    <div class="wrap grid gap-8 py-12 md:grid-cols-12 md:gap-10 md:py-24">
      <div class="md:col-span-8">
        <p class="eyebrow">Kampala, Uganda &middot; Est. 1991</p>
        <h1 class="mt-5 text-[2.9rem] leading-[0.98] xs:text-6xl md:text-[5.5rem]">
          Quality building materials you can <em class="text-clay">trust</em>, since&nbsp;1991.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
          Manufacturers of UPVC, HDPE and PP-R pipes, drinking straws and household plastics, and suppliers of building materials, automotive parts and irrigation systems to East&nbsp;Africa.
        </p>
        <div class="mt-9 flex flex-col gap-3 xs:flex-row">
          <a href="/products" class="btn btn-clay">Browse the index</a>
          <a href="/contact" class="btn">Talk to sales</a>
        </div>
      </div>
      <div class="relative md:col-span-4">
        <PipeArt class="mx-auto w-48 text-ink md:absolute md:-right-24 md:-top-8 md:w-[26rem] md:opacity-90" />
        <div class="relative mt-6 border-t border-ink pt-4 md:mt-72">
          <p class="font-serif text-7xl italic leading-none text-clay md:text-8xl">1991</p>
          <p class="mt-2 text-sm text-ink-soft">the year we began manufacturing and trading building materials in Uganda.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="border-b border-rule">
    <div class="wrap grid gap-10 py-16 md:grid-cols-12 md:py-24">
      <div class="md:col-span-4">
        <p class="eyebrow">The house</p>
        <h2 class="mt-3 text-4xl md:text-5xl">A one-stop house, built over three decades.</h2>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        <p class="font-serif text-2xl leading-snug md:text-[1.75rem]">{intro}</p>
        <ol class="mt-10">
          {timeline.map((t) => (
            <li class="index-row grid grid-cols-[4.5rem_1fr] gap-4 py-5 md:grid-cols-[6rem_1fr]">
              <span class="numeral text-3xl md:text-4xl">{t.year}</span>
              <span class="text-ink-soft">{t.text}</span>
            </li>
          ))}
        </ol>
        <a href="/about" class="link-u mt-6 inline-flex min-h-11 items-center font-semibold">Read our story</a>
      </div>
    </div>
  </section>

  <!-- CATEGORY INDEX -->
  <section id="products" class="border-b border-rule">
    <div class="wrap py-16 md:py-24">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">The index</p>
          <h2 class="mt-3 text-4xl md:text-6xl">Six categories.<br />One catalogue.</h2>
        </div>
        <p class="max-w-xs text-sm text-ink-soft">Product listings below are placeholders pending the full catalogue.</p>
      </div>
      <ul class="mt-12">
        {categories.map((c) => (
          <li class="index-row">
            <a href={`/products/${c.slug}`} class="index-link group">
              <span class="numeral text-xl md:text-3xl">{c.no}</span>
              <span class="t font-serif text-2xl leading-tight md:text-4xl">{c.title}</span>
              <span class="col-start-2 text-sm text-ink-soft md:col-start-3 md:text-base">{c.short}</span>
              <span class="hidden text-xl text-clay md:block" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WHY US / ISO -->
  <section class="on-ink bg-ink text-paper">
    <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-24">
      <div class="md:col-span-5">
        <p class="eyebrow">Why Multiple Industries</p>
        <h2 class="mt-3 text-4xl md:text-5xl">Made, not merely sold.</h2>
        <div class="mt-8 inline-block bg-paper p-3">
          <Image src={iso} alt="ISO 9001:2015 certification badge" width={150} class="h-auto w-32" />
        </div>
      </div>
      <dl class="md:col-span-7">
        {[
          ['ISO 9001:2015', 'A Quality Management System in accordance with ISO 9001:2015 governs how we manufacture and supply.'],
          ['UNBS certified', 'Our products are certified by the Uganda National Bureau of Standards.'],
          ['Food-grade inputs', 'Domestic plasticware is made from food-grade raw materials.'],
          ['One stop', 'Pipes to concrete, plumbing to roofing, plus automotive and transport, under one roof.'],
        ].map(([t, d], i) => (
          <div class="grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 border-t border-ink-rule py-6 md:grid-cols-[3.5rem_14rem_1fr]">
            <span class="numeral text-xl text-[#f0b9a2]">{String(i + 1).padStart(2, '0')}</span>
            <dt class="font-serif text-2xl">{t}</dt>
            <dd class="col-start-2 text-paper/75 md:col-start-3">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- MISSION / VISION -->
  <section class="border-b border-rule">
    <div class="wrap grid gap-12 py-16 md:grid-cols-2 md:gap-16 md:py-24">
      <article>
        <p class="eyebrow">Our vision</p>
        <p class="mt-4 font-serif text-3xl leading-tight md:text-4xl">&ldquo;{vision}&rdquo;</p>
      </article>
      <article class="md:border-l md:border-rule md:pl-16">
        <p class="eyebrow">Our mission</p>
        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">{mission}</p>
      </article>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="border-b border-rule bg-paper-deep">
    <div class="wrap py-14 md:py-20">
      <div class="flex flex-col justify-between gap-2 md:flex-row md:items-baseline">
        <h2 class="text-3xl md:text-4xl">Brands &amp; partners</h2>
        <p class="text-sm text-ink-soft">TODO: confirm list and add approved logos.</p>
      </div>
      <ul class="mt-8 grid grid-cols-2 border-l border-t border-rule sm:grid-cols-3 md:grid-cols-5">
        {brands.map((b) => (
          <li class="flex h-20 items-center justify-center border-b border-r border-rule font-serif text-lg italic text-ink-soft">{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="bg-clay text-white">
    <div class="wrap grid gap-8 py-16 md:grid-cols-12 md:items-end md:py-20">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/85">Visit, call or write</p>
        <h2 class="mt-3 text-4xl md:text-6xl">Let&rsquo;s specify your next project.</h2>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a href={`tel:${contact.head.phones[0].href}`} class="block font-serif text-3xl underline decoration-white/50 underline-offset-8">{contact.head.phones[0].display}</a>
        <a href="/contact" class="btn mt-6 !border-white !text-white hover:!bg-white hover:!text-clay-dark">Offices &amp; enquiries</a>
      </div>
    </div>
  </section>
</Layout>
