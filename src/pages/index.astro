---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PlinthCard from '../components/PlinthCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ExhibitObject from '../components/ExhibitObject.astro';
import certs from '../assets/certs.webp';
import { HEAD_OFFICE, SHOWROOM, SITE_DESCRIPTION, SITE_LEGAL_NAME, SITE_NAME, SITE_URL } from '../config';
import { categories } from '../data/categories';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#org`,
  name: SITE_LEGAL_NAME,
  alternateName: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/og.png`,
  foundingDate: '1991',
  slogan: 'Quality Building Materials You Can Trust Since 1991',
  email: HEAD_OFFICE.emails[1],
  telephone: HEAD_OFFICE.phones[0].tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: HEAD_OFFICE.street,
    postOfficeBoxNumber: '20166',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
};
const localLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE_URL}/#showroom`,
  name: `${SITE_NAME}: ${SHOWROOM.label}`,
  parentOrganization: { '@id': `${SITE_URL}/#org` },
  url: `${SITE_URL}/contact/`,
  image: `${SITE_URL}/og.png`,
  telephone: SHOWROOM.phones.map((p) => p.tel),
  email: SHOWROOM.emails[0],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SHOWROOM.street,
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
  areaServed: ['Uganda', 'East Africa'],
};

const brands = ['Wavin', 'Franke', 'Vado', 'Fras-le', 'Conmix', 'Tegra', 'Feroof', 'Smartframe', 'Polynum', 'Apex', 'PEX', 'Veer'];
const milestones = [
  { year: '1991', text: 'Manufacturing and trading of building materials and plasticware begins in Kampala.' },
  { year: '2013', text: 'Automotive division opens: Fras-le, Hanksugi and Hengst.' },
  { year: '2019', text: 'Inland Freight Services adds transport and logistics across East Africa.' },
];
---

<Layout
  title="Multiple Industries | Quality Building Materials You Can Trust Since 1991"
  description={SITE_DESCRIPTION}
  jsonLd={[orgLd, localLd]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-graphite-2" aria-labelledby="hero-title">
    <div class="wrap grid items-end gap-6 pt-12 md:grid-cols-12 md:gap-10 md:pt-20">
      <div class="relative z-10 md:col-span-7 md:pb-24">
        <p class="eyebrow">Kampala · Since 1991 · East Africa</p>
        <h1 id="hero-title" class="mt-5 text-[3.4rem] leading-[0.98] sm:text-7xl lg:text-[6.4rem]">
          Quality building materials you can <em class="text-brass">trust.</em>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porcelain-dim">
          Plastic pipes made in Kampala, plus building materials, household plasticware, irrigation
          systems and automotive parts, all from one supplier since 1991.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#collection" class="btn btn-brass">Explore the collection</a>
          <a href="/contact/" class="btn btn-ghost">Visit the showroom</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="stage on flex aspect-[1/1.05] flex-col justify-end md:aspect-[4/5]">
          <ExhibitObject kind="tap" class="relative z-10 mx-auto -mb-3 w-[72%]" />
          <div class="plinth"></div>
          <p class="absolute top-5 right-5 text-right text-[0.7rem] font-bold tracking-[0.2em] text-steel uppercase">
            Exhibit No. 01<br /><span class="text-porcelain-dim">Water Management</span>
          </p>
        </div>
      </div>
    </div>
    <!-- credentials strip -->
    <div class="border-t border-graphite-2 bg-night">
      <div class="wrap">
        <ul class="grid grid-cols-2 gap-px bg-graphite-2 text-sm md:grid-cols-4">
          {
            [
              ['ISO 9001:2015', 'Certified quality management'],
              ['UNBS', 'Certified products'],
              ['Est. 1991', 'Manufacturing in Kampala'],
              ['One stop', 'Six divisions, one supplier'],
            ].map(([a, b]) => (
              <li class="bg-night py-5 pr-3 pl-4 first:pl-0 md:[&:nth-child(3)]:pl-4 [&:nth-child(3)]:pl-0">
                <p class="font-serif text-2xl text-porcelain">{a}</p>
                <p class="mt-1 text-steel">{b}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="wrap py-20 md:py-28" aria-labelledby="about-title">
    <div class="grid gap-12 md:grid-cols-12">
      <SectionHead eyebrow="The house" title="One stop, since 1991." id="about-title" class="md:col-span-5" />
      <div class="md:col-span-7">
        <p class="font-serif text-[1.75rem] leading-snug text-porcelain md:text-4xl">
          “Multiple Industries has always tried to offer a one stop service with diversified products covering
          the entire range of building materials, full range of domestic household products, automotive spare
          parts and transport services in the East African Region.”
        </p>
        <ol class="mt-12 grid gap-px border border-graphite-2 bg-graphite-2 sm:grid-cols-3">
          {
            milestones.map((m) => (
              <li class="bg-charcoal p-5">
                <p class="font-serif text-4xl text-brass">{m.year}</p>
                <p class="mt-2 text-sm leading-relaxed text-steel">{m.text}</p>
              </li>
            ))
          }
        </ol>
        <a href="/about/" class="link-brass mt-8 inline-flex min-h-11 items-center font-semibold">Read our story</a>
      </div>
    </div>
  </section>

  <!-- COLLECTION -->
  <section id="collection" class="border-y border-graphite-2 bg-night py-20 md:py-28" aria-labelledby="collection-title">
    <div class="wrap">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHead eyebrow="The collection" title="Six exhibits, one supplier." id="collection-title" />
        <p class="max-w-sm text-steel md:text-right">
          <span class="md:hidden">Swipe through the six divisions. </span>Each one is a full range you can see,
          order and collect in Kampala.
        </p>
      </div>
      <ul class="rail mt-12" role="list">
        {categories.map((c) => <li class="flex"><PlinthCard category={c} /></li>)}
      </ul>
    </div>
  </section>

  <!-- WHY US / CERTIFIED -->
  <section class="wrap py-20 md:py-28" aria-labelledby="why-title">
    <div class="grid items-center gap-12 md:grid-cols-12">
      <div class="md:col-span-6">
        <SectionHead eyebrow="Why Multiple Industries" title="Certified, not just claimed." id="why-title" />
        <ul class="mt-10 divide-y divide-graphite-2 border-y border-graphite-2">
          {
            [
              ['ISO 9001:2015', 'Our Quality Management System is certified to ISO 9001:2015.'],
              ['UNBS certified', 'Our products are certified by the Uganda National Bureau of Standards.'],
              ['Food-grade plastics', 'Household plasticware is made from food-grade raw materials.'],
              ['All sizes, one source', 'UPVC, HDPE and PP-R pipes in all sizes, alongside the rest of the build.'],
            ].map(([t, d]) => (
              <li class="grid gap-1 py-5 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <p class="font-serif text-2xl text-porcelain">{t}</p>
                <p class="text-steel">{d}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="md:col-span-5 md:col-start-8">
        <div class="is-lit">
          <div class="stage on p-8 pb-12">
            <div class="relative z-10 mx-auto max-w-sm bg-porcelain p-6 shadow-2xl shadow-black/60">
              <Image src={certs} alt="UNBS certification mark and ISO 9001:2015 Certified Company badge" width={560} class="h-auto w-full" loading="lazy" />
            </div>
          </div>
        </div>
        <figcaption class="mt-4 text-sm text-steel">On display: our UNBS and ISO 9001:2015 marks. <a href="/about/#certificates" class="link-brass">About our certificates</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- MISSION / VISION -->
  <section class="border-y border-graphite-2 bg-graphite" aria-labelledby="mv-title">
    <h2 id="mv-title" class="sr-only">Mission and vision</h2>
    <div class="wrap grid md:grid-cols-2">
      <div class="border-graphite-2 py-16 md:border-r md:py-20 md:pr-12">
        <p class="eyebrow">Our vision</p>
        <p class="mt-5 font-serif text-3xl leading-tight md:text-[2.6rem]">
          To be the most preferred one stop source for quality building materials, general household items, selected
          automotive, irrigation and water management systems.
        </p>
      </div>
      <div class="border-t border-graphite-2 py-16 md:border-t-0 md:py-20 md:pl-12">
        <p class="eyebrow">Our mission</p>
        <p class="mt-5 text-lg leading-relaxed text-porcelain-dim">
          Having a competent, experienced and motivated team, and continual interactions with our customers and other
          interested parties, we will manufacture and sell top quality plastic products, and supply reliable building
          materials, selected automotive products, irrigation systems to satisfy and exceed customer requirements and
          increase shareholder value while maintaining a sustainable environment.
        </p>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="wrap py-20 md:py-28" aria-labelledby="brands-title">
    <SectionHead eyebrow="Brands & partners" title="Names on the shelf." id="brands-title" />
    <!-- TODO: confirm brand/partner list and replace nameplates with approved logos. -->
    <ul class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" role="list">
      {brands.map((b) => <li class="nameplate">{b}</li>)}
    </ul>
    <p class="mt-4 text-xs text-steel">Brand list shown for layout. To be confirmed.</p>
  </section>

  <!-- CONTACT CTA -->
  <section class="wrap" aria-labelledby="visit-title">
    <div class="is-lit relative grid overflow-hidden border border-graphite-2 bg-graphite md:grid-cols-2">
      <div class="p-7 md:p-12">
        <p class="eyebrow">Visit the showroom</p>
        <h2 id="visit-title" class="mt-4 text-5xl md:text-6xl">See it in person on 8th Street.</h2>
        <p class="mt-5 max-w-md text-porcelain-dim">
          {SHOWROOM.label}, {SHOWROOM.street}, Kampala. Call ahead for trade quotes, stock and collection.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={`tel:${SHOWROOM.phones[1].tel}`} class="btn btn-brass">Call {SHOWROOM.phones[1].display}</a>
          <a href={`mailto:${HEAD_OFFICE.emails[1]}`} class="btn btn-ghost">Email sales</a>
        </div>
      </div>
      <div class="stage min-h-64 md:min-h-full" aria-hidden="true">
        <div class="absolute inset-0 flex items-end justify-center gap-6 pb-[12%]">
          <ExhibitObject kind="basin" class="relative z-10 w-[38%]" />
          <ExhibitObject kind="bucket" class="relative z-10 w-[34%]" />
        </div>
      </div>
    </div>
  </section>
</Layout>
