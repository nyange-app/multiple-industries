---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PipeArt from '../components/PipeArt.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactCTA from '../components/ContactCTA.astro';
import certs from '../assets/certs.png';
import { categories, brands } from '../data/categories';
import {
  INTRO, LEGAL_NAME, MISSION, OFFICES, PRIMARY_TEL, PRIMARY_TEL_DISPLAY, QUALITY_POLICY,
  SITE_DESCRIPTION, SITE_NAME, SITE_URL, VISION,
} from '../config';

const address = (o: typeof OFFICES.head | typeof OFFICES.showroom) => ({
  '@type': 'PostalAddress',
  streetAddress: o.street,
  postOfficeBoxNumber: o.pobox || undefined,
  addressLocality: o.city,
  addressCountry: 'UG',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#org`,
    name: LEGAL_NAME,
    alternateName: SITE_NAME,
    url: SITE_URL,
    logo: `${SITE_URL}/logo.png`,
    foundingDate: '1991',
    description: SITE_DESCRIPTION,
    email: 'response@multipleindustries.com',
    telephone: '+256414236021',
    address: address(OFFICES.head),
    areaServed: ['Uganda', 'East Africa'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    '@id': `${SITE_URL}/#showroom`,
    name: `${LEGAL_NAME} — ${OFFICES.showroom.label}`,
    parentOrganization: { '@id': `${SITE_URL}/#org` },
    url: SITE_URL,
    image: `${SITE_URL}/og.png`,
    telephone: '+256414236021',
    email: OFFICES.showroom.emails[0],
    address: address(OFFICES.showroom),
    areaServed: 'East Africa',
  },
];

const facts = [
  { k: '1991', v: 'Founded in Kampala' },
  { k: 'ISO 9001:2015', v: 'Quality management' },
  { k: 'UNBS', v: 'Certified products' },
  { k: '06', v: 'Product divisions' },
];

const timeline = [
  { y: '1991', t: 'Manufacturing & trading begins', d: 'Manufacturing and trading of building materials and plastics begins in Kampala.' },
  { y: '2013', t: 'Automotive division', d: 'Fras-le brake lining & pads, Hanksugi truck tyres, Hengst fuel and air filters.' },
  { y: '2019', t: 'Inland Freight Services', d: 'Transport & logistics across the East African region.' },
];

const reasons = [
  { t: 'Made in Kampala', d: 'UPVC, HDPE and PP-R pipes, drinking straws and household plastics manufactured at our own factory.' },
  { t: 'ISO 9001:2015', d: 'A certified Quality Management System across manufacturing and supply.' },
  { t: 'UNBS certified', d: 'Products certified by the Uganda National Bureau of Standards.' },
  { t: 'Food-grade raw materials', d: 'Plasticware for the home made from food-grade raw materials.' },
];
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="on-dark grid-blueprint relative overflow-hidden text-paper" aria-labelledby="hero-title">
    <div class="wrap grid gap-10 pt-10 pb-12 lg:grid-cols-12 lg:items-center lg:gap-8 lg:pt-16 lg:pb-20">
      <div class="lg:col-span-7">
        <p class="label flex items-center gap-3 text-fog">
          <span class="inline-block size-2 bg-signal" aria-hidden="true"></span>
          Manufacturer &amp; supplier · Kampala, Uganda
        </p>
        <h1 id="hero-title" class="display mt-5 text-[3.4rem] sm:text-7xl lg:text-[6.5rem]">
          Quality building materials <span class="text-signal">you can trust</span>
        </h1>
        <p class="label mt-5 inline-block border border-signal px-3 py-2 text-signal">Since 1991</p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-fog">{INTRO}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#catalogue" class="btn btn-signal">
            Browse the catalogue <Icon name="arrow" class="size-5" />
          </a>
          <a href={`tel:${PRIMARY_TEL}`} class="btn btn-line">
            <Icon name="phone" class="size-5" /> {PRIMARY_TEL_DISPLAY}
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="ticks mx-auto max-w-md p-4 text-ink-3 sm:p-6 lg:max-w-none">
          <PipeArt class="h-auto w-full" />
          <p class="label mt-3 flex justify-between text-fog">
            <span>Fig. 1 — Pipe ends</span><span>UPVC · HDPE · PP-R</span>
          </p>
        </div>
      </div>
    </div>

    <!-- fact strip -->
    <div class="border-t border-ink-3 bg-ink/80">
      <dl class="wrap grid grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f, i) => (
            <div
              class:list={[
                'flex flex-col-reverse gap-1 border-ink-3 py-5',
                i % 2 === 1 && 'border-l pl-4 lg:pl-6',
                i >= 2 && 'border-t lg:border-t-0',
                i === 2 && 'lg:border-l lg:pl-6',
              ]}
            >
              <dt class="label text-fog">{f.v}</dt>
              <dd class="display-md text-2xl text-paper sm:text-3xl">{f.k}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
  <div class="hazard" aria-hidden="true"></div>

  <!-- CATALOGUE -->
  <section id="catalogue" class="wrap py-16 lg:py-24" aria-labelledby="cat-title">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <SectionHead no="01" label="Catalogue" title="Six divisions.<br/>One supplier." id="cat-title" class="lg:col-span-7" />
      <p class="max-w-md text-lg text-steel lg:col-span-5 lg:justify-self-end">
        From the water main to the kitchen shelf to the truck on the road — a single stop for building and construction.
      </p>
    </div>

    <ol class="mt-10 border-b border-line lg:grid lg:grid-cols-2 lg:gap-x-10">
      {
        categories.map((c) => (
          <li>
            <a href={`/products/${c.slug}/`} class="cat-row group px-2 sm:px-3">
              <span class="flex items-center gap-3 self-start pt-1 sm:gap-4">
                <span class="label text-steel group-hover:text-ink">{c.code}</span>
                <span class="flex size-12 items-center justify-center border border-ink bg-paper group-hover:bg-ink group-hover:text-signal">
                  <Icon name={c.icon} class="size-7" />
                </span>
              </span>
              <span>
                <span class="display-md block text-2xl sm:text-3xl">{c.name}</span>
                <span class="mt-1 block text-steel group-hover:text-ink">{c.short}</span>
              </span>
              <Icon name="arrow" class="cat-arrow size-6 self-center" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ABOUT TEASER -->
  <section class="border-y border-line bg-paper-2 grid-paper" aria-labelledby="about-title">
    <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <SectionHead no="02" label="Company" title="A one-stop source since 1991" id="about-title" />
        <p class="mt-6 text-lg leading-relaxed">
          Since 1991 {LEGAL_NAME} has led the manufacturing and trading of domestic and industrial building
          materials, domestic plasticware, automotive spare parts and transport services in Uganda — from plastic pipes
          to concrete products, indoor and outdoor plumbing, rainwater gutters, Light Gauge Steel Frame roof trusses,
          kitchen &amp; bathroom and roofing solutions.
        </p>
        <a href="/about/" class="btn btn-ink mt-8">About the company <Icon name="arrow" class="size-5" /></a>
      </div>
      <ol class="relative lg:col-span-5 lg:col-start-8" aria-label="Company milestones">
        {
          timeline.map((m) => (
            <li class="relative grid grid-cols-[5.5rem_1fr] gap-4 border-t border-ink py-6 last:border-b">
              <span class="display text-4xl">{m.y}</span>
              <span>
                <span class="block text-lg font-bold">{m.t}</span>
                <span class="mt-1 block text-steel">{m.d}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- QUALITY -->
  <section class="on-dark bg-ink text-paper" aria-labelledby="quality-title">
    <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-7">
        <SectionHead no="03" label="Quality" title="Certified, not just claimed" id="quality-title" dark />
        <blockquote class="mt-8 border-l-4 border-signal pl-5 text-lg leading-relaxed text-fog">
          <p class="label mb-2 text-signal">Quality policy</p>
          <p>{QUALITY_POLICY}</p>
        </blockquote>
        <ul class="mt-10 grid gap-px bg-ink-3 sm:grid-cols-2">
          {
            reasons.map((r) => (
              <li class="bg-ink p-5">
                <Icon name="check" class="size-6 text-signal" />
                <p class="mt-3 text-lg font-bold">{r.t}</p>
                <p class="mt-1 text-fog">{r.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <figure class="ticks bg-white p-6 text-signal">
          <Image
            src={certs}
            alt="UNBS Q-mark and ISO 9001:2015 Certified Company badges"
            width={520}
            densities={[1, 2]}
            class="h-auto w-full"
          />
          <figcaption class="label mt-4 border-t border-line pt-3 text-steel">
            Uganda National Bureau of Standards · ISO 9001:2015
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- MISSION / VISION -->
  <section class="wrap py-16 lg:py-24" aria-labelledby="mv-title">
    <SectionHead no="04" label="Purpose" title="Mission &amp; vision" id="mv-title" />
    <div class="mt-10 grid gap-px border border-ink bg-ink lg:grid-cols-5">
      <article class="bg-paper p-6 sm:p-8 lg:col-span-3">
        <h3 class="label text-plum">Mission</h3>
        <p class="mt-4 text-lg leading-relaxed">{MISSION}</p>
      </article>
      <article class="bg-signal p-6 sm:p-8 lg:col-span-2">
        <h3 class="label">Vision</h3>
        <p class="display-md mt-4 text-3xl sm:text-4xl">{VISION}</p>
      </article>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="border-t border-line" aria-labelledby="brands-title">
    <div class="wrap py-16 lg:py-20">
      <SectionHead no="05" label="Brands & partners" title="Brands we carry" id="brands-title" />
      <!-- TODO: confirm brand list and replace text tiles with approved logo files -->
      <ul class="mt-10 grid grid-cols-3 gap-px border border-line bg-line sm:grid-cols-5">
        {
          brands.map((b) => (
            <li class="flex aspect-[3/2] items-center justify-center bg-paper p-2 text-center">
              <span class="display-md text-lg text-steel sm:text-xl">{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="label mt-3 text-steel">Logo artwork pending confirmation</p>
    </div>
  </section>

  <ContactCTA />
</Layout>
