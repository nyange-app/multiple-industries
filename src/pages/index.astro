---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PipeArt from '../components/PipeArt.astro';
import SectionHead from '../components/SectionHead.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import iso from '../assets/iso.png';
import { BRANDS, OFFICES, PRIMARY_TEL, SALES_EMAIL, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config';
import { categories } from '../data/categories';

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#org`,
  name: SITE_NAME,
  alternateName: 'Multiple Industries',
  url: SITE_URL,
  logo: `${SITE_URL}/logo.png`,
  foundingDate: '1991',
  slogan: SITE_TAGLINE,
  description: SITE_DESCRIPTION,
  email: SALES_EMAIL,
  telephone: '+256414236021',
  areaServed: 'East Africa',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot 714/715, 8th Street Industrial Area',
    postOfficeBoxNumber: '20166',
    addressLocality: 'Kampala',
    addressCountry: 'UG',
  },
};
const local = OFFICES.map((o) => ({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_URL}/contact/#${o.id}`,
  name: `${SITE_NAME} — ${o.name}`,
  parentOrganization: { '@id': `${SITE_URL}/#org` },
  url: `${SITE_URL}/contact/`,
  image: `${SITE_URL}/og.png`,
  telephone: o.phones.map((p) => p.tel),
  email: o.emails,
  address: {
    '@type': 'PostalAddress',
    streetAddress: o.street,
    addressLocality: o.city,
    addressCountry: 'UG',
  },
}));

const specs = [
  { k: 'Established', v: '1991' },
  { k: 'Quality system', v: 'ISO 9001:2015' },
  { k: 'Product approval', v: 'UNBS' },
  { k: 'Product divisions', v: String(categories.length) },
];
const timeline = [
  { y: '1991', t: 'Founded in Kampala — manufacturing and trading building materials and plasticware.' },
  { y: '2013', t: 'Automotive division: Fras-le brake lining & pads, Hanksugi truck tyres, Hengst filters.' },
  { y: '2019', t: 'Inland Freight Services — transport and logistics across East Africa.' },
];
const reasons = [
  'Quality Management System certified to ISO 9001:2015',
  'Products certified by the Uganda National Bureau of Standards (UNBS)',
  'Plasticware made from food-grade raw materials',
  'Pipes in all sizes — UPVC, HDPE and PP-R',
  'One stop: plumbing to roofing, kitchen to truck parts',
];
---

<Layout
  title={`${SITE_NAME} — Pipes, Plastics & Building Materials, Kampala`}
  description={SITE_DESCRIPTION}
  jsonLd={[org, ...local]}
>
  <!-- HERO -->
  <section class="grid-ink relative overflow-hidden bg-ink text-paper" aria-labelledby="hero-title">
    <div class="wrap grid items-center gap-8 pt-10 pb-8 md:pt-16 lg:grid-cols-12 lg:gap-6 lg:pt-20 lg:pb-14">
      <div class="lg:col-span-7">
        <p class="label flex flex-wrap items-center gap-x-3 gap-y-1 text-fog">
          <span class="bg-signal px-2 py-0.5 text-ink">Est. 1991</span>
          <span>Kampala · Uganda · East Africa</span>
        </p>
        <h1 id="hero-title" class="display mt-6 text-[3.1rem] text-balance sm:text-7xl lg:text-[5.5rem]">
          Quality building materials <span class="text-signal">you can trust</span> since 1991
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper/85">
          Manufacturer of UPVC, HDPE and PP-R pipes, drinking straws and household plastics — and
          a one stop supplier of building materials, irrigation systems and automotive spare parts.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/products/" class="btn btn-signal">
            Browse products <Icon name="arrow" class="size-5" />
          </a>
          <a href={`tel:${PRIMARY_TEL.tel}`} class="btn btn-line-dark">
            <Icon name="phone" class="size-5" /> Call sales
          </a>
        </div>
      </div>
      <div class="mx-auto w-full max-w-[19rem] sm:max-w-md lg:col-span-5 lg:max-w-none">
        <PipeArt class="h-auto w-full" />
      </div>
    </div>
    <div class="wrap"><div class="ticks text-paper"></div></div>
    <dl class="border-t border-paper/15">
      <div class="wrap grid grid-cols-2 lg:grid-cols-4">
        {
          specs.map((s, i) => (
            <div
              class:list={[
                'border-paper/15 py-5 pr-4',
                i % 2 === 1 && 'border-l pl-4',
                i >= 2 && 'border-t lg:border-t-0',
                i === 2 && 'lg:border-l lg:pl-4',
              ]}
            >
              <dt class="label text-fog">{s.k}</dt>
              <dd class="display-md mt-1 text-2xl text-paper sm:text-3xl">{s.v}</dd>
            </div>
          ))
        }
      </div>
    </dl>
  </section>

  <!-- ABOUT TEASER -->
  <section class="py-16 md:py-24" aria-labelledby="about-title">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHead code="01" label="Company profile" title="One stop. Building, home and road." id="about-title" />
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-3">
          Multiple Industries has always tried to offer a one stop service with diversified products
          covering the entire range of building materials, full range of domestic household products,
          automotive spare parts and transport services in the East African Region.
        </p>
        <a href="/about/" class="btn btn-line mt-8">About the company <Icon name="arrow" class="size-5" /></a>
      </div>
      <ol class="lg:col-span-5 lg:pt-12" aria-label="Milestones">
        {
          timeline.map((t) => (
            <li class="grid grid-cols-[5rem_1fr] gap-4 border-t border-rule py-5 last:border-b">
              <span class="display text-3xl text-plate">{t.y}</span>
              <span class="leading-snug text-steel">{t.t}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="grid-paper border-y border-rule bg-paper-2/50 py-16 md:py-24" aria-labelledby="range-title">
    <div class="wrap">
      <SectionHead code="02" label="Product range" title="Six divisions, one supplier" id="range-title">
        <p class="mt-4 max-w-2xl text-lg text-steel">
          Pick a division to see what we make in our factory and what we supply from trusted brands.
        </p>
      </SectionHead>
      <div class="mt-10">
        <CategoryGrid />
      </div>
    </div>
  </section>

  <!-- WHY US / ISO -->
  <section class="bg-signal py-16 text-ink md:py-24" aria-labelledby="quality-title">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <div class="border-t-2 border-ink pt-3">
          <p class="label"><span>§ 03</span>&ensp;Quality assurance</p>
          <h2 id="quality-title" class="display mt-5 text-4xl text-balance sm:text-5xl lg:text-6xl">
            Certified, tested, trusted on site
          </h2>
        </div>
        <ul class="mt-8 grid gap-px border-2 border-ink bg-ink sm:grid-cols-2">
          {
            reasons.map((r, i) => (
              <li class:list={['flex gap-3 bg-signal p-4 font-medium', i === reasons.length - 1 && 'sm:col-span-2']}>
                <Icon name="check" class="mt-0.5 size-5 shrink-0" />
                {r}
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="lg:col-span-5">
        <div class="border-2 border-ink bg-white p-6 shadow-[8px_8px_0_0_var(--color-ink)]">
          <Image
            src={iso}
            alt="UNBS Q-mark and ISO 9001:2015 Certified Company badges"
            widths={[320, 560]}
            sizes="(min-width: 1024px) 28rem, 90vw"
            class="mx-auto h-auto w-full max-w-sm"
          />
        </div>
        <figcaption class="label mt-4">
          Quality Management System in accordance with ISO 9001:2015
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- MISSION / VISION -->
  <section class="py-16 md:py-24" aria-labelledby="purpose-title">
    <div class="wrap">
      <SectionHead code="04" label="Purpose" title="Mission & vision" id="purpose-title" />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article class="relative border border-ink bg-card p-6 md:p-8">
          <p class="label absolute -top-3 left-5 bg-ink px-2 py-0.5 text-signal">Doc · Vision</p>
          <h3 class="sr-only">Vision</h3>
          <p class="display-md text-2xl text-balance md:text-3xl">
            To be the most preferred one stop source for quality building materials, general household
            items, selected automotive, irrigation and water management systems.
          </p>
        </article>
        <article class="relative border border-ink bg-card p-6 md:p-8">
          <p class="label absolute -top-3 left-5 bg-ink px-2 py-0.5 text-signal">Doc · Mission</p>
          <h3 class="sr-only">Mission</h3>
          <p class="leading-relaxed text-ink-3">
            Having a competent, experienced and motivated team, and continual interactions with our
            customers and other interested parties, we will manufacture and sell top quality plastic
            products, and supply reliable building materials, selected automotive products, irrigation
            systems to satisfy and exceed customer requirements and increase shareholder value while
            maintaining a sustainable environment.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="border-t border-rule pb-16 md:pb-24" aria-labelledby="brands-title">
    <div class="wrap pt-16 md:pt-24">
      <SectionHead code="05" label="Brands & partners" title="Brands we stock & partner with" id="brands-title" />
      <!-- TODO: confirm brand list with client and replace text tiles with licensed logos. -->
      <ul class="mt-10 grid grid-cols-3 gap-px border border-rule bg-rule sm:grid-cols-4 lg:grid-cols-7">
        {
          BRANDS.map((b) => (
            <li class="flex min-h-16 items-center justify-center bg-paper px-2 sm:min-h-20 text-center">
              <span class="display-md text-base text-steel sm:text-lg">{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="label mt-3 text-steel">Logo tiles pending — brand list to be confirmed.</p>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="bg-ink text-paper" aria-labelledby="cta-title">
    <div class="hazard h-3" aria-hidden="true"></div>
    <div class="wrap grid gap-10 py-16 md:py-20 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHead code="06" label="Get a quote" title="Talk to our sales desk" id="cta-title" dark>
          <p class="mt-5 max-w-md text-lg text-paper/85">
            Contractors, retailers and households — call, email or visit the showroom on 8th Street.
          </p>
        </SectionHead>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a href={`tel:${PRIMARY_TEL.tel}`} class="btn btn-signal">
            <Icon name="phone" class="size-5" /> {PRIMARY_TEL.display}
          </a>
          <a href={`mailto:${SALES_EMAIL}`} class="btn btn-line-dark">
            <Icon name="mail" class="size-5" /> Email sales
          </a>
        </div>
      </div>
      <div class="grid gap-px bg-paper/15 sm:grid-cols-2 lg:col-span-7">
        {
          OFFICES.map((o) => (
            <div class="bg-ink-2 p-6">
              <p class="label text-signal">{o.name}</p>
              <p class="mt-3 flex gap-2 text-paper/90">
                <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-fog" />
                <span>
                  {o.street}, {o.city}
                </span>
              </p>
              <ul class="mt-3">
                {o.phones.map((p) => (
                  <li>
                    <a href={`tel:${p.tel}`} class="flex min-h-11 items-center gap-3 hover:text-signal">
                      <span class="label w-20 text-fog">{p.label}</span>
                      <span class="font-semibold">{p.display}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
