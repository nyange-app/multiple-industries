---
import Arrow from '../components/Arrow.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import SectionHead from '../components/SectionHead.astro';
import Layout from '../layouts/Layout.astro';
import {
  BRANDS,
  HEAD_OFFICE,
  INTRO,
  LEGAL_NAME,
  MISSION,
  PRIMARY_PHONE,
  SALES_EMAIL,
  SALES_HOTLINE,
  SHOWROOM,
  SITE_DESCRIPTION,
  SITE_URL,
  VISION,
} from '../config';
import { categories } from '../data/categories';

const address = (o: typeof HEAD_OFFICE) => ({
  '@type': 'PostalAddress',
  streetAddress: o.street,
  postOfficeBoxNumber: o.box ? o.box.replace('P.O. Box ', '') : undefined,
  addressLocality: o.city,
  addressCountry: 'UG',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#org`,
    name: LEGAL_NAME,
    alternateName: 'Multiple Industries',
    url: SITE_URL,
    logo: `${SITE_URL}/og.png`,
    foundingDate: '1991',
    slogan: 'Quality Building Materials You Can Trust Since 1991',
    description: SITE_DESCRIPTION,
    email: SALES_EMAIL,
    telephone: PRIMARY_PHONE.tel,
    address: address(HEAD_OFFICE),
    areaServed: ['Uganda', 'East Africa'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE_URL}/#showroom`,
    name: `${LEGAL_NAME}: ${SHOWROOM.name}`,
    parentOrganization: { '@id': `${SITE_URL}/#org` },
    url: `${SITE_URL}/contact/`,
    image: `${SITE_URL}/og.png`,
    telephone: SHOWROOM.phones.map((p) => p.tel),
    email: SHOWROOM.emails[0],
    address: address(SHOWROOM),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${SITE_URL}/#factory`,
    name: `${LEGAL_NAME}: ${HEAD_OFFICE.name}`,
    parentOrganization: { '@id': `${SITE_URL}/#org` },
    url: SITE_URL,
    image: `${SITE_URL}/og.png`,
    telephone: PRIMARY_PHONE.tel,
    email: HEAD_OFFICE.emails[0],
    address: address(HEAD_OFFICE),
  },
];

const milestones = [
  { year: '1991', text: 'Founded in Kampala. Manufacturing and trading of building materials and domestic plasticware.' },
  { year: '2013', text: 'Automotive division: Fras-le brake lining and pads, Hanksugi truck tyres, Hengst fuel and air filters.' },
  { year: '2019', text: 'Inland Freight Services: transport and logistics across East Africa.' },
];

const reasons = [
  { k: 'One stop', v: 'Pipes, plumbing, kitchen and bath, building materials, plasticware and automotive parts on one order.' },
  { k: 'Made here', v: 'Plastic pipes and household plastics manufactured at our 8th Street factory in Kampala.' },
  { k: 'Food grade', v: 'Domestic plasticware made from food-grade raw materials.' },
];
---

<Layout description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- HERO: a poster. Type is the image. -->
  <section class="border-b-2 border-ink" aria-labelledby="hero-title">
    <div class="wrap pt-6 pb-10 md:pt-10 md:pb-16">
      <div class="label flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-ink pb-3 text-muted">
        <span>Multiple Industries Ltd &mdash; Kampala, Uganda</span>
        <span>ISO 9001:2015 &middot; UNBS certified</span>
      </div>
      <h1 id="hero-title" class="display display-xl mt-6 md:mt-10">
        Quality building materials you can trust <span class="text-signal">since&nbsp;1991.</span>
      </h1>
      <div class="mt-8 grid gap-8 md:mt-12 lg:grid-cols-12 lg:gap-6">
        <p class="max-w-[38rem] text-lg leading-relaxed lg:col-span-6 lg:col-start-1">
          {INTRO}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:col-start-8 lg:flex-col lg:self-end">
          <a href="#contents" class="btn btn-ink sm:flex-1">
            Browse the six categories <Arrow />
          </a>
          <a href={`tel:${SALES_HOTLINE.tel}`} class="btn btn-line sm:flex-1">
            Sales hotline {SALES_HOTLINE.display} <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- A. CONTENTS: the index -->
  <section id="contents" class="wrap py-12 md:py-20" aria-labelledby="contents-title">
    <div class="mb-6 flex items-end justify-between gap-4 md:mb-10">
      <div>
        <SectionHead letter="A" label="Contents" />
        <h2 id="contents-title" class="display display-md mt-4">Six categories</h2>
      </div>
      <a href="/products/" class="hidden min-h-11 items-center gap-2 font-semibold underline sm:inline-flex">
        All products <Arrow class="h-4 w-4" />
      </a>
    </div>
    <CategoryIndex items={categories} />
  </section>

  <!-- B. ABOUT -->
  <section class="border-t-2 border-ink" aria-labelledby="about-title">
    <div class="wrap grid gap-8 py-12 md:py-20 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <SectionHead letter="B" label="About" />
      </div>
      <div class="lg:col-span-9">
        <h2 id="about-title" class="sr-only">About Multiple Industries</h2>
        <p class="statement max-w-[52rem]">
          Since 1991 we have led the manufacturing and trading of domestic and industrial building materials, domestic
          plasticware, automotive spare parts and transport services in Uganda. <span class="text-muted"
            >From plastic pipes to concrete products, from the roof truss to the kitchen tap.</span
          >
        </p>
        <ol class="mt-10 grid border-t-2 border-ink sm:grid-cols-3">
          {
            milestones.map((m) => (
              <li class="border-b border-ink py-5 sm:border-b-0 sm:border-l sm:px-5 sm:first:border-l-0 sm:first:pl-0">
                <span class="display block text-[3.5rem] text-signal md:text-[4.5rem]" style="font-stretch:62%">
                  {m.year}
                </span>
                <span class="mt-2 block text-[0.9375rem] leading-snug">{m.text}</span>
              </li>
            ))
          }
        </ol>
        <a href="/about/" class="btn btn-line mt-8 w-full sm:w-auto">
          About the company <Arrow />
        </a>
      </div>
    </div>
  </section>

  <!-- C. QUALITY: the single full-bleed signal band -->
  <section class="on-signal bg-signal text-paper" aria-labelledby="quality-title">
    <div class="wrap grid gap-8 py-12 md:py-20 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <SectionHead letter="C" label="Quality" inverse />
      </div>
      <div class="lg:col-span-9">
        <h2 id="quality-title" class="display display-lg">
          ISO 9001:2015<span class="sr-only">.</span><br />
          <span class="text-ink">UNBS certified.</span>
        </h2>
        <p class="mt-6 max-w-[40rem] text-lg leading-relaxed">
          Our Quality Management System is certified to ISO 9001:2015, and our products are certified by the Uganda
          National Bureau of Standards.
        </p>
        <dl class="mt-10 grid border-t-2 border-paper md:grid-cols-3">
          {
            reasons.map((r) => (
              <div class="border-b border-paper/60 py-5 md:border-b-0 md:border-l md:px-5 md:first:border-l-0 md:first:pl-0">
                <dt class="display text-[2rem]" style="font-stretch:70%">
                  {r.k}
                </dt>
                <dd class="mt-2 text-[0.9375rem] leading-snug">{r.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-10 inline-flex items-center gap-4 bg-paper p-4 text-ink">
          <img
            src="/img/unbs-iso-9001.webp"
            width="230"
            height="126"
            loading="lazy"
            decoding="async"
            alt="UNBS Q-mark and ISO 9001:2015 Certified Company badges"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- D. PURPOSE: vision and mission as giant pull quotes -->
  <section aria-labelledby="purpose-title">
    <div class="wrap grid gap-8 py-12 md:py-20 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <SectionHead letter="D" label="Purpose" />
        <h2 id="purpose-title" class="sr-only">Vision and mission</h2>
      </div>
      <div class="lg:col-span-9">
        <figure>
          <figcaption class="label text-signal">Vision</figcaption>
          <blockquote class="display display-md mt-3 normal-case" style="line-height:0.95">
            &ldquo;{VISION}&rdquo;
          </blockquote>
        </figure>
        <figure class="mt-12 border-t-2 border-ink pt-6 md:mt-16">
          <figcaption class="label text-signal">Mission</figcaption>
          <blockquote class="statement mt-3 max-w-[54rem]">{MISSION}</blockquote>
        </figure>
      </div>
    </div>
  </section>

  <!-- E. BRANDS -->
  <section class="border-t-2 border-ink" aria-labelledby="brands-title">
    <div class="wrap grid gap-8 py-12 md:py-20 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-3">
        <SectionHead letter="E" label="Brands & partners" />
        <!-- TODO: confirm brand list with the client and replace names with mono logos. -->
      </div>
      <div class="lg:col-span-9">
        <h2 id="brands-title" class="display display-sm">Brands we make, stock and partner with</h2>
        <ul class="mt-8 grid grid-cols-2 border-t border-l border-ink sm:grid-cols-3 lg:grid-cols-4" aria-label="Brands (to be confirmed)">
          {
            BRANDS.map((b) => (
              <li class="flex min-h-20 items-center border-r border-b border-ink px-4 md:min-h-24">
                <span class="display text-[1.5rem] normal-case md:text-[1.9rem]" style="font-stretch:80%">
                  {b}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-sm text-muted">Brand names shown as text placeholders until logos are confirmed.</p>
      </div>
    </div>
  </section>

  <!-- F. CONTACT -->
  <section class="on-ink bg-ink text-paper" aria-labelledby="contact-title">
    <div class="wrap py-12 md:py-20">
      <SectionHead letter="F" label="Contact" inverse />
      <h2 id="contact-title" class="display display-xl mt-6">
        Call.<br />Write.<br /><span class="text-signal">Visit.</span>
      </h2>
      <ul class="mt-10 grid border-t-2 border-paper md:grid-cols-3">
        <li class="border-b border-paper/50 md:border-b-0 md:border-l md:first:border-l-0">
          <a href={`tel:${PRIMARY_PHONE.tel}`} class="group flex min-h-24 flex-col justify-center py-5 no-underline md:px-5 md:group-first:pl-0">
            <span class="label text-paper/75">Hotline</span>
            <span class="display mt-2 text-[2rem] group-hover:text-signal" style="font-stretch:70%">{PRIMARY_PHONE.display}</span>
          </a>
        </li>
        <li class="border-b border-paper/50 md:border-b-0 md:border-l">
          <a href={`mailto:${SALES_EMAIL}`} class="group flex min-h-24 flex-col justify-center py-5 no-underline md:px-5">
            <span class="label text-paper/75">Sales email</span>
            <span class="mt-2 text-[1.2rem] font-semibold break-all underline decoration-signal decoration-2 group-hover:decoration-paper">{SALES_EMAIL}</span>
          </a>
        </li>
        <li class="md:border-l">
          <a href="/contact/" class="group flex min-h-24 flex-col justify-center py-5 no-underline md:px-5">
            <span class="label text-paper/75">Showroom</span>
            <span class="mt-2 text-[1.2rem] font-semibold">{SHOWROOM.street}, Kampala</span>
            <span class="mt-1 inline-flex items-center gap-2 text-paper/80 group-hover:text-paper">
              Both offices and directions <Arrow class="h-4 w-4" />
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>
