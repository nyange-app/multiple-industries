---
import Layout from '../layouts/Layout.astro';
import Strata from '../components/Strata.astro';
import CoreSample from '../components/CoreSample.astro';
import CategoryIndex from '../components/CategoryIndex.astro';
import ContactColophon from '../components/ContactColophon.astro';
import { INTRO, MISSION, VISION, HOTLINE, BRANDS } from '../config';
import { categories } from '../data/categories';
import { organizationLd, localBusinessLd } from '../lib/seo';

const reasons = [
  {
    t: 'ISO 9001:2015',
    d: 'We work to a Quality Management System in accordance with ISO 9001:2015.',
  },
  {
    t: 'UNBS certified',
    d: 'Our products are certified by the Uganda National Bureau of Standards.',
  },
  {
    t: 'Food-grade plastics',
    d: 'Household plasticware is made from food-grade raw materials.',
  },
  {
    t: 'One stop',
    d: 'Pipes, plumbing, kitchens, roofing, plasticware and automotive parts from one supplier.',
  },
];
---

<Layout jsonLd={[organizationLd(), ...localBusinessLd()]}>
  <!-- 1 · Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Manufacturer &amp; supplier · Kampala, Uganda</p>
        <h1 id="hero-title" class="display-xl hero-title">
          Quality building materials you can <em class="wonk">trust</em>, since 1991.
        </h1>
        <p class="lede hero-lede">{INTRO}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#index">
            Browse the index
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
              ><path d="M12 4v15M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg
            >
          </a>
          <a class="btn btn-ghost" href={`tel:${HOTLINE.tel}`}>Call {HOTLINE.label}</a>
        </div>
      </div>
      <CoreSample />
    </div>
  </section>

  <Strata from="var(--color-parchment)" to="var(--color-clay)" variant={1} />

  <!-- 2 · The index -->
  <section id="index" class="clay" aria-labelledby="index-title">
    <div class="wrap section">
      <header class="sec-head">
        <p class="kicker kicker-clay">The Index · 01–06</p>
        <h2 id="index-title" class="display-lg">Six departments, <em class="wonk wonk-clay">one counter.</em></h2>
        <p class="sec-note">
          From the water main to the kitchen tap, the roof truss to the truck tyre. Pick a department to see the range.
        </p>
      </header>
      <CategoryIndex items={categories} />
    </div>
  </section>

  <Strata from="var(--color-clay)" to="var(--color-parchment)" variant={2} bands={['var(--color-murram-bright)', 'var(--color-sand)']} />

  <!-- 3 · About teaser -->
  <section aria-labelledby="about-title">
    <div class="wrap section about-grid">
      <div>
        <p class="kicker">Chapter one · About us</p>
        <h2 id="about-title" class="display-lg">From plastic pipes to concrete products.</h2>
      </div>
      <div class="prose-ed">
        <p class="dropcap">
          Since 1991, Multiple Industries has been leading the manufacturing and trading of domestic and industrial building
          materials, domestic plasticware, automotive spare parts and transport services in Uganda.
        </p>
        <p>
          In 2013 we opened an automotive division, and in 2019 Inland Freight Services brought transport and logistics
          across East Africa into the family.
        </p>
        <p class="more"><a class="ink-link" href="/about/">Read our story &rarr;</a></p>
      </div>
      <div class="ledger">
        <div>
          <h3 class="ledger-h">We manufacture</h3>
          <ul>
            <li>UPVC, HDPE &amp; PP-R water pipes</li>
            <li>Wrapped drinking straws</li>
            <li>Domestic household plastics</li>
          </ul>
        </div>
        <div>
          <h3 class="ledger-h">We supply</h3>
          <ul>
            <li>Building materials &amp; roofing</li>
            <li>Irrigation systems</li>
            <li>Automotive spare parts</li>
            <li>Transport &amp; logistics</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Why us / quality -->
  <section class="quality" aria-labelledby="quality-title">
    <div class="wrap section">
      <div class="rule" aria-hidden="true">✦</div>
      <div class="q-grid">
        <header>
          <p class="kicker">The standard</p>
          <h2 id="quality-title" class="display-lg">Certified, <em class="wonk">not just</em> claimed.</h2>
          <img
            class="marks"
            src="/unbs-iso-marks.webp"
            width="400"
            height="218"
            loading="lazy"
            decoding="async"
            alt="Uganda National Bureau of Standards Q-mark and ISO 9001:2015 certified company seal"
          />
        </header>
        <ol class="reasons">
          {
            reasons.map((r, i) => (
              <li>
                <span class="r-no" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{r.t}</h3>
                  <p>{r.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <Strata from="var(--color-parchment)" to="var(--color-paper)" variant={3} bands={['var(--color-clay)', 'var(--color-papyrus)']} />

  <!-- 5 · Mission & vision -->
  <section class="mv" aria-labelledby="vision-title">
    <div class="wrap section">
      <p class="kicker kicker-green">Our vision</p>
      <h2 id="vision-title" class="sr-only">Vision and mission</h2>
      <blockquote class="vision">
        <p>&ldquo;{VISION}&rdquo;</p>
      </blockquote>
      <div class="mission">
        <h3 class="kicker kicker-green">Our mission</h3>
        <p>{MISSION}</p>
      </div>
    </div>
  </section>

  <Strata from="var(--color-paper)" to="var(--color-parchment)" variant={1} bands={['var(--color-papyrus)', 'var(--color-sand)']} />

  <!-- 6 · Brands -->
  <section aria-labelledby="brands-title">
    <div class="wrap section brands">
      <p class="kicker">On our shelves</p>
      <h2 id="brands-title" class="display-md">Brands &amp; partners we work with</h2>
      <!-- TODO: confirm brand list and replace with approved logos -->
      <ul class="brand-roll">
        {BRANDS.map((b) => <li>{b}</li>)}
      </ul>
      <p class="note">Brand list to be confirmed. Logos coming soon.</p>
    </div>
  </section>

  <!-- 7 · Contact -->
  <ContactColophon />
</Layout>

<style>
  .hero {
    padding: 2.5rem 0 1.5rem;
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }
  .hero-title {
    margin-top: 1rem;
    max-width: 14ch;
  }
  .hero-lede {
    margin-top: 1.5rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .section {
    padding-block: 3rem;
  }
  .clay {
    background: var(--color-clay);
    --color-line: #c9ae90;
  }
  .kicker-clay,
  .wonk-clay {
    color: var(--color-murram-deep);
  }
  .sec-head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .sec-note {
    color: var(--color-muted);
    max-width: 34rem;
  }
  .about-grid {
    display: grid;
    gap: 1.75rem;
  }
  .more {
    margin-top: 1.25rem !important;
    font-weight: 600;
    color: var(--color-murram);
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .ledger {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
  }
  .ledger-h {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-papyrus);
    margin-bottom: 0.5rem;
  }
  .ledger ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ledger li {
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 0.98rem;
  }
  .quality .section {
    padding-top: 1rem;
  }
  .q-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  .marks {
    display: block;
    width: 12rem;
    height: auto;
    margin-top: 1.75rem;
    mix-blend-mode: multiply;
  }
  .reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .reasons li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.75rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-line);
  }
  .r-no {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 1.5rem;
    color: var(--color-murram);
    line-height: 1.1;
  }
  .reasons h3 {
    font-size: 1.4rem;
  }
  .reasons p {
    color: var(--color-muted);
    margin-top: 0.3rem;
  }
  .mv {
    background: var(--color-paper);
  }
  .kicker-green {
    color: var(--color-papyrus);
  }
  .vision {
    margin: 1rem 0 0;
    padding: 0;
  }
  .vision p {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-weight: 420;
    font-size: clamp(1.75rem, 6vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .mission {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-papyrus);
    max-width: 44rem;
  }
  .mission p {
    margin-top: 0.6rem;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
  }
  .brands h2 {
    margin-top: 0.5rem;
  }
  .brand-roll {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.4vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
  }
  .brand-roll li::after {
    content: '✦';
    font-size: 0.55em;
    color: var(--color-murram-bright);
    margin: 0 0.6em;
    vertical-align: 0.25em;
  }
  .brand-roll li:last-child::after {
    content: none;
  }
  .note {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-top: 4rem;
    }
    .section {
      padding-block: 4.5rem;
    }
    .sec-head {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      column-gap: 3rem;
    }
    .sec-head .kicker {
      grid-column: 1 / -1;
    }
    .q-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
    .reasons {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 4rem;
    }
    .about-grid {
      grid-template-columns: 1fr 1.1fr;
      column-gap: 4rem;
    }
    .ledger {
      grid-column: 2;
    }
    .mission {
      margin-left: auto;
    }
  }
</style>
