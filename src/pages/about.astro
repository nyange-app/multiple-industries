---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import iso from '../assets/iso.png';
import { intro, mission, vision, timeline } from '../data/site';
---
<Layout title="About Us" description="Since 1991 Multiple Industries has been a leading manufacturer and trader of building materials, plasticware, automotive spare parts and transport services in Uganda." crumbs={[{ name: 'About Us', href: '/about' }]}>
  <section class="border-b border-ink">
    <div class="wrap grid gap-8 py-12 md:grid-cols-12 md:py-24">
      <div class="md:col-span-8">
        <p class="eyebrow">About us</p>
        <h1 class="mt-3 text-5xl md:text-8xl">Since <em class="text-clay">1991</em>.</h1>
      </div>
      <p class="font-serif text-2xl leading-snug md:col-span-8 md:col-start-5 md:text-3xl">{intro}</p>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:py-20">
      <h2 class="text-3xl md:col-span-4 md:text-4xl">What we make and supply</h2>
      <div class="space-y-5 leading-relaxed text-ink-soft md:col-span-7 md:col-start-6 md:text-lg">
        <p class="first-letter:float-left first-letter:mr-3 first-letter:font-serif first-letter:text-7xl first-letter:leading-[0.8] first-letter:text-clay">Since 1991 we have been a leading manufacturer and trader of domestic and industrial building materials, domestic plasticware, automotive spare parts and transport services in Uganda.</p>
        <p>Our building range runs from plastic pipes to concrete products, indoor and outdoor plumbing, rainwater gutters, Light Gauge Steel Frame roof trusses, kitchen and bathroom solutions and roofing solutions.</p>
        <p>Our plasticware range includes jerry cans, basins, buckets, cups, mugs, plates, wrapped drinking straws, tiffin boxes and trays, all made from food-grade raw materials.</p>
      </div>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="wrap py-14 md:py-20">
      <h2 class="text-3xl md:text-4xl">Milestones</h2>
      <ol class="mt-8">
        {timeline.map((t) => (
          <li class="index-row grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
            <span class="numeral text-5xl md:text-6xl">{t.year}</span>
            <span class="max-w-2xl self-center text-lg text-ink-soft">{t.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="on-ink bg-ink text-paper">
    <div class="wrap grid gap-12 py-14 md:grid-cols-2 md:py-20">
      <article><p class="eyebrow">Vision</p><p class="mt-4 font-serif text-3xl leading-tight">{vision}</p></article>
      <article><p class="eyebrow">Mission</p><p class="mt-4 text-paper/80 md:text-lg">{mission}</p></article>
    </div>
  </section>

  <section class="border-b border-rule">
    <div class="wrap grid gap-8 py-14 md:grid-cols-12 md:py-20">
      <div class="md:col-span-4">
        <p class="eyebrow">Quality policy</p>
        <h2 class="mt-3 text-3xl md:text-4xl">ISO 9001:2015 certified</h2>
        <Image src={iso} alt="ISO 9001:2015 certification badge" width={150} class="mt-6 h-auto w-32" />
      </div>
      <p class="leading-relaxed text-ink-soft md:col-span-7 md:col-start-6 md:text-lg">We manufacture and supply quality UPVC, HDPE and PP-R pipes in all sizes, drinking straws, domestic plastics, quality irrigation systems and building materials as a single stop for building and construction. Through a Quality Management System in accordance with ISO 9001:2015 we aim to be the market leader in Uganda and the East African Community. Our products are certified by the Uganda National Bureau of Standards (UNBS).</p>
    </div>
  </section>

  <section class="wrap py-14 md:py-20">
    <p class="text-sm text-ink-soft">Also: Certificates, CSR Activities and Achievements pages to follow (TODO).</p>
    <a href="/contact" class="btn btn-clay mt-6">Contact us</a>
  </section>
</Layout>
