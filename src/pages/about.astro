---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Strata from '../components/Strata.astro';
import CoreSample from '../components/CoreSample.astro';
import ContactColophon from '../components/ContactColophon.astro';
import { MISSION, VISION } from '../config';
import { breadcrumbLd } from '../lib/seo';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const timeline = [
  {
    year: '1991',
    title: 'Manufacturing & trading begins',
    body: 'Domestic and industrial building materials, domestic plasticware and plastic pipes, from our base in Kampala.',
  },
  {
    year: '2013',
    title: 'The automotive division',
    body: 'Fras-le brake lining and pads, Hanksugi truck tyres, and Hengst fuel and air filters.',
  },
  {
    year: '2019',
    title: 'Inland Freight Services',
    body: 'Transport and logistics services across the East African region.',
  },
  {
    year: 'Today',
    title: 'Certified quality',
    body: 'ISO 9001:2015 certified, with products certified by the Uganda National Bureau of Standards (UNBS).',
  },
];
---

<Layout
  title="About us"
  description="Since 1991, Multiple Industries has led the manufacturing and trading of building materials, plasticware, automotive spare parts and transport services in Uganda. ISO 9001:2015 certified."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <section class="wrap head">
    <Breadcrumbs items={crumbs} />
    <div class="head-grid">
      <div>
        <p class="kicker">About us · Since 1991</p>
        <h1 class="display-xl">A one stop source, <em class="wonk">built in layers.</em></h1>
      </div>
      <CoreSample />
    </div>
  </section>

  <Strata from="var(--color-parchment)" to="var(--color-paper)" variant={2} />

  <section class="paper" aria-labelledby="story">
    <div class="wrap story">
      <h2 id="story" class="display-md">Our story</h2>
      <div class="prose-ed">
        <p class="dropcap">
          Since 1991, Multiple Industries has been leading the manufacturing and trading of domestic and industrial
          building materials, domestic plasticware, automotive spare parts and transport services in Uganda.
        </p>
        <p>
          Our range runs from plastic pipes to concrete products: indoor and outdoor plumbing, rainwater gutters, Light
          Gauge Steel Frame roof trusses, kitchen and bathroom solutions and roofing solutions.
        </p>
        <p>
          Our plasticware (jerry cans, basins, buckets, cups, mugs, plates, wrapped drinking straws, tiffin boxes and
          trays) is made from food-grade raw materials.
        </p>
        <p>
          In 2013 we launched our automotive division, and in 2019 Inland Freight Services began offering transport and
          logistics across East Africa.
        </p>
      </div>
    </div>
  </section>

  <section class="paper" aria-labelledby="tl-title">
    <div class="wrap tl-wrap">
      <p class="kicker">Timeline</p>
      <h2 id="tl-title" class="display-md">The chapters so far</h2>
      <ol class="timeline">
        {
          timeline.map((t) => (
            <li>
              <span class="tl-year">{t.year}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Strata from="var(--color-paper)" to="var(--color-clay)" variant={3} bands={['var(--color-sand)', 'var(--color-papyrus)']} />

  <section class="clay" aria-labelledby="mv-title">
    <div class="wrap mv">
      <h2 id="mv-title" class="sr-only">Mission, vision and quality policy</h2>
      <div>
        <p class="kicker k-deep">Vision</p>
        <p class="pull">&ldquo;{VISION}&rdquo;</p>
      </div>
      <div class="mv-cols">
        <div>
          <h3 class="kicker k-deep">Mission</h3>
          <p>{MISSION}</p>
        </div>
        <div>
          <h3 class="kicker k-deep">Quality policy</h3>
          <p>
            To manufacture and supply quality UPVC, HDPE and PP-R pipes in all sizes, drinking straws, domestic plastics
            and quality irrigation systems and building materials as a single stop for building and construction, and to
            position ourselves as market leader in Uganda and the East African Community through a Quality Management
            System in accordance with ISO 9001:2015.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Strata from="var(--color-clay)" to="var(--color-parchment)" variant={1} bands={['var(--color-murram-bright)', 'var(--color-sand)']} />

  <section aria-labelledby="cert-title">
    <div class="wrap certs">
      <div>
        <p class="kicker">Certificates</p>
        <h2 id="cert-title" class="display-md">ISO 9001:2015 &amp; UNBS</h2>
        <p class="lede">
          Our Quality Management System is certified to ISO 9001:2015, and our products are certified by the Uganda
          National Bureau of Standards.
        </p>
        <!-- TODO: add CSR Activities and Achievements pages from the old site. -->
      </div>
      <img
        src="/unbs-iso-marks.webp"
        width="400"
        height="218"
        loading="lazy"
        decoding="async"
        alt="Uganda National Bureau of Standards Q-mark and ISO 9001:2015 certified company seal"
      />
    </div>
  </section>

  <ContactColophon />
</Layout>

<style>
  .head {
    padding-top: 0.75rem;
    padding-bottom: 2rem;
  }
  .head-grid {
    display: grid;
    gap: 2rem;
    margin-top: 0.5rem;
  }
  .head h1 {
    margin-top: 0.75rem;
    max-width: 13ch;
  }
  .paper {
    background: var(--color-paper);
  }
  .story,
  .tl-wrap {
    display: grid;
    gap: 1.25rem;
    padding-block: 2.5rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 78%);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .timeline li {
    scroll-snap-align: start;
    border-top: 4px solid var(--color-murram);
    background: var(--color-parchment);
    padding: 1.25rem;
  }
  .tl-year {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-murram);
  }
  .timeline h3 {
    font-size: 1.3rem;
    margin-top: 0.75rem;
  }
  .timeline p {
    color: var(--color-muted);
    margin-top: 0.4rem;
    font-size: 0.98rem;
  }
  .clay {
    background: var(--color-clay);
  }
  .k-deep {
    color: var(--color-murram-deep);
  }
  .mv {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
  }
  .pull {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: clamp(1.6rem, 5.5vw, 3rem);
    line-height: 1.15;
    max-width: 26ch;
  }
  .mv-cols {
    display: grid;
    gap: 1.75rem;
  }
  .mv-cols > div {
    border-top: 2px solid var(--color-ink);
    padding-top: 1rem;
  }
  .mv-cols p {
    margin-top: 0.5rem;
  }
  .certs {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
    align-items: center;
  }
  .certs h2 {
    margin: 0.5rem 0 1rem;
  }
  .certs img {
    width: 14rem;
    height: auto;
    mix-blend-mode: multiply;
  }
  @media (min-width: 48rem) {
    .timeline {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
    }
    .mv-cols {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .certs {
      grid-template-columns: 1.4fr 1fr;
    }
    .story {
      grid-template-columns: 1fr 1.6fr;
      gap: 3rem;
      padding-block: 4rem 2rem;
    }
  }
  @media (min-width: 64rem) {
    .head-grid {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
