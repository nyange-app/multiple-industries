---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import certs from '../assets/certs.png';
import { INTRO, LEGAL_NAME, MISSION, QUALITY_POLICY, VISION } from '../config';
import { categories } from '../data/categories';

const crumbs = [{ name: 'About us', href: '/about/' }];
const milestones = [
  {
    y: '1991',
    t: 'Founded in Kampala',
    d: 'Manufacturing and trading of domestic and industrial building materials and domestic plasticware begins.',
  },
  {
    y: '2013',
    t: 'Automotive division',
    d: 'Selected spare parts: Fras-le brake lining & pads, Hanksugi truck tyres and Hengst fuel and air filters.',
  },
  {
    y: '2019',
    t: 'Inland Freight Services',
    d: 'Transport and logistics services across the East African region.',
  },
];
---

<Layout
  title="About Us — Since 1991 in Kampala"
  description={`About ${LEGAL_NAME}: manufacturing and trading building materials, plastic pipes, plasticware, automotive spare parts and transport in Uganda since 1991. ISO 9001:2015 and UNBS certified.`}
  breadcrumbs={crumbs}
>
  <PageHero crumbs={crumbs} eyebrow="Company profile · Est. 1991" title="About Multiple Industries" lead={INTRO} />

  <section class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-24" aria-labelledby="story-title">
    <div class="lg:col-span-7">
      <SectionHead no="01" label="Profile" title="Manufacturer, trader, transporter" id="story-title" />
      <div class="mt-8 space-y-5 text-lg leading-relaxed">
        <p>
          Since 1991, {LEGAL_NAME} has been a leader in manufacturing and trading of domestic and industrial building
          materials, domestic plasticware, automotive spare parts and transport services in Uganda.
        </p>
        <p>
          Our building range runs from plastic pipes to concrete products: indoor and outdoor plumbing, rainwater
          gutters, Light Gauge Steel Frame roof trusses, kitchen and bathroom solutions and roofing solutions.
        </p>
        <p>
          In plasticware we make jerry cans, basins, buckets, cups, mugs, plates, wrapped drinking straws, tiffin boxes
          and trays — all from food-grade raw materials.
        </p>
        <p>
          In 2013 we added an automotive division, and in 2019 Inland Freight Services for transport and logistics in
          East Africa.
        </p>
      </div>
    </div>
    <ol class="lg:col-span-4 lg:col-start-9" aria-label="Milestones">
      {
        milestones.map((m) => (
          <li class="border-t-2 border-ink py-6">
            <p class="display text-6xl">{m.y}</p>
            <p class="mt-2 text-lg font-bold">{m.t}</p>
            <p class="mt-1 text-steel">{m.d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-ink bg-ink" aria-labelledby="mv-title">
    <h2 id="mv-title" class="sr-only">Mission, vision and quality policy</h2>
    <div class="grid gap-px lg:grid-cols-3">
      <article class="bg-paper p-6 sm:p-10">
        <h3 class="label text-plum">Mission</h3>
        <p class="mt-4 leading-relaxed">{MISSION}</p>
      </article>
      <article class="bg-signal p-6 sm:p-10">
        <h3 class="label">Vision</h3>
        <p class="display-md mt-4 text-3xl">{VISION}</p>
      </article>
      <article class="on-dark bg-ink p-6 text-paper sm:p-10">
        <h3 class="label text-signal">Quality policy</h3>
        <p class="mt-4 leading-relaxed text-fog">{QUALITY_POLICY}</p>
      </article>
    </div>
  </section>

  <section class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:items-center lg:py-24" aria-labelledby="cert-title">
    <div class="lg:col-span-6">
      <SectionHead no="02" label="Certificates" title="ISO 9001:2015 &amp; UNBS" id="cert-title" />
      <p class="mt-6 text-lg leading-relaxed">
        {LEGAL_NAME} is ISO 9001:2015 certified, and our products are certified by the Uganda National Bureau of
        Standards (UNBS).
      </p>
      <!-- TODO: add certificate scans + Certificates, CSR Activities and Achievements pages -->
    </div>
    <figure class="ticks border border-line bg-white p-6 lg:col-span-5 lg:col-start-8">
      <Image src={certs} alt="UNBS Q-mark and ISO 9001:2015 Certified Company badges" width={560} densities={[1, 2]} class="h-auto w-full" />
    </figure>
  </section>

  <section class="border-t border-line bg-paper-2" aria-labelledby="div-title">
    <div class="wrap py-16 lg:py-20">
      <SectionHead no="03" label="Divisions" title="What we supply" id="div-title" />
      <ul class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((c) => (
            <li class="bg-paper">
              <a href={`/products/${c.slug}/`} class="flex min-h-20 items-center gap-4 p-5 hover:bg-signal">
                <Icon name={c.icon} class="size-7 shrink-0" />
                <span class="display-md flex-1 text-xl">{c.name}</span>
                <Icon name="arrow" class="size-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCTA />
</Layout>
