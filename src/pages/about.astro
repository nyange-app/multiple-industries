---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Stage from '../components/Stage.astro';
import certs from '../assets/certs.webp';
import { categories } from '../data/categories';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
];
const chapters = [
  {
    year: '1991',
    title: 'Manufacturing and trading begins',
    text: 'Multiple Industries starts manufacturing and trading domestic and industrial building materials and domestic plasticware in Uganda, from plastic pipes to concrete products.',
  },
  {
    year: '2013',
    title: 'The automotive division',
    text: 'We begin supplying selected automotive spare parts: Fras-le brake linings and pads, Hanksugi truck tyres and Hengst fuel and air filters.',
  },
  {
    year: '2019',
    title: 'Inland Freight Services',
    text: 'Transport and logistics services across the East African region.',
  },
];
const range = [
  'Plastic pipes: UPVC, HDPE and PP-R',
  'Indoor and outdoor plumbing',
  'Rainwater gutters',
  'Light Gauge Steel Frame roof trusses',
  'Kitchen and bathroom solutions',
  'Roofing solutions',
  'Concrete products',
  'Food-grade domestic plasticware',
  'Wrapped drinking straws',
  'Irrigation systems',
  'Automotive spare parts',
  'Transport and logistics',
];
---

<Layout
  title="About Us | Multiple Industries, Kampala since 1991"
  description="Since 1991 Multiple Industries has manufactured and traded building materials, plastic pipes, domestic plasticware and automotive spare parts in Uganda. ISO 9001:2015 certified."
  breadcrumbs={crumbs}
>
  <section class="border-b border-graphite-2" aria-labelledby="about-h1">
    <div class="wrap pt-4 md:pt-6"><Breadcrumbs items={crumbs} /></div>
    <div class="wrap grid items-end gap-10 pt-6 pb-0 md:grid-cols-12 md:pt-10">
      <div class="md:col-span-7 md:pb-16">
        <p class="eyebrow">About Multiple Industries</p>
        <h1 id="about-h1" class="mt-4 text-[3.2rem] leading-[0.98] sm:text-7xl lg:text-8xl">
          A Kampala house of <em class="text-brass">materials</em>, since 1991.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-porcelain-dim">
          Since 1991 we have been a leading manufacturer and trader of domestic and industrial building materials,
          domestic plasticware, automotive spare parts and transport services in Uganda.
        </p>
      </div>
      <div class="md:col-span-5">
        <Stage kind="truss" on class="aspect-[4/3] md:aspect-[4/4.4]" />
      </div>
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="story-title">
    <SectionHead eyebrow="Our story" title="Three chapters." id="story-title" />
    <ol class="mt-12 grid gap-px border border-graphite-2 bg-graphite-2 md:grid-cols-3">
      {
        chapters.map((c) => (
          <li class="bg-charcoal p-6 md:p-8">
            <p class="font-serif text-6xl text-brass">{c.year}</p>
            <h3 class="mt-4 font-sans text-lg font-semibold tracking-normal">{c.title}</h3>
            <p class="mt-2 leading-relaxed text-steel">{c.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-graphite-2 bg-night py-20 md:py-28" aria-labelledby="range-title">
    <div class="wrap grid gap-12 md:grid-cols-12">
      <SectionHead eyebrow="The range" title="From the pipe to the plate." id="range-title" class="md:col-span-5" />
      <div class="md:col-span-7">
        <ul class="grid gap-x-8 sm:grid-cols-2">
          {range.map((r) => <li class="flex items-center gap-3 border-b border-graphite-2 py-3.5 text-porcelain-dim"><span class="size-1.5 shrink-0 bg-brass" aria-hidden="true" />{r}</li>)}
        </ul>
        <p class="mt-8 text-steel">
          Browse the collection:
          {categories.map((c, i) => (<>{i > 0 && ', '}<a href={`/products/${c.slug}/`} class="link-brass">{c.name}</a></>))}.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap grid gap-12 py-20 md:grid-cols-2 md:py-28" aria-labelledby="mv-title">
    <h2 id="mv-title" class="sr-only">Vision, mission and quality policy</h2>
    <div>
      <p class="eyebrow">Our vision</p>
      <p class="mt-4 font-serif text-3xl leading-tight md:text-4xl">
        To be the most preferred one stop source for quality building materials, general household items, selected
        automotive, irrigation and water management systems.
      </p>
    </div>
    <div>
      <p class="eyebrow">Our mission</p>
      <p class="mt-4 text-lg leading-relaxed text-porcelain-dim">
        Having a competent, experienced and motivated team, and continual interactions with our customers and other
        interested parties, we will manufacture and sell top quality plastic products, and supply reliable building
        materials, selected automotive products, irrigation systems to satisfy and exceed customer requirements and
        increase shareholder value while maintaining a sustainable environment.
      </p>
    </div>
  </section>

  <section id="certificates" class="wrap" aria-labelledby="quality-title">
    <div class="grid items-center gap-10 border border-graphite-2 bg-graphite p-6 md:grid-cols-12 md:p-12">
      <div class="md:col-span-7">
        <p class="eyebrow">Quality policy & certificates</p>
        <h2 id="quality-title" class="mt-3 text-4xl md:text-5xl">ISO 9001:2015 and UNBS.</h2>
        <p class="mt-5 leading-relaxed text-porcelain-dim">
          We manufacture and supply quality UPVC, HDPE and PP-R pipes in all sizes, drinking straws, domestic plastics
          and quality irrigation systems and building materials as a single stop for building and construction. We aim
          to be the market leader in Uganda and the East African Community through a Quality Management System in
          accordance with ISO 9001:2015. Our products are certified by the Uganda National Bureau of Standards (UNBS).
        </p>
        <!-- TODO: add certificate scans, CSR Activities and Achievements pages. -->
      </div>
      <div class="md:col-span-5">
        <div class="bg-porcelain p-5">
          <Image src={certs} alt="UNBS certification mark and ISO 9001:2015 Certified Company badge" width={560} class="h-auto w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>
